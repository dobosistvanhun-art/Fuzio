#!/bin/sh
# =============================================================================
#  Fusion Windows Runtime — fwr   (M4 proof-of-concept)
#
#  Az M4 követelménye: a Windows-os LightBurn x64 fusson a FusionOS alatt, és a valódi
#  GRBL lézervezérlőt USB-n, COM3-ként érje el.
#
#  KÍSÉRLETI MEGVALÓSÍTÁS: a jelenlegi motor a rendszerképben lévő, rögzített verziójú
#  Wine (új WoW64 mód). Ez az M4 proof-of-concept futtatója, nem a FusionOS végleges
#  architektúrája. A felhasználó nem Wine-t lát, hanem programonkénti
#  futtatókörnyezetet, amelyet egy profil ír le:
#
#    /data/programs/<id>/program.fusion      a Fusion Programkezelő leírása (type = win64) — ha van,
#                                             ez az irányadó (ugyanazok a kulcsok + prefix)
#    /usr/lib/fusion/fwr/profiles/<id>.fwr   recept: ismert program alapbeállításai (id, name, exe,
#                                             windows, port.COMn, drive.X, dlloverrides, match)
#    a környezet (Wine prefix): a leírás "prefix" kulcsa, különben /data/fwr/<id>/
#
#  A beállításokat (COM-portok, meghajtók, Windows-verzió) mindig a profil
#  alapján az fwr írja — nem kézi winecfg. A COM-port a Fusion eszközréteg
#  szerepére mutat (pl. COM3 -> /dev/fusion/laser); a Wine automatikus
#  portkeresése ki van kapcsolva, így a program csak a profil portjait látja
#  (HKLM\HARDWARE\DEVICEMAP\SERIALCOMM is ezekből töltődik ki).
#
#  Parancsok:
#    fwr list                          profilok és állapotuk
#    fwr install <id> <telepítő.exe>   a Windows-telepítő futtatása a környezetben
#    fwr launch <id> [argumentumok]    a program indítása
#    fwr run <id> <program.exe> [arg]  tetszőleges program a környezetben (hibakeresés)
#    fwr check                         a runtime ellenőrzése: COM3 és OpenGL
#    fwr prepare <id>                  a környezet létrehozása / frissítése
#    fwr places <id>                   a Fusion helyei a fájlválasztóban (D: Adatok, E: pendrive, Asztal)
#
#  Környezeti változók (teszteléshez): FWR_WINE, FWR_DATA, FWR_PROFILES, FWR_TOOLS
# =============================================================================
set -u

FWR_WINE="${FWR_WINE:-/usr/lib/fusion/wine}"
FWR_DATA="${FWR_DATA:-/data/fwr}"
FWR_PROGRAMS="${FWR_PROGRAMS:-/data/programs}"
FWR_PROFILES="${FWR_PROFILES:-/usr/lib/fusion/fwr/profiles}"
FWR_TOOLS="${FWR_TOOLS:-/usr/lib/fusion/fwr/tools}"
FWR_DLLS="${FWR_DLLS:-/usr/lib/fusion/fwr/dlls}"
FWR_LOGS="${HOME:-/tmp}/.local/share/fusion/fwr"
WINE="$FWR_WINE/bin/wine"
WINESERVER="$FWR_WINE/bin/wineserver"

say()  { printf '%s\n' "$*"; }
fail() { printf 'fwr: %s\n' "$*" >&2; exit 1; }

prof_get() {  # prof_get <fájl> <kulcs>
    sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | head -n 1 | sed 's/[[:space:]]*$//'
}
prof_keys() {  # prof_keys <fájl> <előtag> -> "kulcs|érték" sorok
    sed -n "s/^[[:space:]]*$2\.\([A-Za-z0-9_]*\)[[:space:]]*=[[:space:]]*\(.*\)$/\1|\2/p" "$1" | sed 's/[[:space:]]*$//'
}
profile() {  # profile <id> -> a profilfájl (a Programkezelő leírása, különben a recept)
    case "$1" in *[!a-zA-Z0-9_.-]*|"") fail "érvénytelen program-azonosító: $1" ;; esac
    _pf="$FWR_PROGRAMS/$1/program.fusion"
    if [ -r "$_pf" ] && [ "$(prof_get "$_pf" type)" = win64 ]; then printf '%s' "$_pf"; return; fi
    _pf="$FWR_PROFILES/$1.fwr"
    [ -r "$_pf" ] || fail "ismeretlen program: $1 (lásd: fwr list)"
    printf '%s' "$_pf"
}
prefix_of() {  # prefix_of <id> <profil> -> a Wine-környezet könyvtára
    _px=$(prof_get "$2" prefix)
    printf '%s' "${_px:-$FWR_DATA/$1}"
}

# C:\Program Files\X\Y.exe -> <prefix>/drive_c/Program Files/X/Y.exe
win_to_unix() {
    _p=$(printf '%s' "$2" | sed 's|\\|/|g')
    case "$_p" in
        [Cc]:/*) printf '%s/drive_c/%s' "$1" "${_p#??/}" ;;
        *)       printf '%s' "$_p" ;;
    esac
}

wine_env() {  # wine_env <id> <profil>
    WINEPREFIX=$(prefix_of "$1" "$2")
    WINEDEBUG="${FWR_DEBUG:-err+all,fixme-all}"
    # mono/gecko nélkül (a célprogramoknak nem kell), menüelemek nélkül
    WINEDLLOVERRIDES="mscoree,mshtml=;winemenubuilder.exe=d;$(prof_get "$2" dlloverrides)"
    export WINEPREFIX WINEDEBUG WINEDLLOVERRIDES
    mkdir -p "$FWR_LOGS"
    LOG="$FWR_LOGS/$1.log"
}

wine_build_id() { cat "$FWR_WINE/.fusion-build-id" 2>/dev/null || "$WINE" --version 2>/dev/null; }

# ---------------------------------------------------------------------------
# a Fusion helyei a Windows-program fájlválasztójában (0.0.36)
#
#   places = standard (alapértelmezés) | none     — a profil / leírás kulcsa
#
#   standard:
#     D:  „Adatok”  — a DATA meghajtó felhasználói mappái (a rendszer mappái nélkül: overlay, fwr,
#                      programs, dev, lost+found); a nézet csak olvasható, a mappák írhatók
#     E:  a pendrive-ok (/run/media/fusion)
#     Asztal: Projektek, Letöltések, Saját mappa, Adatok, Pendrive — a fájlválasztó fájának tetején
#     Dokumentumok → ~/Projektek (a programok alapértelmezett mentési helye látható helyre kerül),
#     Letöltések   → a valódi Letöltések mappa (XDG)
#   A profil saját drive.X betűje elsőbbséget kap. A Linux-fájlrendszer („/”), a Lomtár és a Vezérlőpult
#   nem látszik (registry, a prepare-ben).  A Google Drive nem része a szabványos helyeknek.
#   Minden indításkor frissül (olcsó: csak hivatkozások) — az új DATA-mappák a következő indításkor látszanak.
# ---------------------------------------------------------------------------
FWR_DATAROOT="${FWR_DATAROOT:-/data}"
FWR_MEDIA="${FWR_MEDIA:-/run/media/fusion}"
DATA_HIDDEN=" overlay fwr programs dev lost+found "

xdg_dir() {  # xdg_dir <XDG_KULCS> <alapértelmezés>
    _d=$(sed -n "s/^$1=\"\(.*\)\"\$/\1/p" "${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs" 2>/dev/null | head -n 1)
    case "$_d" in '$HOME'*) _d="$HOME${_d#\$HOME}" ;; esac
    case "$_d" in /*) printf '%s' "$_d" ;; *) printf '%s' "$2" ;; esac
}

# place_link <hivatkozás> <cél>: a Wine saját (üres) mappája helyett hivatkozás; ha a mappában fájlok
# vannak, azok a célba költöznek (ütközés esetén a mappa marad, és a napló jelzi)
place_link() {
    if [ -L "$1" ]; then
        [ "$(readlink "$1")" = "$2" ] && return 0
        rm -f "$1"
    elif [ -d "$1" ]; then
        for _e in "$1"/* "$1"/.[!.]*; do
            [ -e "$_e" ] || [ -L "$_e" ] || continue
            if [ -e "$2/${_e##*/}" ]; then
                printf 'fwr: %s marad (ütközik: %s)\n' "$1" "${_e##*/}" >> "$LOG"; return 1
            fi
        done
        for _e in "$1"/* "$1"/.[!.]*; do
            [ -e "$_e" ] || [ -L "$_e" ] || continue
            mv "$_e" "$2/" && printf 'fwr: átköltöztetve: %s -> %s\n' "$_e" "$2" >> "$LOG"
        done
        rmdir "$1" 2>/dev/null || return 1
    elif [ -e "$1" ]; then
        return 1
    fi
    ln -s "$2" "$1"
}

places_apply() {  # places_apply <profil>  (WINEPREFIX, LOG beállítva)
    _pf=$1
    [ -d "$WINEPREFIX/dosdevices" ] || return 0
    _mf="$WINEPREFIX/.fwr-places"
    _views="$WINEPREFIX/fusion-places"
    _user=${USER:-$(id -un)}
    _desk="$WINEPREFIX/drive_c/users/$_user/Desktop"
    # a korábban létrehozott (kezelt) hivatkozások eltávolítása — újraépül
    if [ -r "$_mf" ]; then
        while IFS= read -r _l; do [ -L "$_l" ] && rm -f "$_l"; done < "$_mf"
    fi
    : > "$_mf"
    [ "$(prof_get "$_pf" places)" = none ] && return 0

    # D: Adatok — a DATA felhasználói mappái (hivatkozások egy csak olvasható nézetben)
    _dv="$_views/Adatok"
    mkdir -p "$_dv" && chmod u+w "$_dv"
    find "$_dv" -mindepth 1 -maxdepth 1 -type l -exec rm -f {} + 2>/dev/null
    for _e in "$FWR_DATAROOT"/*; do
        [ -e "$_e" ] || continue
        _n=${_e##*/}
        case "$DATA_HIDDEN" in *" $_n "*) continue ;; esac
        [ -r "$_e" ] || continue
        [ -d "$_e" ] && [ ! -x "$_e" ] && continue
        ln -s "$_e" "$_dv/$_n"
    done
    printf 'Adatok\n' > "$_dv/.windows-label"
    chmod 0555 "$_dv"
    # C: a program saját környezete — névvel, hogy a Sajátgépben érthető legyen
    [ -e "$WINEPREFIX/drive_c/.windows-label" ] || printf 'Program\n' > "$WINEPREFIX/drive_c/.windows-label"

    _letters=" $(prof_keys "$_pf" drive | cut -d'|' -f1 | tr '[:upper:]' '[:lower:]' | tr '\n' ' ') "
    for _d in "d|$_dv" "e|$FWR_MEDIA"; do
        _l=${_d%%|*}; _t=${_d#*|}
        case "$_letters" in *" $_l "*) continue ;; esac
        rm -f "$WINEPREFIX/dosdevices/$_l:"
        ln -s "$_t" "$WINEPREFIX/dosdevices/$_l:" && printf '%s\n' "$WINEPREFIX/dosdevices/$_l:" >> "$_mf"
    done

    _proj="$HOME/Projektek"; mkdir -p "$_proj"
    _dl=$(xdg_dir XDG_DOWNLOAD_DIR "$HOME/Letöltések"); mkdir -p "$_dl"
    if [ -d "$WINEPREFIX/drive_c/users/$_user" ]; then
        # a Windows-mappák a valódi mappákra mutatnak
        place_link "$WINEPREFIX/drive_c/users/$_user/Documents" "$_proj"
        place_link "$WINEPREFIX/drive_c/users/$_user/Downloads" "$_dl"
        # az Asztalon: a fájlválasztó fájának tetején, névvel
        mkdir -p "$_desk"
        for _d in "Projektek|$_proj" "Letöltések|$_dl" "Saját mappa|$HOME" "Adatok|$_dv" "Pendrive|$FWR_MEDIA"; do
            _n=${_d%%|*}; _t=${_d#*|}
            [ -e "$_desk/$_n" ] && [ ! -L "$_desk/$_n" ] && continue   # a felhasználó saját fájlja: marad
            rm -f "$_desk/$_n"
            ln -s "$_t" "$_desk/$_n" && printf '%s\n' "$_desk/$_n" >> "$_mf"
        done
    fi
    return 0
}

# ---------------------------------------------------------------------------
# prepare: a környezet létrehozása / frissítése a profil alapján
# ---------------------------------------------------------------------------
cmd_prepare() {
    [ $# -ge 1 ] || fail "használat: fwr prepare <id>"
    id=$1; pf=$(profile "$id")
    [ -x "$WINE" ] || fail "a Windows runtime nincs telepítve ($WINE)"
    wine_env "$id" "$pf"
    mkdir -p "$(dirname "$WINEPREFIX")" 2>/dev/null
    [ -w "$(dirname "$WINEPREFIX")" ] || fail "a $(dirname "$WINEPREFIX") nem írható"
    stamp="$WINEPREFIX/.fwr-stamp"
    # csak a környezetet érintő kulcsok számítanak (a leírás egyéb mezői — név, ikon — nem)
    want="$(wine_build_id) $(grep -E '^[[:space:]]*(windows|port\.|drive\.|dlloverrides|places)' "$pf" | sha256sum | cut -c1-16) $(sha256sum "$0" | cut -c1-16) $(sysdlls_id)"
    if [ -r "$stamp" ] && [ "$(cat "$stamp")" = "$want" ]; then places_apply "$pf"; fonts_apply; return 0; fi

    say "fwr: $(prof_get "$pf" name) futtatókörnyezetének előkészítése ($WINEPREFIX)…"
    # grafikus munkamenetben értesítés (az előkészítés néhány másodperc — ne tűnjön lefagyásnak)
    [ -n "${DISPLAY:-}" ] && command -v fusion-notify >/dev/null && \
        fusion-notify -i laser "$(prof_get "$pf" name): előkészítés…" "a futtatókörnyezet frissül, a program utána indul" 2>/dev/null
    # félbemaradt környezet (pl. megszakadt első létrehozás): nincs .fwr-stamp, és a program sincs
    # benne — a sérült állapot frissítése nem segít (pl. csonka DLL-ek), ezért tisztán újra létrejön
    if [ -d "$WINEPREFIX" ] && [ ! -e "$stamp" ]; then
        exe_chk=$(win_to_unix "$WINEPREFIX" "$(prof_get "$pf" exe)")
        if [ -z "$(prof_get "$pf" exe)" ] || [ ! -f "$exe_chk" ]; then
            say "fwr: a korábbi, félbemaradt környezet törölve — új jön létre"
            "$WINESERVER" -k 2>/dev/null
            rm -rf "$WINEPREFIX"
        fi
    fi
    # a wineboot kijelző nélkül fut: grafikus munkamenetben különben a Wine saját „Wine” felugró ablaka jelenik
    # meg a környezet létrehozásakor / frissítésekor (0.0.54 — mérve: DISPLAY-jal ablak, nélküle nincs, a környezet ugyanaz)
    if [ ! -r "$WINEPREFIX/system.reg" ]; then
        env -u DISPLAY -u WAYLAND_DISPLAY "$WINE" wineboot -i >> "$LOG" 2>&1 || fail "a környezet létrehozása nem sikerült (napló: $LOG)"
    else
        env -u DISPLAY -u WAYLAND_DISPLAY "$WINE" wineboot -u >> "$LOG" 2>&1 || true
    fi
    "$WINESERVER" -w

    # registry: portok (csak a profil portjai), Windows-verzió
    # a .reg fájl a környezeten belül (C:), mert a Linux-fájlrendszer (Z:) nem látszik
    reg="$WINEPREFIX/drive_c/fusion-settings.reg"
    {
        echo "REGEDIT4"
        echo
        echo "[-HKEY_LOCAL_MACHINE\\Software\\Wine\\Ports]"
        echo "[HKEY_LOCAL_MACHINE\\Software\\Wine\\Ports]"
        echo "\"AutoDetect\"=\"N\""
        prof_keys "$pf" port | while IFS='|' read -r com role; do
            echo "\"$com\"=\"/dev/fusion/$role\""
        done
        echo
        echo "[HKEY_CURRENT_USER\\Software\\Wine]"
        echo "\"Version\"=\"$(prof_get "$pf" windows)\""
        # a Wine saját tálcaikon-ablaka (a Fusion Desktopban nincs rendszertálca, ezért a Wine
        # egy külön felugró ablakba tenné a program tálcaikonjait) — kikapcsolva
        echo
        echo "[HKEY_CURRENT_USER\\Software\\Wine\\Explorer]"
        echo "\"ShowSystray\"=dword:00000000"
        echo
        echo "[HKEY_CURRENT_USER\\Software\\Microsoft\\Windows\\CurrentVersion\\Policies\\Explorer]"
        echo "\"NoTrayItemsDisplay\"=dword:00000001"
        # a fájlválasztó fája: a Linux-fájlrendszer („/”), a Lomtár, a Vezérlőpult és a Wine saját
        # Dokumentumok-eleme nem látszik (a Dokumentumok a Projektekre mutat, az Asztalon „Projektek” néven)
        # — printf: a dash echo-ja a visszaperjeleket értelmezné
        for ns in 'HKEY_LOCAL_MACHINE\Software\Microsoft\Windows\CurrentVersion\Explorer' \
                  'HKEY_LOCAL_MACHINE\Software\Wow6432Node\Microsoft\Windows\CurrentVersion\Explorer'; do
            for g in '{9D20AAE8-0625-44B0-9CA7-71889C2254D9}' '{645FF040-5081-101B-9F08-00AA002F954E}' \
                     '{450D8FBA-AD25-11D0-98A8-0800361B1103}'; do
                printf '\n[-%s\\Desktop\\Namespace\\%s]\n' "$ns" "$g"
            done
            printf '\n[-%s\\MyComputer\\Namespace\\%s]\n' "$ns" '{21EC2020-3AEA-1069-A2DD-08002B30309D}'
        done
    } > "$reg"
    env -u DISPLAY -u WAYLAND_DISPLAY "$WINE" regedit /S 'C:\fusion-settings.reg' >> "$LOG" 2>&1 \
        || fail "a beállítások írása nem sikerült (napló: $LOG)"
    rm -f "$reg"

    # meghajtók: a profil meghajtói; a teljes Linux-fájlrendszer (Z:) nem látszik
    dd="$WINEPREFIX/dosdevices"
    rm -f "$dd/z:"
    # korábbi (automatikusan létrehozott) port-hivatkozások törlése — a Wine a
    # következő indításkor csak a profil portjait hozza létre
    rm -f "$dd"/com[0-9]* "$dd"/lpt[0-9]*
    prof_keys "$pf" drive | while IFS='|' read -r letter dir; do
        l=$(printf '%s' "$letter" | tr '[:upper:]' '[:lower:]')
        case "$dir" in /*) target=$dir ;; *) target="$HOME/$dir" ;; esac
        mkdir -p "$target"
        rm -f "$dd/$l:"; ln -s "$target" "$dd/$l:"
    done
    places_apply "$pf"
    sysdlls_apply
    fonts_apply
    "$WINESERVER" -k 2>/dev/null; "$WINESERVER" -w 2>/dev/null
    echo "$want" > "$stamp"
    say "fwr: kész."
}

# a Windows rendszer-DLL-jei, amelyek a Wine-ból hiányoznak (0.0.57): a Windows 10 System32-jének
# ICU-ja (icuuc.dll, icuin.dll, icu.dll) — a Qt 6-os programok egy része importálja (LightBurn 2.2.00).
# A rendszerképből (FWR_DLLS/x86_64) a környezet System32 mappájába kerülnek, ha ott nincs ugyanaz.
sysdlls_id() { cat "$FWR_DLLS"/x86_64/*.dll 2>/dev/null | sha256sum | cut -c1-16; }
sysdlls_apply() {  # (WINEPREFIX, LOG beállítva)
    _s32="$WINEPREFIX/drive_c/windows/system32"
    [ -d "$_s32" ] || return 0
    for _d in "$FWR_DLLS"/x86_64/*.dll; do
        [ -r "$_d" ] || continue
        cmp -s "$_d" "$_s32/${_d##*/}" && continue
        cp "$_d" "$_s32/${_d##*/}.fwr-new" && mv -f "$_s32/${_d##*/}.fwr-new" "$_s32/${_d##*/}" \
            && printf 'fwr: rendszer-DLL: %s\n' "${_d##*/}" >> "$LOG"
    done
}

# a felhasználó saját betűtípusai (fusion-fonts, 0.0.57): hivatkozásként a környezet C:\Windows\Fonts
# mappájába — a Wine onnan minden fajtát betölt (a raszteres .fon/.fnt-t is). Minden indításkor
# frissül (olcsó); a már nem létező betűtípusok hivatkozása törlődik.
FWR_USER_FONTS="${FWR_USER_FONTS:-$HOME/.local/share/fonts}"
fonts_apply() {  # (WINEPREFIX, LOG beállítva)
    _fd="$WINEPREFIX/drive_c/windows/Fonts"
    [ -d "$_fd" ] || return 0
    for _l in "$_fd"/fusion-*; do
        [ -L "$_l" ] || continue
        [ -e "$_l" ] || rm -f "$_l"
    done
    [ -d "$FWR_USER_FONTS" ] || return 0
    find "$FWR_USER_FONTS" -maxdepth 3 -type f \( -iname '*.ttf' -o -iname '*.otf' -o -iname '*.ttc' -o -iname '*.fon' -o -iname '*.fnt' \) 2>/dev/null \
        | head -n 2000 | while IFS= read -r _f; do
            _n="fusion-${_f##*/}"
            [ "$(readlink "$_fd/$_n" 2>/dev/null)" = "$_f" ] && continue
            rm -f "$_fd/$_n"; ln -s "$_f" "$_fd/$_n"
        done
}

# a profil környezeti változói (env.NÉV = érték) — a Windows-program is látja őket
env_apply() {  # env_apply <id> <profil> — előbb a recept, aztán a program leírója (az felülírja)
    { [ -r "$FWR_PROFILES/$1.fwr" ] && prof_keys "$FWR_PROFILES/$1.fwr" env
      [ "$2" != "$FWR_PROFILES/$1.fwr" ] && prof_keys "$2" env; } > "${TMPDIR:-/tmp}/fwr-env.$$" 2>/dev/null
    while IFS='|' read -r _k _v; do
        case "$_k" in ""|*[!A-Za-z0-9_]*) continue ;; esac
        export "$_k=$_v"
    done < "${TMPDIR:-/tmp}/fwr-env.$$"
    rm -f "${TMPDIR:-/tmp}/fwr-env.$$"
}

# a profil portjai mögötti eszközök állapota (felhasználóbarát figyelmeztetés)
port_report() {
    prof_keys "$1" port | while IFS='|' read -r com role; do
        if [ -e "/dev/fusion/$role" ]; then
            say "  $com -> /dev/fusion/$role ($(basename "$(readlink -f "/dev/fusion/$role")"))"
        else
            say "  $com -> /dev/fusion/$role: NINCS CSATLAKOZTATVA (fusion-devices)"
        fi
    done
}

cmd_install() {
    [ $# -eq 2 ] || fail "használat: fwr install <id> <telepítő.exe>"
    id=$1; inst=$2; pf=$(profile "$id")
    [ -r "$inst" ] || fail "nem található: $inst"
    cmd_prepare "$id"
    wine_env "$id" "$pf"
    # a telepítő a környezeten belülre kerül (a Linux-fájlrendszer nem látszik)
    tmp="$WINEPREFIX/drive_c/fusion-install"
    rm -rf "$tmp"; mkdir -p "$tmp"
    cp "$inst" "$tmp/" || { rm -rf "$tmp"; fail "a telepítő nem másolható a környezetbe (elfogyott a hely?)"; }
    name=$(basename "$inst")
    say "fwr: $(prof_get "$pf" name) telepítése: $name"
    case "$name" in
        *.msi|*.MSI) (cd "$tmp" && "$WINE" msiexec /i "C:\\fusion-install\\$name" >> "$LOG" 2>&1) ;;
        *)           (cd "$tmp" && "$WINE" "C:\\fusion-install\\$name" >> "$LOG" 2>&1) ;;
    esac
    "$WINESERVER" -w
    rm -rf "$tmp"
    if [ -z "$(prof_get "$pf" exe)" ]; then
        # általános telepítés: a programot a Programkezelő ismeri fel (parancsikonok, új .exe-k)
        say "fwr: a telepítő lefutott ($WINEPREFIX)"
        return 0
    fi
    exe=$(win_to_unix "$WINEPREFIX" "$(prof_get "$pf" exe)")
    if [ -f "$exe" ]; then
        say "fwr: telepítve — indítás: fwr launch $id"
    else
        fail "a telepítés után nem található: $(prof_get "$pf" exe) (napló: $LOG)"
    fi
}

cmd_launch() {
    [ $# -ge 1 ] || fail "használat: fwr launch <id> [argumentumok]"
    id=$1; shift; pf=$(profile "$id")
    cmd_prepare "$id"
    wine_env "$id" "$pf"
    winexe=$(prof_get "$pf" exe)
    exe=$(win_to_unix "$WINEPREFIX" "$winexe")
    [ -f "$exe" ] || fail "$(prof_get "$pf" name) nincs telepítve — telepítés: fwr install $id <telepítő.exe>"
    say "fwr: $(prof_get "$pf" name) indítása"
    port_report "$pf"
    env_apply "$id" "$pf"
    printf '\n=== %s indítás: %s\n' "$(date '+%F %T')" "$winexe" >> "$LOG"
    cd "$(dirname "$exe")" || true
    "$WINE" "$winexe" "$@" >> "$LOG" 2>&1
    rc=$?
    [ $rc -eq 0 ] || say "fwr: $(prof_get "$pf" name) kilépett (kód: $rc) — napló: $LOG"
    return $rc
}

cmd_run() {
    [ $# -ge 2 ] || fail "használat: fwr run <id> <program.exe> [argumentumok]"
    id=$1; prog=$2; shift 2; pf=$(profile "$id")
    cmd_prepare "$id" >/dev/null
    wine_env "$id" "$pf"
    env_apply "$id" "$pf"
    "$WINE" "$prog" "$@" 2>> "$LOG"
}

# check: a runtime ellenőrzése a "fwr-check" profillal (COM3 -> lézer, OpenGL)
cmd_check() {
    rc=0
    say "Fusion Windows Runtime — ellenőrzés"
    say "  Wine:   $("$WINE" --version 2>/dev/null) ($(wine_build_id))"
    cmd_prepare fwr-check >/dev/null || return 1
    pf=$(profile fwr-check)
    port_report "$pf"
    # a diagnosztikai programok a környezeten belülről (C:\fusion-tools) futnak
    mkdir -p "$FWR_DATA/fwr-check/drive_c/fusion-tools"
    cp "$FWR_TOOLS"/*.exe "$FWR_DATA/fwr-check/drive_c/fusion-tools/"
    # a próbasor GRBL-megjegyzés: a vezérlő figyelmen kívül hagyja (csak "ok"), a gép nem mozdul
    out=$(cmd_run fwr-check 'C:\fusion-tools\fwr-comtest.exe' COM3 "$(printf '(FUSION-COM-OK)\r')" 2>&1); r=$?
    printf '%s\n' "$out" | tr -d '\r' | sed 's/^/  /'
    [ $r -eq 0 ] || rc=1
    # Windows kamera-felsoroló (WinRT) — a LightBurn 2.x induláskor ezt hívja
    out=$(cmd_run fwr-check 'C:\fusion-tools\fwr-camtest.exe' 2>&1); r=$?
    printf '%s\n' "$out" | tr -d '\r' | grep '^CAM' | sed 's/^/  /'
    [ $r -eq 0 ] || { say "  CAM: HIBA (kód $r)"; rc=1; }
    if [ -n "${DISPLAY:-}" ]; then
        out=$(cmd_run fwr-check 'C:\fusion-tools\fwr-gltest.exe' 2>&1); r=$?
        printf '%s\n' "$out" | tr -d '\r' | grep '^GL' | sed 's/^/  /'
        [ $r -eq 0 ] || { say "  GL: HIBA (kód $r)"; rc=1; }
    else
        say "  GL: nincs grafikus munkamenet (DISPLAY), kihagyva"
    fi
    return $rc
}

cmd_places() {  # a helyek frissítése (a Programkezelő a fájl Windows-útja előtt hívja)
    [ $# -eq 1 ] || fail "használat: fwr places <id>"
    pf=$(profile "$1"); wine_env "$1" "$pf"
    places_apply "$pf"
}

cmd_stop() {  # a program összes Windows-folyamatának leállítása (pl. eltávolítás előtt)
    [ $# -eq 1 ] || fail "használat: fwr stop <id>"
    pf=$(profile "$1"); wine_env "$1" "$pf"
    [ -d "$WINEPREFIX" ] && "$WINESERVER" -k 2>/dev/null
    return 0
}

cmd_list() {
    say "Fusion Windows Runtime — programok"
    for pf in "$FWR_PROFILES"/*.fwr; do
        [ -r "$pf" ] || continue
        id=$(prof_get "$pf" id); [ "$id" = fwr-check ] && continue
        exe=$(win_to_unix "$(prefix_of "$id" "$pf")" "$(prof_get "$pf" exe)")
        if [ -f "$exe" ]; then st="telepítve (fwr launch $id)"; else st="nincs telepítve (fwr install $id <telepítő.exe>)"; fi
        say "  $(prof_get "$pf" name) [$id]: $st"
        port_report "$pf"
    done
}

cmd=${1:-list}; [ $# -gt 0 ] && shift
case "$cmd" in
    list)    cmd_list ;;
    prepare) cmd_prepare "$@" ;;
    install) cmd_install "$@" ;;
    launch)  cmd_launch "$@" ;;
    run)     cmd_run "$@" ;;
    check)   cmd_check ;;
    stop)    cmd_stop "$@" ;;
    places)  cmd_places "$@" ;;
    *)       fail "ismeretlen parancs: $cmd (list, install, launch, run, stop, check, prepare, places)" ;;
esac
