# LightBurn (Windows x64) — a Prototype 0.1 célprogramja
# Telepítés: fwr install lightburn <LightBurn-…-x64.exe>   Indítás: fwr launch lightburn
id = lightburn
name = LightBurn
exe = C:\Program Files\LightBurn\LightBurn.exe
windows = win10
# a Programkezelő erről ismeri fel a telepítőt (fájlnév-minta) — a recept beállításai érvényesülnek
match = LightBurn*.exe
icon = laser
# Start menü: Műhely csoport (freedesktop-kategóriák)
categories = Graphics; Engineering
open = .lbrn .lbrn2
# a lézer a Fusion eszközréteg szerepe szerint (M3): COM3 -> /dev/fusion/laser
port.COM3 = laser
# P: = Projektek (a felhasználó mappája); a Linux-fájlrendszer (Z:) nem látszik
drive.P = Projektek
# a LightBurn 2.2 a Qt WebEngine-t (Chromium) is betölti: a Chromium homokozója és GPU-gyorsítása
# a Windows-futtatóban nem működik — nélkülük fut (a Fúzió saját homokozója ettől független)
env.QTWEBENGINE_DISABLE_SANDBOX = 1
env.QTWEBENGINE_CHROMIUM_FLAGS = --no-sandbox --disable-gpu
