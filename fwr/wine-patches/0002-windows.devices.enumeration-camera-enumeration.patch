+static HRESULT WINAPI frame_statics_GetDeviceSelector( IMediaFrameSourceGroupStatics *iface, HSTRING *value )
+{
+    /* KSCATEGORY_VIDEO_CAMERA eszközfelületek */
+    static const WCHAR selector[] = L"System.Devices.InterfaceClassGuid:=\"{E5323777-F976-4F5B-9B55-B94699C46E44}\""
+                                    L" AND System.Devices.InterfaceEnabled:=System.StructuredQueryType.Boolean#True";
