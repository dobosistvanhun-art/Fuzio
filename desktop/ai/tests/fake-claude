#!/usr/bin/python3
"""Próba-Claude a FusionAI öntesztjéhez — NEM a Claude Code, és nem hív semmilyen AI-t.

A Claude Code SDK-felületének (stream-json, vezérlőkérések) annyit utánoz, amennyi a FusionAI csővezetékének
(indítás, folyamatos válasz, jóváhagyás, munkamenet-folytatás, megszakítás) ellenőrzéséhez kell:
  - „javítsd”  → Edit-jóváhagyást kér a calc.py-re; ha megkapja, kijavítja (a - helyett +)
  - „hozzáír”  → Bash-sel ír a calc.py végére (a Visszavonásnak ezt is vissza kell vonnia)
  - „töröld”   → `git reset --hard`-ot kér (a FusionAI-nak magától el kell utasítania)
  - „commit”   → `git add … && git commit …`-ot kér úgy, mintha egy szabály magától engedné (a FusionAI
                 PreToolUse-horgának kell kiemelt jóváhagyásra kényszerítenie)
  - más        → felsorolja a projekt fájljait, szavanként (folyamatos válasz)
A munkamenet: ~/.cache/fake-claude/<id>.json (a --resume-hoz).
"""
import json
import os
import sys
import time
import uuid

ARGS = sys.argv[1:]
if ARGS[:1] in (["--version"], ["-v"]):
    print("2.1.311 (Claude Code)")
    sys.exit(0)
if ARGS[:2] == ["auth", "status"]:
    print(json.dumps({"loggedIn": os.environ.get("FAKE_CLAUDE_LOGGED_IN", "1") == "1", "authMethod": "claude.ai",
                      "apiProvider": "firstParty"}))
    sys.exit(0)


def arg(name):
    for i, a in enumerate(ARGS):
        if a == name and i + 1 < len(ARGS):
            return ARGS[i + 1]
        if a.startswith(name + "="):
            return a.split("=", 1)[1]
    return None


STORE = os.path.join(os.path.expanduser("~"), ".cache", "fake-claude")
os.makedirs(STORE, exist_ok=True)
SID = arg("--resume") or arg("--session-id") or str(uuid.uuid4())
HIST = os.path.join(STORE, SID + ".json")
history = json.load(open(HIST)) if os.path.exists(HIST) else []
CWD = os.getcwd()
with open(os.path.join(STORE, "last-args.json"), "w") as f:
    json.dump({"args": ARGS, "cwd": CWD}, f)


def out(d):
    sys.stdout.write(json.dumps(d) + "\n")
    sys.stdout.flush()


def read():
    ln = sys.stdin.readline()
    if not ln:
        sys.exit(0)
    return json.loads(ln)


pending = []        # a jóváhagyásra várva érkező egyéb sorok


def control(req_id, resp):
    out({"type": "control_response", "response": {"subtype": "success", "request_id": req_id, "response": resp}})


HOOKS = []          # a PreToolUse-horgok azonosítói (az initialize-ból)


def handle_control(m):
    sub = m["request"].get("subtype")
    if sub == "initialize":
        for mt in ((m["request"].get("hooks") or {}).get("PreToolUse") or []):
            HOOKS.extend(mt.get("hookCallbackIds") or [])
    control(m["request_id"], {"commands": [], "models": []} if sub == "initialize" else {})
    return sub


def request(req):
    rid = "fake-" + uuid.uuid4().hex[:8]
    out({"type": "control_request", "request_id": rid, "request": req})
    while True:
        m = read()
        if m.get("type") == "control_response" and m["response"].get("request_id") == rid:
            return m["response"].get("response", {}) if m["response"].get("subtype") == "success" else {}
        if m.get("type") == "control_request":
            handle_control(m)
            continue
        pending.append(m)


def use(tool, inp, auto=False):
    """mint a Claude Code: előbb a PreToolUse-horgok, aztán a szabályok (auto = egy szabály magától engedné),
    végül a jóváhagyás (can_use_tool)"""
    decision = ""
    for hid in HOOKS:
        r = request({"subtype": "hook_callback", "callback_id": hid, "tool_use_id": "tu-x",
                     "input": {"hook_event_name": "PreToolUse", "tool_name": tool, "tool_input": inp}})
        d = ((r or {}).get("hookSpecificOutput") or {}).get("permissionDecision", "")
        if d == "deny":
            return {"behavior": "deny", "message": ((r.get("hookSpecificOutput") or {}).get("permissionDecisionReason", ""))}
        decision = decision or d
    if decision == "allow" or (auto and decision != "ask"):
        return {"behavior": "allow"}
    return ask(tool, inp)


def ask(tool, inp):
    rid = "fake-" + uuid.uuid4().hex[:8]
    out({"type": "control_request", "request_id": rid,
         "request": {"subtype": "can_use_tool", "tool_name": tool, "input": inp, "tool_use_id": "tu-" + rid}})
    while True:
        m = read()
        if m.get("type") == "control_response" and m["response"].get("request_id") == rid:
            r = m["response"]
            if r.get("subtype") != "success":
                return {"behavior": "deny", "message": r.get("error", "hiba")}
            return r.get("response", {})
        if m.get("type") == "control_request":
            if handle_control(m) == "interrupt":
                return {"behavior": "deny", "message": "megszakítva"}
            continue
        pending.append(m)


def say(text):
    words = text.split(" ")
    for i, w in enumerate(words):
        out({"type": "stream_event", "uuid": str(uuid.uuid4()), "session_id": SID,
             "event": {"type": "content_block_delta", "index": 0,
                       "delta": {"type": "text_delta", "text": w + (" " if i < len(words) - 1 else "")}}})
        time.sleep(0.01)
    out({"type": "assistant", "session_id": SID, "uuid": str(uuid.uuid4()),
         "message": {"id": "msg", "model": "fake", "role": "assistant", "content": [{"type": "text", "text": text}]}})


def tool_use(tool, inp, result, is_error=False):
    tid = "tu-" + uuid.uuid4().hex[:8]
    out({"type": "assistant", "session_id": SID, "uuid": str(uuid.uuid4()),
         "message": {"id": "msg", "model": "fake", "role": "assistant",
                     "content": [{"type": "tool_use", "id": tid, "name": tool, "input": inp}]}})
    out({"type": "user", "session_id": SID, "uuid": str(uuid.uuid4()),
         "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": tid, "content": result,
                                                    "is_error": is_error}]}})


def turn(prompt):
    history.append(prompt)
    json.dump(history, open(HIST, "w"))
    out({"type": "system", "subtype": "init", "session_id": SID, "cwd": CWD, "tools": ["Read", "Edit", "Bash"],
         "model": "fake-modell-1", "permissionMode": arg("--permission-mode") or "default", "uuid": str(uuid.uuid4())})
    out({"type": "user", "session_id": SID, "uuid": str(uuid.uuid4()), "message": {"role": "user", "content": prompt}})
    if len(history) > 1:
        say(f"Folytatom a munkamenetet ({len(history) - 1} korábbi kérés).")
    p = prompt.lower()
    if "javítsd" in p:
        path = os.path.join(CWD, "calc.py")
        inp = {"file_path": path, "old_string": "return a - b", "new_string": "return a + b"}
        r = use("Edit", inp)
        if r.get("behavior") == "allow":
            s = open(path).read().replace("return a - b", "return a + b")
            open(path, "w").write(s)
            tool_use("Edit", inp, "a fájl módosítva")
            say("Kijavítottam: az add() kivonás helyett összead.")
        else:
            tool_use("Edit", inp, r.get("message", "elutasítva"), True)
            say("Nem kaptam engedélyt a módosításra.")
    elif "hozzáír" in p:
        inp = {"command": "printf '\\npróba\\n' >> calc.py"}
        r = use("Bash", inp)
        if r.get("behavior") == "allow":
            with open(os.path.join(CWD, "calc.py"), "a") as f:
                f.write("\npróba\n")
            tool_use("Bash", inp, "")
        say("Hozzáírtam a calc.py végére (Bash-sel).")
    elif "töröld" in p:
        inp = {"command": "git reset --hard", "description": "minden változás eldobása"}
        r = use("Bash", inp, auto=True)
        say("Elutasítva: " + r.get("message", "") if r.get("behavior") != "allow" else "Lefutott.")
    elif "commit" in p:
        inp = {"command": "git add proba.py && git commit -m 'javítás'"}
        r = use("Bash", inp, auto=True)     # egy megengedő szabály magától engedné — a horognak kell megállítania
        say("A commit " + ("engedélyezve." if r.get("behavior") == "allow" else "elutasítva."))
    else:
        files = sorted(f for f in os.listdir(CWD) if not f.startswith("."))
        say("A projekt fájljai: " + ", ".join(files) + ".")
    out({"type": "result", "subtype": "success", "duration_ms": 10, "duration_api_ms": 0, "is_error": False,
         "num_turns": 1, "session_id": SID, "result": "kész", "total_cost_usd": 0.0})


while True:
    m = pending.pop(0) if pending else read()
    t = m.get("type")
    if t == "control_request":
        handle_control(m)
    elif t == "user":
        c = m.get("message", {}).get("content")
        if isinstance(c, list):
            c = " ".join(b.get("text", "") for b in c if isinstance(b, dict))
        turn(str(c))
