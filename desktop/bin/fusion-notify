#!/usr/bin/python3
"""Fúzió — fusion-notify: értesítés küldése a Fúzió Shellnek (a Fúzió API fusion.notify modulján át)

    fusion-notify [-i ikon] [-u low|normal|critical] [-a program] [-t ms] <cím> [szöveg]

A szabványos org.freedesktop.Notifications szolgáltatáson át (a notify-send is ide küld).
Ikon: a Fusion ikonkészlet neve (laser, printer, wifi, usb, settings, files, …).
"""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))), "lib"))
from fusion import notify  # noqa: E402

sys.exit(notify.main())
