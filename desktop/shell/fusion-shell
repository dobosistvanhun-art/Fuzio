#!/bin/sh
# =============================================================================
#  Fúzió — fusion-shell: a Fúzió Desktop panelje, Start menüje és értesítései
#
#    fusion-shell                 állapot
#    fusion-shell menu            Start menü nyitása/zárása (Super, Alt+F1)
#    fusion-shell clip            vágólap-előzmények (Ctrl+Alt+V)
#    fusion-shell screen-off      a kijelző ki (Ctrl+Alt+K); egérmozdításra / billentyűre visszajön
#    fusion-shell run             (a munkamenet indítja) a Shell, összeomlás után újraindítással
#    fusion-shell stop            leállítás (a run-ciklus is kilép)
#    fusion-shell restart         újraindítás (pl. frissítés után)
# =============================================================================
set -u
RT="${XDG_RUNTIME_DIR:-/tmp}"
PIDF="$RT/fusion-shell.pid"
STOPF="$RT/fusion-shell.stop"
STATEF="$RT/fusion-shell.state"
MAIN=/usr/lib/fusion/desktop/shell/fusion_shell.py

say()  { printf '%s\n' "$*"; }
fail() { printf 'fusion-shell: %s\n' "$*" >&2; exit 1; }
pid() { p=$(cat "$PIDF" 2>/dev/null); [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "$p"; }

case "${1:-status}" in
    status)
        p=$(pid) || true
        if [ -n "${p:-}" ]; then say "Fúzió Shell: fut (pid $p)"; else say "Fúzió Shell: nem fut"; fi
        [ -n "${p:-}" ] && [ -r "$STATEF" ] && say "  állapot: $(cat "$STATEF")"
        ;;
    menu)
        p=$(pid) || true; [ -n "${p:-}" ] || fail "a Fúzió Shell nem fut"
        kill -USR1 "$p"
        ;;
    clip)
        p=$(pid) || true; [ -n "${p:-}" ] || fail "a Fúzió Shell nem fut"
        kill -USR2 "$p"
        ;;
    screen-off)
        # a billentyű felengedése után — különben a felengedés azonnal visszakapcsolná
        sleep 0.8; xset +dpms 2>/dev/null; xset dpms force off || fail "a kijelző nem kapcsolható ki (xset)"
        ;;
    stop)
        : > "$STOPF"; p=$(pid) || true; [ -n "${p:-}" ] && kill "$p"; true
        ;;
    restart)
        p=$(pid) || true; [ -n "${p:-}" ] && kill "$p"; true   # a run-ciklus újraindítja
        ;;
    run)
        rm -f "$STOPF"
        LOG="$HOME/.local/share/fusion/shell.log"; mkdir -p "$(dirname "$LOG")"
        while [ ! -e "$STOPF" ]; do
            [ -f "$LOG" ] && [ "$(wc -c < "$LOG")" -gt 1000000 ] && mv -f "$LOG" "$LOG.old"
            python3 "$MAIN" >> "$LOG" 2>&1 &
            echo $! > "$PIDF"
            wait $!
            [ -e "$STOPF" ] && break
            sleep 1
        done
        rm -f "$PIDF" "$STOPF"
        ;;
    *) fail "ismeretlen parancs: $1 (status, menu, clip, screen-off, run, stop, restart)" ;;
esac
