iputils-ping

# magyar nyelv, billentyűzet, konzol, időzóna
locales
keyboard-configuration
console-setup
console-setup-linux
kbd
tzdata

# kezelés és hibakeresés a fejlesztés alatt
procps
sudo
less
nano
pciutils
usbutils

# grafikus szerver (M2: X11 — a Wayland a 470-es NVIDIA driverrel nem járható út)
