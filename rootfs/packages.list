# FusionOS rendszerkép — csomaglista (Ubuntu 24.04 noble, minbase fölé)
# Egy sor = egy csomag. A # utáni rész megjegyzés.

# init, eszközkezelés, munkamenetek
systemd
systemd-sysv
udev
dbus
libpam-systemd
kmod

# kernelmodulok — pontosan a UKI kernelének verziója (build.conf: KERNEL_ABI)
linux-modules-@KERNEL_ABI@

# hálózat: vezetékes és Wi-Fi DHCP (systemd-networkd); Wi-Fi: iwd (jelenlegi megoldás,
# a NetworkManager/iwd végleges döntése a Fusion Desktop felületével együtt)
iwd
wireless-regdb
iproute2
netbase
systemd-resolved
iputils-ping

# magyar nyelv, billentyűzet, konzol, időzóna
locales
keyboard-configuration
console-setup
console-setup-linux
kbd
tzdata

# kezelés és hibakeresés a fejlesztés alatt
procps
sudo
less
nano
pciutils
usbutils

# grafikus szerver (M2: X11 — a Wayland a 470-es NVIDIA driverrel nem járható út)
xserver-xorg-core
xserver-xorg-legacy
xserver-xorg-input-libinput
xserver-xorg-video-fbdev
xinit
xauth
x11-xserver-utils
x11-xkb-utils
x11-utils
# Mesa: szoftveres / virtuális GPU-k (VirtualBox, QEMU); az NVIDIA a saját GL-jét hozza
libgl1-mesa-dri
libglx-mesa0
libegl-mesa0
libvulkan1
# M2 ideiglenes asztal (a Fusion Shell az M6-ban váltja): ablakkezelő, terminál, betűk
jwm
xterm
fonts-dejavu-core
# ellenőrzés: glxinfo, vulkaninfo
mesa-utils
vulkan-tools

# Fusion Windows Runtime (M4): a Wine futásidejű könyvtárai (a Wine maga forrásból
# fordul, build/steps/wine.sh; 32 bites Linux-könyvtár nem kell — WoW64)
libfreetype6
libfontconfig1
libgnutls30t64
libunwind8
libdbus-1-3
libx11-6
libxext6
libxrandr2
libxi6
libxcursor1
libxfixes3
libxinerama1
libxcomposite1
libxrender1
libxxf86vm1
libxkbfile1
libegl1
libgl1

# M5 — Klipper + Moonraker (a Python-környezet a build/steps/printer.sh-ból jön)
python3
libsodium23
libffi8
libjpeg-turbo8
zlib1g
nginx
curl
# a HTTPS-hez (Flathub, letöltések, a Windows-programok tanúsítványai a Wine-on át) — minbase-ben nincs
ca-certificates
# tömörített archívumok (tar.xz, tar.bz2) a parancssorban is
xz-utils
bzip2
# a nyomtató webes felületének ablaka (WebKitGTK) — fusion-web
python3-gi
gir1.2-gtk-3.0
gir1.2-webkit2-4.1

# M6 — Fusion Desktop (Qt 6 / Qt Quick, a mérés alapján): Fusion Shell (panel, Start menü,
# értesítések), Fájlkezelő, Beállítások — Python + QML, közös FusionUI modul
python3-xlib
x11-utils
python3-pyqt6
python3-pyqt6.qtquick
qt6-qpa-plugins
qml6-module-qtquick
qml6-module-qtquick-window
qml6-module-qtqml-workerscript
qml6-module-qtquick-controls
qml6-module-qtquick-templates
qml6-module-qtquick-layouts
libqt6svg6
# a fusion-admin: foglalt kötet kiírása (fuser); a Wi-Fi-t a Beállítások a D-Buson kérdezi (busctl)
psmisc

# M6 — Fusion Programkezelő, mérési szakasz: Linux-programok Flatpakként (Flathub), homokozó, portálok
# (a Firefox-mérés: fusion-appmeasure; a döntés a mérés után)
flatpak
xdg-utils
# hang: PipeWire (PulseAudio-felülettel a programoknak és a Flatpaknak), WirePlumber, ALSA-eszközök
pipewire
pipewire-pulse
pipewire-alsa
wireplumber
pulseaudio-utils
alsa-utils
# Google Drive a Fájlkezelőben: rclone (FUSE-csatolás)
rclone
# fejlesztés: verziókezelés (Wrangler-projektek)
git
bubblewrap
xdg-desktop-portal
xdg-desktop-portal-gtk
fuse3

# Fusion Lemezkezelő (2026-10-05, István döntése a mérés alapján — saját, a fusion-admin-ra építve):
# partíciós tábla (parted, sgdisk), formázás (FAT32, exFAT, NTFS; ext4: e2fsprogs), címke, lemezállapot (SMART)
parted
fdisk
gdisk
dosfstools
exfatprogs
ntfs-3g
smartmontools
