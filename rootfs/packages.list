libgl1-mesa-dri
libglx-mesa0
libegl-mesa0
libvulkan1
# M2 ideiglenes asztal (a Fúzió Shell az M6-ban váltja): ablakkezelő, terminál, betűk
jwm
xterm
# a Terminál (0.0.47): jobb gombos menü (Másolás, Beillesztés), fülek — VTE (GTK3 már van a képben), ~1,3 MB
lxterminal
fonts-dejavu-core
# ellenőrzés: glxinfo, vulkaninfo
mesa-utils
vulkan-tools

# Fúzió Windows Runtime (M4): a Wine futásidejű könyvtárai (a Wine maga forrásból
# fordul, build/steps/wine.sh; 32 bites Linux-könyvtár nem kell — WoW64)
libfreetype6
libfontconfig1
