#!/bin/sh
# Fusion Desktop — munkamenet (M6 mérőprototípus): JWM (ablakok) + Fusion Shell (panel, Start menü)
setxkbmap hu 2>/dev/null
xsetroot -solid '#16202b' -cursor_name left_ptr 2>/dev/null
xset s off -dpms 2>/dev/null
[ -d "${XDG_RUNTIME_DIR:-/nonexistent}" ] && touch "$XDG_RUNTIME_DIR/fusion-desktop.ready"
# a panel és a Start menü (a választott változat: fusion-shell use qml|web)
fusion-shell run &
# az állapot-terminál: a nyomtató webszerverét (nginx) megvárja, hogy ne írjon feleslegesen "inactive"-ot
xterm -geometry 110x32+40+40 -fa 'DejaVu Sans Mono' -fs 11 -title 'FusionOS' \
      -e sh -c 'fusion-hwinfo; echo; fusion-wifi 2>&1; echo; fusion-devices; echo; fwr list; echo; i=0; while [ $i -lt 20 ] && ! systemctl is-active -q nginx; do sleep 1; i=$((i+1)); done; fusion-printer; echo; echo "  Fusion Shell: fusion-shell use qml|web  |  mérés: fusion-uimeasure  |  Start menü: Alt+F1"; echo; exec bash -l' &
exec jwm
