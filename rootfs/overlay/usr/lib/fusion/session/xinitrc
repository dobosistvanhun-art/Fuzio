#!/bin/sh
# Fusion Desktop — munkamenet: JWM (ablakok) + Fusion Shell (panel, Start menü, értesítések)
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/fusion"
setxkbmap hu 2>/dev/null
# háttérszín (Beállítások → Asztal) — csak #rrggbb fogadható el
bg=$(cat "$CONF/background" 2>/dev/null); case "$bg" in \#[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;; *) bg='#16202b' ;; esac
xsetroot -solid "$bg" -cursor_name left_ptr 2>/dev/null
xset s off -dpms 2>/dev/null
# terminál: FusionDark színek, DejaVu Sans Mono
xrdb -nocpp -merge /usr/lib/fusion/session/Xresources 2>/dev/null
# kijelző-felbontás (Beállítások → Kijelző; csak xrandr-sor lehet benne)
DSP="$CONF/display.sh"
if [ -r "$DSP" ] && ! grep -qvE '^(#.*|xrandr --output [A-Za-z0-9_.:+-]+ --mode [A-Za-z0-9_.:+-]+)$' "$DSP"; then
    sh "$DSP" 2>/dev/null
fi
# Letöltések mappa (XDG): a Flatpak-programok (pl. Firefox) csak így írhatnak a valódi saját mappába —
# nélküle a letöltés a homokozó ideiglenes ~/Downloads mappájába kerül, és a program bezárásakor elvész
UD="${XDG_CONFIG_HOME:-$HOME/.config}/user-dirs.dirs"
if ! grep -q '^XDG_DOWNLOAD_DIR=' "$UD" 2>/dev/null; then
    mkdir -p "$(dirname "$UD")" && printf 'XDG_DOWNLOAD_DIR="$HOME/Letöltések"\n' >> "$UD"
fi
dl=$(sed -n 's/^XDG_DOWNLOAD_DIR="\(.*\)"$/\1/p' "$UD" | head -n 1 | sed "s#^\$HOME#$HOME#")
case "$dl" in /*) mkdir -p "$dl" ;; esac
# fejlesztői eszközök (fusion-dev): Node.js a DATA-n, az npm globális csomagjai (pl. wrangler) a saját mappában
export PATH="/data/dev/node/bin:$HOME/.local/bin:$PATH" NPM_CONFIG_PREFIX="$HOME/.local"
# a munkamenet-busz szolgáltatásai (portálok, értesítések) lássák a kijelzőt
export XDG_CURRENT_DESKTOP=FusionOS XDG_SESSION_TYPE=x11
dbus-update-activation-environment --systemd DISPLAY XAUTHORITY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE 2>/dev/null
[ -d "${XDG_RUNTIME_DIR:-/nonexistent}" ] && touch "$XDG_RUNTIME_DIR/fusion-desktop.ready"
# Programkezelő: a parancssorból telepített Flatpakok és a régi helyű Windows-programok leírást kapnak
timeout 30 fusion-programs sync >/dev/null 2>&1
fusion-shell run &
# a rendszerfrissítés eredménye (véglegesítés / visszaállás) értesítésként
/usr/lib/fusion/bin/fusion-boot-notice &
exec jwm
