#!/usr/bin/python3
"""Fúzió — fusion-install: a Fúzió Telepítő rendszeroldali része (root, csak a telepítő pendrive-on, telepítő módban)

    fusion-install list                                     a telepítendő csomag, a gép és a lemezek (JSON)
    fusion-install run <lemez> <new|keep-data> <megerősítés> [--fupd <fájl>] [--restore <mentés>] [--wifi]
                                                            telepítés (a megerősítés: a lemez neve, pl. sda);
                                                            --restore: új telepítéskor a DATA egy mentésből
                                                            (fusion-backup); --wifi: a telepítőben beállított
                                                            Wi-Fi-hálózat(ok) átvétele
    fusion-install report                                   hibajelentés a telepítő pendrive-ra (hibajelentes/)
    fusion-install media <fájl.fupd> <lemez> <megerősítés>  telepítő pendrive készítése egy .fupd-ből (T3 —
                                                            a futó Fúzióból is, Mint nélkül)

Módok:
  new         a lemez TELJES tartalma törlődik: ESP 512 MiB + A 4 GiB + B 4 GiB + DATA (a maradék)
  keep-data   meglévő Fúzió-lemezen: az ESP és az A slot újraíródik, a B kiürül, a DATA (programok,
              Wi-Fi, beállítások) MEGMARAD — az első indításkor a fusion-init az új rendszerképhez igazítja

A kimenet sorai: „LÉPÉS i/n: …”, „PROGRESS <0-100>”, a végén „KÉSZ: …” vagy „fusion-install: <hiba>”.
"""
import glob
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import shutil
import tarfile
import tempfile
import time

from fusion import hardware as fhw

os.environ["PATH"] = "/usr/sbin:/usr/bin:/sbin:/bin"
os.environ["LC_ALL"] = "C.UTF-8"
ADMIN = "/usr/lib/fusion/bin/fusion-admin"
PAYLOAD = "/run/fusion/payload"
MIB = 1024 * 1024
ESP_MIB, SLOT_MIB = 512, 4096
MIN_GIB = 10
TYPE_ESP = "C12A7328-F81F-11D2-BA4B-00A0C93EC93B"
TYPE_ROOT = "4F68BCE3-E8CD-4C4C-A2BA-B7DC76B5BEB9"
TYPE_DATA = "0FC63DAF-8483-4772-8E79-3D69D8477DE4"
STEPS = 7


def _load_update():
    loader = importlib.machinery.SourceFileLoader("fusion_update", "/usr/lib/fusion/bin/fusion-update")
    spec = importlib.util.spec_from_loader("fusion_update", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


fu = _load_update()


class InstallError(Exception):
    pass


def say(msg):
    print(msg, flush=True)


def step(i, text):
    say(f"LÉPÉS {i}/{STEPS}: {text}")


def progress(pct):
    say(f"PROGRESS {max(0, min(100, int(pct)))}")


def run(cmd, check=True, timeout=1800, inp=None):
    r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, input=inp, errors="replace")
    if check and r.returncode != 0:
        err = [l for l in (r.stderr or r.stdout or "").strip().splitlines() if l.strip() and "dmesg(1)" not in l]
        raise InstallError(f"{os.path.basename(cmd[0])}: " + (err[-1] if err else f"hibakód {r.returncode}"))
    return r


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def installer_mode():
    return os.path.exists("/run/fusion/installer")


def boot_disk():
    return read("/run/fusion/boot-disk")


def part_on(disk, label):
    """a lemez adott GPT-nevű partíciója (a kernel PARTNAME-je, vagy — ha a partíciót a partx vette fel,
    és ezért nincs neve a kernelben — közvetlenül a partíciós táblából)"""
    for n in sorted(os.listdir(f"/sys/block/{disk}")):
        if n.startswith(disk) and read(f"/sys/block/{disk}/{n}/partition"):
            u = read(f"/sys/block/{disk}/{n}/uevent")
            name = re.search(r"^PARTNAME=(.*)$", u, re.M)
            name = name.group(1) if name else run(["blkid", "-p", "-s", "PART_ENTRY_NAME", "-o", "value", f"/dev/{n}"],
                                                   check=False).stdout.strip()
            if name == label:
                return f"/dev/{n}"
    return ""


def part_num(disk, num):
    for n in sorted(os.listdir(f"/sys/block/{disk}")):
        if n.startswith(disk) and read(f"/sys/block/{disk}/{n}/partition") == str(num):
            return f"/dev/{n}"
    return ""


# --- a telepítendő csomag (a pendrive FUSION_IPAY partíciója) -------------------------------------

def mount_payload():
    if os.path.ismount(PAYLOAD):
        return PAYLOAD
    bd = boot_disk()
    dev = part_on(bd, "FUSION_IPAY") if bd and os.path.isdir(f"/sys/block/{bd}") else ""
    if not dev:
        raise InstallError("a telepítő pendrive csomag-partíciója (FUSION_IPAY) nem található")
    os.makedirs(PAYLOAD, exist_ok=True)
    run(["mount", "-t", "vfat", "-o", "ro,nodev,nosuid,noexec,utf8", dev, PAYLOAD])
    return PAYLOAD


def esp_static_of(src, fupd_path):
    """a céllemez ESP-jének állandó része: a .fupd esp-static.tar tagja (0.0.29-től), különben a mellette lévő fájl"""
    if src.tar is not None and "esp-static.tar" in src.members:
        out = "/run/fusion/esp-static.tar"
        with src.open("esp-static.tar") as s_, open(out, "wb") as o:
            shutil.copyfileobj(s_, o, 4 << 20)
        return out
    f = os.path.join(os.path.dirname(fupd_path), "esp-static.tar")
    if os.path.isfile(f):
        return f
    raise InstallError("hiányzik az esp-static.tar (a .fupd-ben vagy mellette)")


def payload():
    """a legújabb .fupd a csomag-partíción: verzió, méret, hiba"""
    d = mount_payload()
    best = None
    for p in glob.glob(os.path.join(d, "*.fupd")):
        try:
            meta, files = fu.read_manifest(fu.Source(p))
        except Exception as e:      # noqa: BLE001 — a hibás csomag ne állítsa le a listát
            if not best:
                best = {"path": p, "error": str(e)}
            continue
        info = {"path": p, "name": os.path.basename(p), "version": meta.get("FUSION_VERSION", "?"),
                "milestone": meta.get("FUSION_MILESTONE", ""), "stamp": meta.get("BUILD_STAMP", ""),
                "image": files["rootfs.erofs"][1], "error": ""}
        if not best or best.get("error") or info["stamp"] > best.get("stamp", ""):
            best = info
    if not best:
        return {"error": "nincs .fupd fájl a telepítő pendrive-on"}
    if not best.get("error"):
        src = fu.Source(best["path"])
        if "esp-static.tar" not in src.members and not os.path.isfile(os.path.join(d, "esp-static.tar")):
            best["error"] = "hiányzik az esp-static.tar a telepítő pendrive-ról"
    return best


# --- a gép és a lemezek -------------------------------------------------------------------------------

def machine():
    dmi = lambda k: read(f"/sys/class/dmi/id/{k}")      # noqa: E731
    mem = {l.split(":")[0]: l.split(":")[1] for l in read("/proc/meminfo").splitlines() if ":" in l}
    env = fhw.display()["raw"]      # Fúzió API: a display.env helyes (idézőjel nélküli) olvasása
    ac = [read(p + "/online") for p in glob.glob("/sys/class/power_supply/*") if read(p + "/type") == "Mains"]
    bat = [p for p in glob.glob("/sys/class/power_supply/*") if read(p + "/type") == "Battery"]
    return {"model": (dmi("sys_vendor") + " " + dmi("product_name")).strip() or "ismeretlen gép",
            "memory": int(mem.get("MemTotal", "0 kB").split()[0]) * 1024,
            "display": env.get("FUSION_DISPLAY_PROFILE", "?").strip('"') + " (" + env.get("FUSION_DISPLAY_STATUS", "?").strip('"') + ")",
            "efi": os.path.isdir("/sys/firmware/efi"),
            "ac": (ac[0] == "1") if ac else None, "battery": bool(bat),
            "batteryPct": int(read(bat[0] + "/capacity", "0") or 0) if bat else None}


def fusion_info(d):
    """meglévő Fúzió a lemezen: verzió (az ESP UKI-jai), DATA mérete és foglaltsága, kiosztás"""
    labels = {p["partlabel"]: p for p in d["partitions"]}
    if not {"FUSION_ESP", "FUSION_A", "FUSION_B", "FUSION_DATA"} <= set(labels):
        return None
    info = {"version": "", "dataSize": labels["FUSION_DATA"]["size"], "dataUsed": None, "layoutOk": True, "reason": ""}
    for k in ("FUSION_A", "FUSION_B"):
        if labels[k]["size"] < SLOT_MIB * MIB:
            info["layoutOk"], info["reason"] = False, f"a {k[-1]} slot kisebb a szokásosnál ({labels[k]['size'] >> 20} MiB)"
    if labels["FUSION_ESP"]["size"] < 256 * MIB:
        info["layoutOk"], info["reason"] = False, "az ESP túl kicsi"
    with tempfile.TemporaryDirectory() as t:
        if run(["mount", "-t", "vfat", "-o", "ro", labels["FUSION_ESP"]["path"], t], check=False).returncode == 0:
            try:
                names = [os.path.basename(p) for p in glob.glob(os.path.join(t, "EFI", "Linux", "fusionos-*.efi"))]
                best = sorted((n for n in names if "+0-" not in n), reverse=True)
                m = re.match(r"^fusionos-(.+?)-([a-z0-9]+)-(\d{14})-[AB]", best[0]) if best else None
                if m:
                    info["version"] = f"{m.group(1)} ({m.group(2)})"
            finally:
                run(["umount", t], check=False)
    r = run(["dumpe2fs", "-h", labels["FUSION_DATA"]["path"]], check=False, timeout=30)
    bc = re.search(r"^Block count:\s+(\d+)", r.stdout, re.M)
    fb = re.search(r"^Free blocks:\s+(\d+)", r.stdout, re.M)
    bs = re.search(r"^Block size:\s+(\d+)", r.stdout, re.M)
    if bc and fb and bs:
        info["dataUsed"] = (int(bc.group(1)) - int(fb.group(1))) * int(bs.group(1))
    else:
        info["layoutOk"], info["reason"] = False, "a DATA nem olvasható (nem ext4, vagy sérült)"
    return info


def disks():
    r = run([ADMIN, "disk", "list"], check=False, timeout=120)
    try:
        data = json.loads(r.stdout[r.stdout.index("{"):])
    except ValueError:
        raise InstallError("a lemezlista nem olvasható: " + (r.stderr or r.stdout).strip()[-200:])
    out = []
    for d in data["disks"]:
        e = {k: d[k] for k in ("name", "path", "model", "size", "kind", "removable", "table", "otheros")}
        e["fusion"] = fusion_info(d)
        e["parts"] = [{"name": p["name"], "label": p["label"] or p["partlabel"], "fstype": p["fstype"], "size": p["size"]}
                      for p in d["partitions"]]
        e["eligible"], e["reason"] = True, ""
        if d["system"]:
            e["eligible"], e["reason"] = False, "ez a telepítő pendrive"
        elif d["ro"]:
            e["eligible"], e["reason"] = False, "írásvédett"
        elif d["size"] < MIN_GIB * 1024 * MIB:
            e["eligible"], e["reason"] = False, f"túl kicsi (legalább {MIN_GIB} GiB kell)"
        elif d.get("inuse"):
            e["eligible"], e["reason"] = False, "használatban: " + d["inuse"]
        e["keepData"] = bool(e["eligible"] and e["fusion"] and e["fusion"]["layoutOk"])
        out.append(e)
    return out


def cmd_list():
    res = {"installer": installer_mode(), "machine": machine(), "disks": [], "payload": {}, "error": "",
           "backups": backups(), "wifi": wifi_known()}
    try:
        res["payload"] = payload()
    except InstallError as e:
        res["payload"] = {"error": str(e)}
    try:
        res["disks"] = disks()
    except InstallError as e:
        res["error"] = str(e)
    json.dump(res, sys.stdout, ensure_ascii=False)
    print()


# --- telepítés ----------------------------------------------------------------------------------------

def unmount_disk(disk):
    for line in read("/proc/self/mounts").splitlines():
        dev, mp = line.split()[:2]
        mp = mp.replace("\\040", " ")
        if os.path.realpath(dev).startswith(f"/dev/{disk}") and dev != "tmpfs":
            if not mp.startswith("/run/media/fusion/"):
                raise InstallError(f"a lemez egy kötetét a rendszer használja: {mp}")
            r = run([ADMIN, "unmount", mp], check=False)
            if r.returncode != 0:
                raise InstallError((r.stderr or r.stdout).strip().replace("fusion-admin: ", ""))
            say(f"leválasztva: {mp}")


def sync_kernel(disk, want):
    for _ in range(10):
        run(["partx", "-u", f"/dev/{disk}"], check=False)
        run(["partx", "-a", f"/dev/{disk}"], check=False)
        run(["udevadm", "settle", "--timeout=15"], check=False)
        if all(part_num(disk, i) for i in range(1, want + 1)):
            return
        time.sleep(1)
    raise InstallError("a kernel nem látja az új partíciókat (húzza ki és dugja vissza a lemezt, majd próbálja újra)")


def esp_partuuid(disk):
    p = part_num(disk, 1)
    return run(["blkid", "-p", "-s", "PART_ENTRY_UUID", "-o", "value", p], check=False).stdout.strip().lower() if p else ""


def boot_entry(disk, removable, old_uuid):
    """UEFI-bejegyzés „Fúzió” néven (belső lemezre); a mostani első bejegyzés marad elöl (D3)"""
    if removable:
        say("UEFI: cserélhető lemez — a gép boot menüjében (F9) magától megjelenik")
        return
    if not os.path.isdir("/sys/firmware/efi") or run(["sh", "-c", "command -v efibootmgr"], check=False).returncode:
        say("UEFI: efibootmgr nem érhető el — a lemez a boot menüben (F9) választható")
        return
    v = run(["efibootmgr", "-v"], check=False).stdout
    new_uuid = esp_partuuid(disk)
    order = re.search(r"^BootOrder:\s*(\S+)", v, re.M)
    order = order.group(1).split(",") if order else []
    # a céllemez korábbi Fúzió-bejegyzése (a régi vagy az új partíció-azonosítóval) törlődik
    for m in re.finditer(r"^Boot([0-9A-Fa-f]{4})\*?\s+(?:FusionOS|Fuzio)(?:\t.*)?\s*$", v, re.M):
        line = m.group(0).lower()
        if (old_uuid and old_uuid in line) or (new_uuid and new_uuid in line):
            run(["efibootmgr", "-q", "-b", m.group(1), "-B"], check=False)
            order = [o for o in order if o.upper() != m.group(1).upper()]
            say(f"UEFI: a lemez régi bejegyzése törölve (Boot{m.group(1)})")
    label = "Fuzio"
    run(["efibootmgr", "-q", "-c", "-d", f"/dev/{disk}", "-p", "1", "-L", label, "-l", "\\EFI\\BOOT\\BOOTX64.EFI"])
    v2 = run(["efibootmgr", "-v"], check=False).stdout
    new = next((m.group(1) for m in re.finditer(r"^Boot([0-9A-Fa-f]{4})\*?\s+(?:FusionOS|Fuzio)(?:\t.*)?\s*$", v2, re.M)
                if new_uuid and new_uuid in m.group(0).lower()), None)
    if not new:
        say("UEFI: a bejegyzés nem látszik az efibootmgr listájában — a lemez a boot menüben (F9) választható")
        return
    names = {m.group(1).upper(): m.group(2) for m in re.finditer(r"^Boot([0-9A-Fa-f]{4})\*?\s+(.*)$", v2, re.M)}
    order = [o for o in order if o.upper() != new.upper()]
    first = order[0] if order else ""
    # D3: ha a mostani első egy másik rendszer (pl. a Mint), az marad elöl, a Fúzió mögötte (F9-cel választható)
    if first and not names.get(first.upper(), "").split("\t")[0].strip() in ("FusionOS", "Fuzio"):
        new_order = [first, new] + order[1:]
        msg = f"UEFI: „Fuzio” (Boot{new}) — az alapértelmezett indítás változatlan ({names.get(first.upper(), first).split(chr(9))[0][:40]}); F9-cel választható"
    else:
        new_order = [new] + order
        msg = f"UEFI: „Fuzio” (Boot{new}) — ez indul alapértelmezettként"
    run(["efibootmgr", "-q", "-o", ",".join(new_order)], check=False)
    say(msg)


def wifi_known():
    out = []
    for f in sorted(glob.glob("/var/lib/iwd/*.psk") + glob.glob("/var/lib/iwd/*.open")):
        n = os.path.basename(f).rsplit(".", 1)[0]
        if n.startswith("="):
            try:
                n = bytes.fromhex(n[1:]).decode(errors="replace")
            except ValueError:
                pass
        out.append(n)
    return out


def backups():
    out = []
    for info_f in sorted(glob.glob("/run/media/fusion/*/FusionOS-mentes/*.info.json"), reverse=True):
        try:
            with open(info_f) as f:
                info = json.load(f)
        except (OSError, ValueError):
            continue
        base = info_f[:-len(".info.json")]
        parts = sorted(glob.glob(glob.escape(base) + ".[0-9][0-9][0-9]")) or ([base] if os.path.isfile(base) else [])
        if not info.get("complete") or not parts:
            continue
        info.update(path=base, parts=parts, volume=os.path.dirname(os.path.dirname(base)), name=os.path.basename(base))
        out.append(info)
    return out


def find_backup(path):
    b = next((x for x in backups() if x["path"] == os.path.realpath(path) or x["path"] == path), None)
    if not b:
        raise InstallError(f"a mentés nem található (csatolt külső lemez, FusionOS-mentes mappa): {path}")
    return b


def restore_into(target, b):
    """a mentés kicsomagolása az új DATA-ra (tulajdonosok, jogok, bővített attribútumok megtartásával)"""
    say(f"visszaállítás a mentésből: {b['name']} ({b.get('version', '?')}, {b.get('date', '')[:16]}), "
        f"{b.get('bytes', 0) >> 20} MiB tömörítve")
    cat = subprocess.Popen(["cat"] + b["parts"], stdout=subprocess.PIPE)
    zst = subprocess.Popen(["zstd", "-q", "-dc"], stdin=cat.stdout, stdout=subprocess.PIPE)
    cat.stdout.close()
    tar = subprocess.Popen(["tar", "-x", "-p", "-f", "-", "-C", target, "--numeric-owner", "--xattrs", "--xattrs-include=*",
                            "--acls", "--exclude=fusion-backup.info", "--checkpoint=2560", "--checkpoint-action=echo=CKPT %u"],
                           stdin=zst.stdout, stderr=subprocess.PIPE, text=True, errors="replace")
    zst.stdout.close()
    total, errs, last = max(1, b.get("dataUsed", 1)), [], -5
    for line in tar.stderr:
        m = re.search(r"CKPT (\d+)$", line.strip())
        if m:
            pct = min(99, int(m.group(1)) * 10240 * 100 // total)
            if pct >= last + 5:
                last = pct - pct % 5
                progress(88 + pct * 8 // 100)
        elif line.strip():
            errs.append(line.strip())
    rt, rz, rc = tar.wait(), zst.wait(), cat.wait()
    if rt != 0 or rz != 0 or rc != 0:
        raise InstallError("a visszaállítás nem sikerült: " + ("; ".join(errs[-3:]) or f"tar {rt}, zstd {rz}"))
    say("DATA: visszaállítva a mentésből")


def copy_wifi(target):
    src = "/var/lib/iwd"
    files = [f for f in glob.glob(os.path.join(src, "*")) if f.rsplit(".", 1)[-1] in ("psk", "open", "8021x")]
    if not files:
        say("Wi-Fi: a telepítőben nincs beállított hálózat — kihagyva")
        return
    dst = os.path.join(target, "overlay", "root", "upper", "var", "lib", "iwd")
    os.makedirs(dst, mode=0o700, exist_ok=True)
    os.chmod(dst, 0o700)
    for f in files:
        shutil.copy2(f, dst)
        os.chmod(os.path.join(dst, os.path.basename(f)), 0o600)
    say(f"Wi-Fi: {len(files)} hálózat átvéve ({', '.join(wifi_known())})")


def cmd_run(disk, mode, confirm, fupd=None, restore=None, wifi=False):
    if not installer_mode():
        raise InstallError("csak a telepítő pendrive-ról indított rendszerben használható")
    if mode not in ("new", "keep-data"):
        raise InstallError("mód: new vagy keep-data")
    t0 = time.time()
    step(1, "ellenőrzés")
    pay = {"path": fupd} if fupd else payload()
    if pay.get("error"):
        raise InstallError(pay["error"])
    d = next((x for x in disks() if x["name"] == disk), None)
    if not d:
        raise InstallError(f"nincs ilyen lemez: {disk}")
    if not d["eligible"]:
        raise InstallError(f"{disk}: {d['reason']}")
    if confirm.strip() != disk:
        raise InstallError(f"a megerősítés nem egyezik: a lemez neve „{disk}”, beírva: „{confirm}”")
    if mode == "keep-data" and not d["keepData"]:
        raise InstallError(f"{disk}: a DATA megőrzésével csak meglévő Fúzió-lemezre lehet telepíteni"
                           + (f" ({d['fusion']['reason']})" if d["fusion"] and d["fusion"]["reason"] else ""))
    src = fu.Source(pay["path"])
    meta, files = fu.read_manifest(src)
    esp_static = esp_static_of(src, pay["path"])
    backup = find_backup(restore) if restore else None
    if backup and mode != "new":
        raise InstallError("mentésből csak új telepítéskor lehet visszaállítani")
    if backup and backup["dataUsed"] > d["size"] - (ESP_MIB + 2 * SLOT_MIB + 64) * MIB:
        raise InstallError("a mentés nem fér el a lemezen")
    ver = f"Fúzió {meta.get('FUSION_VERSION', '?')} ({meta.get('FUSION_MILESTONE', '')})"
    say(f"telepítés: {ver} → /dev/{disk} ({d['model']}, {d['size'] >> 30} GiB), mód: "
        + ("új telepítés" if mode == "new" else "újratelepítés a DATA megőrzésével"))
    progress(2)

    step(2, "a telepítőcsomag ellenőrzése (SHA-256)")
    for name, w0, w1 in (("uki-A.efi", 2, 4), ("rootfs.erofs", 4, 25)):
        want, size = files[name]
        if fu.sha256(src, name, size) != want:
            raise InstallError(f"{name}: az ellenőrzőösszeg nem egyezik — sérült a .fupd fájl (másolja újra a pendrive-ra)")
        progress(w1)
    say("a csomag ép")

    old_uuid = esp_partuuid(disk)
    unmount_disk(disk)
    if mode == "new":
        step(3, "particionálás (a lemez teljes tartalma törlődik)")
        for p in d["parts"]:
            run(["wipefs", "-a", "-q", f"/dev/{p['name']}"], check=False)
        run(["wipefs", "-a", "-q", f"/dev/{disk}"])
        m = 2048
        a0 = m + ESP_MIB * m
        b0 = a0 + SLOT_MIB * m
        d0 = b0 + SLOT_MIB * m
        script = (f"label: gpt\nstart={m}, size={ESP_MIB * m}, type={TYPE_ESP}, name=\"FUSION_ESP\"\n"
                  f"start={a0}, size={SLOT_MIB * m}, type={TYPE_ROOT}, name=\"FUSION_A\"\n"
                  f"start={b0}, size={SLOT_MIB * m}, type={TYPE_ROOT}, name=\"FUSION_B\"\n"
                  f"start={d0}, type={TYPE_DATA}, name=\"FUSION_DATA\"\n")
        run(["sfdisk", "-q", "--wipe", "always", "--wipe-partitions", "always", f"/dev/{disk}"], inp=script)
        sync_kernel(disk, 4)
        say("partíciók: ESP 512 MiB, A 4 GiB, B 4 GiB, DATA " + f"{(d['size'] - (d0 + 2048) * 512) >> 30} GiB")
    else:
        step(3, "a meglévő Fúzió-partíciók (a DATA megmarad)")
    pesp, pa, pb, pdata = (part_on(disk, x) for x in ("FUSION_ESP", "FUSION_A", "FUSION_B", "FUSION_DATA"))
    if not all((pesp, pa, pb, pdata)):
        raise InstallError("a Fúzió-partíciók nem találhatók a lemezen")
    progress(28)

    step(4, "a rendszerkép írása az A slotba (visszaolvasással)")
    want, size = files["rootfs.erofs"]
    orig_say = fu.say

    def slot_say(msg):
        mm = re.match(r"\s*írás (\d+)%", msg)
        if mm:
            progress(28 + int(mm.group(1)) * 52 // 100)
        else:
            say(msg)
    fu.say = slot_say
    try:
        fu.write_slot(src, size, want, pa)
    finally:
        fu.say = orig_say
    run(["wipefs", "-a", "-q", pb], check=False)
    say("B slot: üres (a következő frissítés ide kerül)")
    progress(82)

    step(5, "rendszerbetöltő (ESP)")
    run(["mkfs.vfat", "-F", "32", "-n", "FUSION_ESP", pesp])
    uki = meta.get("UKI_A") or ""
    if not re.match(r"^fusionos-.+-A\.efi$", uki):
        raise InstallError("a csomag manifestjében nincs érvényes UKI_A")
    with tempfile.TemporaryDirectory() as t:
        run(["mount", "-t", "vfat", "-o", "rw,nodev,nosuid,noexec", pesp, t])
        try:
            with tarfile.open(esp_static) as tf:
                for m in tf.getmembers():
                    if m.name.startswith("/") or ".." in m.name.split("/") or not (m.isfile() or m.isdir()):
                        raise InstallError(f"esp-static.tar: érvénytelen elem: {m.name}")
                tf.extractall(t, filter="data")
            os.makedirs(os.path.join(t, "EFI", "Linux"), exist_ok=True)
            for old in glob.glob(os.path.join(t, "EFI", "Linux", "fusionos-*.efi")):
                os.unlink(old)
            with src.open("uki-A.efi") as s, open(os.path.join(t, "EFI", "Linux", uki), "wb") as o:
                while True:
                    b = s.read(4 << 20)
                    if not b:
                        break
                    o.write(b)
            fu.fix_entries(t, uki, "A")
            for need in ("EFI/BOOT/BOOTX64.EFI", "loader/loader.conf", f"EFI/Linux/{uki}"):
                if not os.path.isfile(os.path.join(t, need)):
                    raise InstallError(f"az ESP-ről hiányzik: {need}")
            say(f"ESP: systemd-boot + {uki}")
        finally:
            fu.syncfs(t)
            run(["umount", t], check=False)
    r = run(["fsck.vfat", "-n", pesp], check=False)
    if r.returncode not in (0, 1):
        raise InstallError("az ESP ellenőrzése hibát talált: " + r.stdout.strip()[-200:])
    progress(88)

    step(6, "adatpartíció (DATA)" + (" — visszaállítás a mentésből" if backup else ""))
    if mode == "new":
        run(["mkfs.ext4", "-q", "-F", "-E", "nodiscard", "-L", "FUSION_DATA", pdata])
        say("DATA: új (ext4)")
        if backup or wifi:
            with tempfile.TemporaryDirectory() as t:
                run(["mount", "-t", "ext4", pdata, t])
                try:
                    if backup:
                        restore_into(t, backup)
                    if wifi:
                        copy_wifi(t)
                finally:
                    fu.syncfs(t)
                    run(["umount", t], check=False)
    else:
        r = run(["e2fsck", "-n", pdata], check=False, timeout=1800)
        say("DATA: megtartva" + ("" if r.returncode == 0 else
                                 f" — FIGYELEM: a fájlrendszer-ellenőrzés eltérést jelzett (kód {r.returncode}); "
                                 "az első indításkor a rendszer javítja"))
    progress(97)

    step(7, "UEFI boot-bejegyzés")
    try:
        boot_entry(disk, d["removable"], old_uuid)
    except InstallError as e:
        say(f"UEFI: a bejegyzés nem sikerült ({e}) — a lemez a boot menüben (F9) választható")
    os.sync()
    progress(100)
    say(f"KÉSZ: {ver} telepítve: /dev/{disk} ({int(time.time() - t0)} mp). Vegye ki a telepítő pendrive-ot, majd indítsa újra a gépet.")


INST_ESP_MIB = 256


def fs_disk_of(path):
    """a fájlt tartalmazó kötet lemeze (a forrás nem lehet a céllemezen)"""
    best, dev = "", ""
    for line in read("/proc/self/mounts").splitlines():
        p = line.split()
        mp = p[1].replace("\\040", " ")
        if (path == mp or path.startswith(mp.rstrip("/") + "/")) and len(mp) > len(best) and p[0].startswith("/dev/"):
            best, dev = mp, os.path.realpath(p[0])
    if not dev:
        return ""
    n = os.path.basename(dev)
    parent = os.path.basename(os.path.dirname(os.path.realpath(f"/sys/class/block/{n}")))
    return parent if os.path.isdir(f"/sys/block/{parent}") else n


def cmd_media(fupd, disk, confirm):
    """telepítő pendrive egy .fupd-ből: FUSION_IESP (systemd-boot + a telepítő UKI-ja), FUSION_ISYS (a rendszerkép),
    FUSION_IPAY (FAT32 „FUSIONINST”: maga a .fupd) — ugyanaz, mint a Minten a fusion-build installer"""
    t0 = time.time()
    steps = 6

    def mstep(i, text):
        say(f"LÉPÉS {i}/{steps}: {text}")
    mstep(1, "ellenőrzés")
    fupd = os.path.realpath(fupd)
    if not fupd.endswith(".fupd") or not os.path.isfile(fupd):
        raise InstallError(f"nem .fupd fájl: {fupd}")
    src = fu.Source(fupd)
    meta, files = fu.read_manifest(src)
    if "uki-installer.efi" not in files or "esp-static.tar" not in files:
        raise InstallError("ebből a .fupd-ből nem készíthető telepítő (régebbi csomag, 0.0.29 előtti) — egy újabb .fupd kell")
    d = next((x for x in disks() if x["name"] == disk), None)
    if not d:
        raise InstallError(f"nincs ilyen lemez: {disk}")
    if d["reason"] == "ez a telepítő pendrive" or disk == boot_disk():
        raise InstallError(f"{disk}: a futó rendszer lemeze")
    if not d["removable"]:
        raise InstallError(f"{disk}: csak cserélhető lemezre (pendrive, SD-kártya) készíthető telepítő")
    if fs_disk_of(fupd) == disk:
        raise InstallError(f"{disk}: a .fupd fájl ezen a lemezen van — az törlődne; másolja előbb máshová (pl. Letöltések)")
    img = files["rootfs.erofs"][1]
    sys_mib = (img // MIB + 64 + 63) // 64 * 64
    need = (1 + INST_ESP_MIB + sys_mib + 1) * MIB + os.path.getsize(fupd) + (64 << 20)
    if d["size"] < need:
        raise InstallError(f"{disk}: túl kicsi — legalább {need >> 20} MiB kell")
    if confirm.strip() != disk:
        raise InstallError(f"a megerősítés nem egyezik: a lemez neve „{disk}”, beírva: „{confirm}”")
    ver = f"Fúzió {meta.get('FUSION_VERSION', '?')} ({meta.get('FUSION_MILESTONE', '')})"
    say(f"telepítő pendrive: {ver} → /dev/{disk} ({d['model']}, {d['size'] >> 20} MiB)")

    mstep(2, "a csomag ellenőrzése (SHA-256)")
    n = 0
    for name, (want, size) in files.items():
        if fu.sha256(src, name, size) != want:
            raise InstallError(f"{name}: az ellenőrzőösszeg nem egyezik — sérült a .fupd fájl")
        n += 1
        progress(2 + n * 18 // len(files))

    mstep(3, "particionálás (a pendrive teljes tartalma törlődik)")
    unmount_disk(disk)
    for p in d["parts"]:
        run(["wipefs", "-a", "-q", f"/dev/{p['name']}"], check=False)
    run(["wipefs", "-a", "-q", f"/dev/{disk}"])
    m = 2048
    s1, s2 = m, m + INST_ESP_MIB * m
    s3 = s2 + sys_mib * m
    script = (f"label: gpt\nstart={s1}, size={INST_ESP_MIB * m}, type={TYPE_ESP}, name=\"FUSION_IESP\"\n"
              f"start={s2}, size={sys_mib * m}, type={TYPE_DATA}, name=\"FUSION_ISYS\"\n"
              f"start={s3}, type=EBD0A0A2-B9E5-4433-87C0-68B6B72699C7, name=\"FUSION_IPAY\"\n")
    run(["sfdisk", "-q", "--wipe", "always", "--wipe-partitions", "always", f"/dev/{disk}"], inp=script)
    sync_kernel(disk, 3)
    pesp, psys, ppay = part_num(disk, 1), part_num(disk, 2), part_num(disk, 3)
    progress(22)

    mstep(4, "a rendszerkép (visszaolvasással)")
    want, size = files["rootfs.erofs"]
    orig_say = fu.say

    def slot_say(msg):
        mm = re.match(r"\s*írás (\d+)%", msg)
        if mm:
            progress(22 + int(mm.group(1)) * 40 // 100)
        else:
            say(msg)
    fu.say = slot_say
    try:
        fu.write_slot(src, size, want, psys)
    finally:
        fu.say = orig_say
    progress(62)

    mstep(5, "rendszerbetöltő (ESP)")
    run(["mkfs.vfat", "-F", "32", "-n", "FUSIONIESP", pesp])
    esp_static = esp_static_of(src, fupd)
    with tempfile.TemporaryDirectory() as t, tempfile.TemporaryDirectory() as x:
        with tarfile.open(esp_static) as tf:
            tf.extractall(x, filter="data")
        run(["mount", "-t", "vfat", "-o", "rw,nodev,nosuid,noexec", pesp, t])
        try:
            for sub in ("EFI/BOOT", "EFI/systemd", "EFI/Linux", "loader"):
                os.makedirs(os.path.join(t, sub), exist_ok=True)
            shutil.copyfile(os.path.join(x, "EFI/BOOT/BOOTX64.EFI"), os.path.join(t, "EFI/BOOT/BOOTX64.EFI"))
            shutil.copyfile(os.path.join(x, "EFI/systemd/systemd-bootx64.efi"), os.path.join(t, "EFI/systemd/systemd-bootx64.efi"))
            if os.path.isfile(os.path.join(x, "EFI/Linux/fusion-diag.efi")):
                shutil.copyfile(os.path.join(x, "EFI/Linux/fusion-diag.efi"), os.path.join(t, "EFI/Linux/fusion-diag.efi"))
            with src.open("uki-installer.efi") as s_, open(os.path.join(t, "EFI/Linux/fusion-installer.efi"), "wb") as o:
                shutil.copyfileobj(s_, o, 4 << 20)
            with open(os.path.join(t, "loader/loader.conf"), "w") as f:
                f.write("timeout 3\ndefault fusion-installer*\nconsole-mode keep\neditor yes\n")
        finally:
            fu.syncfs(t)
            run(["umount", t], check=False)
    progress(68)

    mstep(6, "a telepítendő csomag (FUSIONINST)")
    run(["mkfs.vfat", "-F", "32", "-n", "FUSIONINST", ppay])
    with tempfile.TemporaryDirectory() as t:
        run(["mount", "-t", "vfat", "-o", "rw,nodev,nosuid,noexec,utf8", ppay, t])
        try:
            total, done, last = os.path.getsize(fupd), 0, -5
            with open(fupd, "rb") as s_, open(os.path.join(t, os.path.basename(fupd)), "wb") as o:
                while True:
                    b = s_.read(8 << 20)
                    if not b:
                        break
                    o.write(b)
                    done += len(b)
                    if done % (32 << 20) == 0:
                        os.fdatasync(o.fileno())      # lásd fu.write_slot: kis adagokban a pendrive-ra
                    pct = done * 100 // total
                    if pct >= last + 5:
                        last = pct - pct % 5
                        progress(68 + pct * 30 // 100)
                o.flush()
                os.fsync(o.fileno())
            os.makedirs(os.path.join(t, "hibajelentes"), exist_ok=True)
            with open(os.path.join(t, "OLVASS-EL.txt"), "w") as f:
                f.write(f"Fúzió telepítő pendrive ({ver})\n\nIndítás: a gép boot menüje (ZBook: F9) -> ez a pendrive.\n"
                        "Új telepítés, újratelepítés a DATA megőrzésével, vagy új telepítés egy mentésből.\n"
                        "A .fupd kicserélhető egy újabbra (egyszerre csak egy legyen itt).\n")
        finally:
            fu.syncfs(t)
            run(["umount", t], check=False)
    r = run(["fsck.vfat", "-n", ppay], check=False)
    if r.returncode not in (0, 1):
        raise InstallError("a csomag-partíció ellenőrzése hibát talált")
    progress(100)
    say(f"KÉSZ: telepítő pendrive ({ver}) a /dev/{disk} lemezen ({int(time.time() - t0)} mp). "
        "Indítás: a gép boot menüje (ZBook: F9) → ez a pendrive.")


def cmd_report():
    """hibajelentés a telepítő pendrive-ra (a RAM-ban lévő Letöltések újraindításkor elveszne)"""
    bd = boot_disk()
    dev = part_on(bd, "FUSION_IPAY") if bd else ""
    if not dev:
        raise InstallError("a telepítő pendrive csomag-partíciója (FUSION_IPAY) nem található")
    if os.path.ismount(PAYLOAD):
        run(["umount", PAYLOAD], check=False)
    with tempfile.TemporaryDirectory() as t:
        run(["mount", "-t", "vfat", "-o", "rw,nodev,nosuid,noexec,utf8", dev, t])
        try:
            out = os.path.join(t, "hibajelentes")
            os.makedirs(out, exist_ok=True)
            r = run(["/usr/lib/fusion/bin/fusion-report", "-d", "A Fúzió Telepítő hibajelentése", "-o", out],
                    check=False, timeout=300)
            say(r.stdout.strip().splitlines()[-2] if r.stdout.strip() else "a hibajelentés nem készült el")
            say("a telepítő pendrive „FUSIONINST” kötetén, a hibajelentes mappában")
        finally:
            fu.syncfs(t)
            run(["umount", t], check=False)


def main(argv):
    if os.geteuid() != 0:
        print("fusion-install: rootként kell futnia (sudo -n fusion-admin install …)", file=sys.stderr)
        return 1
    try:
        if argv[:1] == ["list"] and len(argv) == 1:
            cmd_list()
        elif argv[:1] == ["run"] and len(argv) >= 4:
            opts, rest = {"fupd": None, "restore": None, "wifi": False}, argv[4:]
            while rest:
                if rest[0] in ("--fupd", "--restore") and len(rest) >= 2:
                    opts[rest[0][2:]] = rest[1]
                    rest = rest[2:]
                elif rest[0] == "--wifi":
                    opts["wifi"], rest = True, rest[1:]
                else:
                    raise InstallError("ismeretlen kapcsoló: " + rest[0])
            cmd_run(argv[1], argv[2], argv[3], **opts)
        elif argv[:1] == ["media"] and len(argv) == 4:
            cmd_media(argv[1], argv[2], argv[3])
        elif argv == ["report"]:
            cmd_report()
        else:
            print(__doc__, file=sys.stderr)
            return 2
    except (InstallError, fu.UpdateError) as e:
        print(f"fusion-install: {e}", file=sys.stderr, flush=True)
        return 1
    except subprocess.TimeoutExpired as e:
        print(f"fusion-install: időtúllépés: {e.cmd[0]}", file=sys.stderr, flush=True)
        return 1
    except OSError as e:
        print(f"fusion-install: lemezhiba: {e.strerror or e}{' (' + e.filename + ')' if e.filename else ''} — a lemez "
              "nem válaszol: kihúzták, kilazult, vagy meghibásodott. Másik USB-port vagy pendrive.", file=sys.stderr, flush=True)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
