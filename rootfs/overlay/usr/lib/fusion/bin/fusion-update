#!/usr/bin/python3
"""Fúzió — A/B rendszerfrissítés (M7)

    fusion-update status              slotok és boot-bejegyzések (aktív, próba, hibás, tartalék)
    fusion-update apply <fájl.fupd|mappa>
                                      frissítés az INAKTÍV slotba (a futó rendszerhez nem nyúl);
                                      a csomagban: fusion-update.manifest, rootfs.erofs, uki-A.efi, uki-B.efi
    fusion-update reboot              újraindítás — a következő indítás is a Fúzió (UEFI BootNext)
    fusion-update boot-check          (fusion-boot-check.service) a sikeres indulás ellenőrzése;
                                      próba-indításnál siker esetén véglegesít, hiba esetén újraindít

Működés (systemd-boot „Automatic Boot Assessment”): az új rendszer UKI-ja `…-B+3.efi` néven kerül az
ESP-re; a systemd-boot minden indításkor csökkenti a számlálót. Ha a rendszer rendben elindul, ez a
program leveszi a számlálót (véglegesítés). Ha háromszor nem sikerül, a bejegyzés hátra kerül, és
magától a korábbi slot indul. Root kell hozzá (a grafikus felület a fusion-admin segéden át hívja).
"""
import fcntl
import glob
import hashlib
import json
import os
import re
import subprocess
import sys
import tarfile
import time

EFIVARS = "/sys/firmware/efi/efivars"
LOADER_GUID = "4a67b082-0a4c-41cf-b6c7-440b29bb8c4f"
ESP_MNT = "/run/fusion/esp"
STATE = "/run/fusion/boot-state"
TRIES = 3
DESKTOP_WAIT = int(os.environ.get("FUSION_BOOTCHECK_WAIT", "300"))
# a systemd-boot az azonosítót kisbetűsen adja vissza (LoaderEntrySelected) — az illesztés kis/nagybetű-független
UKI_RE = re.compile(r"^fusionos-(?P<base>.+)-(?P<slot>[AB])(?:\+(?P<left>\d+)(?:-(?P<done>\d+))?)?\.efi$", re.IGNORECASE)
HOOKS = "/usr/lib/fusion/boot-ok.d"


class UpdateError(Exception):
    pass


def syncfs(path):
    """csak az adott kötet ürítése (syncfs) — a teljes os.sync() egy közben író lassú pendrive-ot is kivárna"""
    import ctypes
    try:
        fd = os.open(path, os.O_RDONLY)
    except OSError:
        os.sync()
        return
    try:
        if ctypes.CDLL(None, use_errno=True).syncfs(fd) != 0:
            os.fsync(fd)
    finally:
        os.close(fd)


def say(msg):
    print(msg, flush=True)


def efivar(name):
    try:
        with open(f"{EFIVARS}/{name}-{LOADER_GUID}", "rb") as f:
            raw = f.read()[4:]
    except OSError:
        return ""
    try:
        return raw.decode("utf-16-le").rstrip("\x00")
    except UnicodeDecodeError:
        return ""


def trial_entry():
    """a próba-indítás számlálós UKI-fájljának neve (LoaderBootCountPath), vagy None"""
    p = efivar("LoaderBootCountPath")
    if p:
        e = parse(p.replace("\\", "/").rsplit("/", 1)[-1])
        if e and e["trial"]:
            return e
    e = parse(efivar("LoaderEntrySelected"))
    return e if e and e["trial"] else None


def set_bootnext():
    """a következő indítás is a mostani UEFI-bejegyzésről (BootNext = BootCurrent) — ha a firmware
    alapértelmezése más rendszer (pl. a Mint), a próba-indítások így is a Fúzióba térnek vissza"""
    g = "8be4df61-93ca-11d2-aa0d-00e098032b8c"
    try:
        with open(f"{EFIVARS}/BootCurrent-{g}", "rb") as f:
            cur = f.read()[4:6]
        nxt = f"{EFIVARS}/BootNext-{g}"
        if os.path.exists(nxt):
            subprocess.run(["chattr", "-i", nxt], capture_output=True)
        with open(nxt, "wb", buffering=0) as f:
            f.write(b"\x07\x00\x00\x00" + cur)
        return True
    except OSError:
        return False


def run(cmd, check=True, **kw):
    r = subprocess.run(cmd, capture_output=True, text=True, **kw)
    if check and r.returncode != 0:
        raise UpdateError(f"{' '.join(cmd)}: {(r.stderr or r.stdout).strip()}")
    return r


def boot_disk():
    try:
        d = open("/run/fusion/boot-disk").read().strip()
    except OSError:
        d = ""
    if not d or d == "ismeretlen":
        raise UpdateError("a boot-lemez nem ismert (/run/fusion/boot-disk)")
    return "/dev/" + d


def partition(label):
    out = run(["lsblk", "-lnpo", "NAME,PARTLABEL", boot_disk()]).stdout
    for line in out.splitlines():
        p = line.split()
        if len(p) == 2 and p[1] == label:
            return p[0]
    raise UpdateError(f"nincs {label} partíció a boot-lemezen ({boot_disk()})")


def current_slot():
    try:
        return open("/run/fusion/slot").read().strip()
    except OSError:
        raise UpdateError("a futó slot nem ismert (/run/fusion/slot)")


def parse(name):
    m = UKI_RE.match(name or "")
    if not m:
        return None
    left = m.group("left")
    slot = m.group("slot").upper()
    return {"name": name, "slot": slot, "base": m.group("base"),
            "id": f"fusionos-{m.group('base')}-{slot}.efi", "key": f"fusionos-{m.group('base')}-{slot}.efi".lower(),
            "trial": left is not None, "left": int(left) if left is not None else None,
            "bad": left is not None and int(left) == 0}


class Esp:
    """az ESP csatolása (csak erre az időre); rw=True: írható"""
    def __init__(self, rw=False):
        self.rw = rw

    def __enter__(self):
        os.makedirs(ESP_MNT, exist_ok=True)
        # egyszerre csak egy folyamat csatolja (pl. boot-check és a Beállítások állapotlekérdezése)
        self.lock = open("/run/fusion/esp.lock", "w")
        fcntl.flock(self.lock, fcntl.LOCK_EX)
        if os.path.ismount(ESP_MNT):
            run(["umount", ESP_MNT], check=False)
        run(["mount", "-t", "vfat", "-o", ("rw" if self.rw else "ro") + ",nodev,nosuid,noexec,umask=0077",
             partition("FUSION_ESP"), ESP_MNT])
        return ESP_MNT

    def __exit__(self, *exc):
        if self.rw:
            syncfs(ESP_MNT)
        run(["umount", ESP_MNT], check=False)
        self.lock.close()


def ukis(esp):
    out = []
    for p in sorted(glob.glob(os.path.join(esp, "EFI", "Linux", "*.efi"))):
        e = parse(os.path.basename(p))
        if e:
            out.append(e)
    return out


def fsync_path(path):
    fd = os.open(path, os.O_RDONLY)
    try:
        os.fsync(fd)
    finally:
        os.close(fd)


# ---------------------------------------------------------------------------
def status():
    entry = efivar("LoaderEntrySelected")
    pe = parse(entry)
    try:
        state = open(STATE).read().strip()
    except OSError:
        state = ""
    d = {"slot": current_slot(), "entry": entry, "bootloader": efivar("LoaderInfo"), "state": state, "entries": []}
    if os.geteuid() == 0:
        with Esp() as esp:
            for e in ukis(esp):
                d["entries"].append({"slot": e["slot"], "name": e["name"], "version": e["base"].split("-")[0],
                                     "state": "bad" if e["bad"] else "trial" if e["trial"] else "ok",
                                     "left": e["left"], "running": bool(pe and pe["key"] == e["key"])})
            d["menu"] = sorted(os.path.basename(c)[:-5] for c in glob.glob(os.path.join(esp, "loader", "entries", "*.conf")))
        v = run(["efibootmgr"], check=False).stdout if os.path.isdir("/sys/firmware/efi") else ""
        d["firmware"] = [m.group(1).strip() for m in re.finditer(r"^Boot[0-9A-Fa-f]{4}\*?\s+([^\t]+)", v, re.M)
                         if m.group(1).startswith(("FusionOS", "Fuzio", FW_PREFIX) + OLD_FW_PREFIXES)]
    return d


def cmd_status(as_json=False):
    d = status()
    if as_json:
        print(json.dumps(d, ensure_ascii=False))
        return 0
    say(f"futó slot: {d['slot']}   elindított bejegyzés: {d['entry'] or '?'}")
    say(f"bootloader: {d['bootloader'] or '?'}")
    if d["state"]:
        say(f"állapot: {d['state']}")
    if os.geteuid() != 0:
        say("(a boot-bejegyzések listája: sudo /usr/lib/fusion/bin/fusion-admin update-status)")
    for e in d["entries"]:
        st = {"bad": "HIBÁS (nem indult el)", "trial": f"próba ({e['left']} lehetőség)", "ok": "véglegesített"}[e["state"]]
        say(f"  {e['slot']}: {e['name']}  [{st}]{'  ← fut' if e['running'] else ''}")
    if d.get("menu") is not None:
        say("  boot menü (systemd-boot) további bejegyzései: " + (", ".join(d["menu"]) or "nincs"))
    if d.get("firmware") is not None:
        say("  UEFI-bejegyzések (F9 menü): " + (", ".join(d["firmware"]) or "nincs"))
    return 0


# ---------------------------------------------------------------------------
class Source:
    """a frissítőcsomag: mappa vagy .fupd fájl (tömörítetlen tar: manifest, uki-A.efi, uki-B.efi, rootfs.erofs)"""
    def __init__(self, path):
        self.path = os.path.abspath(path)
        self.tar = None
        if os.path.isdir(self.path):
            return
        if not os.path.isfile(self.path):
            raise UpdateError(f"nem található: {self.path}")
        try:
            self.tar = tarfile.open(self.path, "r:")
        except (tarfile.TarError, OSError) as e:
            raise UpdateError(f"nem Fúzió-frissítőfájl ({e})")
        self.members = {os.path.basename(m.name): m for m in self.tar.getmembers() if m.isfile()}

    def open(self, name):
        if self.tar is None:
            try:
                return open(os.path.join(self.path, name), "rb")
            except OSError:
                raise UpdateError(f"hiányzik a csomagból: {name}")
        m = self.members.get(name)
        if m is None:
            raise UpdateError(f"hiányzik a csomagból: {name}")
        return self.tar.extractfile(m)


def read_manifest(src):
    with src.open("fusion-update.manifest") as f:
        lines = f.read().decode("utf-8", "replace").splitlines()
    meta, files = {}, {}
    for ln in lines:
        ln = ln.strip()
        if not ln or ln.startswith("#"):
            continue
        if "=" in ln and " " not in ln.split("=", 1)[0]:
            k, v = ln.split("=", 1)
            meta[k] = v.strip().strip("'\"")
        else:
            p = ln.split()
            if len(p) >= 3:
                files[p[0]] = (p[1], int(p[2]))
    for need in ("rootfs.erofs", "uki-A.efi", "uki-B.efi"):
        if need not in files:
            raise UpdateError(f"a manifestből hiányzik: {need}")
    return meta, files


def sha256(src, name, size, progress=False):
    h = hashlib.sha256()
    n, last = 0, -25
    with src.open(name) as f:
        while True:
            b = f.read(4 << 20)
            if not b:
                break
            h.update(b)
            n += len(b)
            if progress and size and n * 100 // size >= last + 25:
                last = n * 100 // size - (n * 100 // size) % 25
                say(f"  ellenőrzés {last}%")
    if n != size:
        raise UpdateError(f"{name}: a méret nem egyezik ({n} ≠ {size}) — sérült vagy hiányos csomag")
    return h.hexdigest()


def write_slot(src, size, want, part):
    psize = int(run(["blockdev", "--getsize64", part]).stdout.strip())
    if size > psize:
        raise UpdateError(f"a rendszerkép ({size >> 20} MiB) nem fér a slotba ({psize >> 20} MiB)")
    say(f"rendszerkép írása: {part} ({size >> 20} MiB)…")
    dev = os.path.basename(os.path.realpath(part))
    disk = os.path.basename(os.path.dirname(os.path.realpath(f"/sys/class/block/{dev}")))
    try:
        with src.open("rootfs.erofs") as s, open(part, "r+b", buffering=0) as dst:
            done, last = 0, -10
            while True:
                b = s.read(4 << 20)
                if not b:
                    break
                dst.write(b)
                done += len(b)
                # 32 MiB-onként a lemezre: a haladás valós, és nem gyűlik fel több száz MB a gyorsítótárban (egy lassú
                # pendrive-nál az a többi lemezműveletet is percekig visszatartaná); kihúzott lemez = azonnali hiba
                if done % (32 << 20) == 0:
                    os.fdatasync(dst.fileno())
                    if not os.path.exists(f"/sys/class/block/{dev}"):
                        raise OSError(5, "a lemez eltűnt")
                pct = done * 100 // size
                if pct >= last + 10:
                    last = pct - pct % 10
                    say(f"  írás {last}%")
            os.fsync(dst.fileno())
    except OSError as e:
        raise UpdateError(f"írási hiba: {part} ({e.strerror or e}) — a lemez nem válaszol: kihúzták, kilazult, vagy "
                          f"meghibásodott (a kernelnapló: „device offline” / „I/O error”). Másik USB-port vagy pendrive.")
    run(["blockdev", "--flushbufs", part], check=False)
    # visszaolvasás a lemezről (a gyorsítótár ürítése után), az ellenőrzőösszeg a manifestből
    with open("/proc/sys/vm/drop_caches", "w") as f:
        f.write("1")
    h = hashlib.sha256()
    with open(part, "rb") as b:
        left = size
        while left > 0:
            chunk = b.read(min(4 << 20, left))
            if not chunk:
                break
            h.update(chunk)
            left -= len(chunk)
    if h.hexdigest() != want:
        raise UpdateError(f"a slot tartalma eltér a rendszerképtől ({part}) — hibás lemez?")
    say("rendszerkép: ellenőrizve (visszaolvasás egyezik)")


def cmd_apply(path):
    src = Source(path)
    meta, files = read_manifest(src)
    ver = meta.get("FUSION_VERSION", "?")
    say(f"frissítőcsomag: Fúzió {ver} ({meta.get('FUSION_MILESTONE', '?')}) — {os.path.basename(src.path)}")
    try:
        blessed = open(STATE).read().startswith("VÉGLEGESÍTVE")
    except OSError:
        blessed = False
    if trial_entry() and not blessed:
        raise UpdateError("a mostani indítás még próba (az előző frissítés ellenőrzése nem fejeződött be) — várjon pár percet, vagy indítsa újra")
    cur = current_slot()
    target = "B" if cur == "A" else "A"
    part = partition(f"FUSION_{target}")
    m = re.match(r"^fusionos-(.+)-[AB]\.efi$", meta.get(f"UKI_{target}", ""))
    if not m:
        raise UpdateError(f"a manifestből hiányzik az UKI_{target} név")
    newname = f"fusionos-{m.group(1)}-{target}"
    newstamp = m.group(1).rsplit("-", 1)[-1]
    with Esp() as esp:
        # a régi (bélyeg nélküli, pl. 0.0.23) neveket nem számítjuk: azok mindig régebbiek
        others = [e["base"].rsplit("-", 1)[-1] for e in ukis(esp) if e["slot"] != target and not e["bad"]]
    if any(o.isdigit() and o >= newstamp for o in others):
        raise UpdateError("ez a csomag nem újabb a lemezen lévő (futó) rendszernél — a systemd-boot nem indítaná el. "
                          "Újabb buildet kell telepíteni.")
    say("ellenőrzőösszegek (SHA-256)…")
    for name, (want, size) in files.items():
        if sha256(src, name, size, progress=name == "rootfs.erofs") != want:
            raise UpdateError(f"{name}: az ellenőrzőösszeg nem egyezik — sérült csomag")
    say(f"a futó rendszer: {cur} slot — a frissítés a(z) {target} slotba kerül ({part})")
    uki = f"uki-{target}.efi"
    with Esp(rw=True) as esp:
        # 1. a cél-slot régi bejegyzései törlődnek ELŐBB (a félig írt slotra ne mutasson semmi)
        for e in ukis(esp):
            if e["slot"] == target:
                os.unlink(os.path.join(esp, "EFI", "Linux", e["name"]))
                say(f"régi bejegyzés törölve: {e['name']}")
        syncfs(esp)
        free = os.statvfs(esp)
        if free.f_bavail * free.f_frsize < files[uki][1] + (4 << 20):
            raise UpdateError("nincs elég hely az ESP-n")
    # 2. a rendszerkép (az ESP közben nincs csatolva — egy megszakadás csak a cél-slotot érinti)
    write_slot(src, files["rootfs.erofs"][1], files["rootfs.erofs"][0], part)
    # 3. az új bejegyzés: ideiglenes néven, majd átnevezve, próba-számlálóval
    with Esp(rw=True) as esp:
        lin = os.path.join(esp, "EFI", "Linux")
        tmp = os.path.join(lin, "fusion-update.tmp")
        with src.open(uki) as s, open(tmp, "wb") as t:
            while True:
                b = s.read(1 << 20)
                if not b:
                    break
                t.write(b)
            t.flush()
            os.fsync(t.fileno())
        final = os.path.join(lin, f"{newname}+{TRIES}.efi")
        os.rename(tmp, final)
        fsync_path(lin)
        say(f"új bejegyzés: {os.path.basename(final)} ({TRIES} indítási próba)")
        # 4. az új verzió mérési / tartalék boot-bejegyzései közül a hiányzók (pl. 0.0.30: Intel, Nouveau) — a meglévők
        #    maradnak; a véglegesítéskor a fix_entries a végleges UKI-ra állítja őket
        if "esp-static.tar" in files:
            added = add_missing_entries(src, esp, os.path.basename(final))
            if added:
                say("új boot-bejegyzés: " + ", ".join(added))
    say(f"KÉSZ: Fúzió {ver} a(z) {target} slotban. Újraindítás után próbaként indul; ha rendben elindul,")
    say(f"véglegessé válik — ha {TRIES}× nem, magától a mostani ({cur}) rendszer indul.")
    return 0


def cmd_reboot():
    """újraindítás úgy, hogy a következő indítás is a Fúzió legyen (a firmware alapértelmezése lehet a Mint)"""
    set_bootnext()
    os.execvp("systemctl", ["systemctl", "reboot"])


# ---------------------------------------------------------------------------
def desktop_expected():
    cmd = open("/proc/cmdline").read().split()
    if "fusion.desktop=0" in cmd:
        return False
    return os.path.exists("/etc/systemd/system/getty@tty1.service.d/fusion-autologin.conf")


MEASURE_FILE = "/usr/lib/fusion/boot/measure-entries"
FW_PREFIX = "Fuzio meres - "
OLD_FW_PREFIXES = ("Fusion meres - ",)     # 0.0.51-ig: induláskor új névvel cserélődnek


def measure_defs():
    """a mérési / tartalék boot-bejegyzések: [(id, cím, kiegészítés, UEFI-név)]"""
    out = []
    try:
        for ln in open(MEASURE_FILE, encoding="utf-8"):
            ln = ln.rstrip("\n")
            if not ln.strip() or ln.lstrip().startswith("#"):
                continue
            p = (ln.split("|") + ["", "", "", ""])[:4]
            if re.match(r"^[A-Za-z0-9._-]+$", p[0]):
                out.append(tuple(x.strip() for x in p))
    except OSError:
        pass
    return out


def uki_cmdline(path):
    """a UKI beépített parancssora (a PE-fájl .cmdline szakasza)"""
    import struct
    with open(path, "rb") as f:
        head = f.read(4096)
        pe = struct.unpack_from("<I", head, 0x3C)[0]
        f.seek(pe)
        h = f.read(24)
        if h[:4] != b"PE\0\0":
            raise UpdateError(f"nem PE-fájl: {path}")
        nsec, optsz = struct.unpack_from("<H", h, 6)[0], struct.unpack_from("<H", h, 20)[0]
        f.seek(pe + 24 + optsz)
        for _ in range(nsec):
            sec = f.read(40)
            if sec[:8].rstrip(b"\0") == b".cmdline":
                vsize, _va, rsize, raw = struct.unpack_from("<IIII", sec, 8)
                f.seek(raw)
                return f.read(min(vsize, rsize) if vsize else rsize).rstrip(b"\0").decode("utf-8", "replace").strip()
    raise UpdateError(f"a UKI-ban nincs .cmdline: {path}")


def maintain_entries():
    """normál indítás után: (1) a lemezen hiányzó mérési bejegyzések pótlása a rendszerkép listájából (egy régebbi
    rendszer frissítője nem ismeri az újakat); (2) a UEFI-bejegyzések (F9 menü) a megjelölt mérési bejegyzésekhez —
    csak akkor ír, ha valami változott; a boot-sorrend elejéhez nem nyúl"""
    defs = measure_defs()
    if not defs:
        return
    slot = current_slot()
    with Esp() as esp:
        mine = [e for e in ukis(esp) if e["slot"] == slot and not e["trial"]]
        if not mine:
            return
        uki = mine[-1]["name"]
        edir = os.path.join(esp, "loader", "entries")
        missing = [d for d in defs if not os.path.exists(os.path.join(edir, d[0] + ".conf"))]
        base = uki_cmdline(os.path.join(esp, "EFI", "Linux", uki)) if missing else ""
    if missing:
        with Esp(rw=True) as esp:
            edir = os.path.join(esp, "loader", "entries")
            os.makedirs(edir, exist_ok=True)
            for i, t, x, _fw in missing:
                dst = os.path.join(edir, i + ".conf")
                with open(dst + ".tmp", "w", encoding="utf-8") as o:
                    o.write(f"title {t}\nsort-key zz-{i}\nefi /EFI/Linux/{uki}\noptions {base} {x}\n")
                    o.flush()
                    os.fsync(o.fileno())
                os.replace(dst + ".tmp", dst)
            fsync_path(edir)
        say("boot-bejegyzés pótolva: " + ", ".join(d[0] for d in missing))
    want = []
    with Esp() as esp:
        for i, _t, _x, fw in defs:
            if not fw:
                continue
            try:
                txt = open(os.path.join(esp, "loader", "entries", i + ".conf"), encoding="utf-8").read()
            except OSError:
                continue
            efi = re.search(r"(?m)^efi\s+(\S+)$", txt)
            opt = re.search(r"(?m)^options\s+(.*)$", txt)
            if efi and os.path.exists(os.path.join(esp, efi.group(1).lstrip("/"))):
                want.append((fw, efi.group(1).replace("/", "\\"), opt.group(1).strip() if opt else ""))
    firmware_entries(want)


def firmware_entries(want):
    """UEFI-bejegyzések „Fuzio meres - …” néven: a systemd-boot nélkül, közvetlenül a UKI-t indítják a
    kiegészített parancssorral (Secure Boot nélkül a systemd-stub a betöltési paramétereket használja)"""
    if not os.path.isdir("/sys/firmware/efi") or subprocess.run(["sh", "-c", "command -v efibootmgr"],
                                                                 capture_output=True).returncode:
        return
    disk = boot_disk()
    dname = os.path.basename(disk)
    try:
        if open(f"/sys/block/{dname}/removable").read().strip() == "1" or \
                run(["lsblk", "-dno", "TRAN", disk], check=False).stdout.strip() == "usb":
            return          # pendrive-ról futva nem írunk a gép UEFI-listájába
    except OSError:
        pass
    puuid = run(["lsblk", "-no", "PARTUUID", partition("FUSION_ESP")], check=False).stdout.strip().lower()
    v = run(["efibootmgr", "-v"], check=False).stdout
    order = re.search(r"^BootOrder:\s*(\S+)", v, re.M)
    order = order.group(1).split(",") if order else []
    have = {}
    for m in re.finditer(r"^Boot([0-9A-Fa-f]{4})\*?\s+((?:" + "|".join(map(re.escape, (FW_PREFIX,) + OLD_FW_PREFIXES)) + r")[^\t]*?)\s*(?:\t(.*))?$", v, re.M):
        have.setdefault(m.group(2).strip(), []).append((m.group(1), (m.group(3) or "").lower()))
    changed = []
    wanted = {w[0] for w in want}
    for label, lst in have.items():          # már nem kért bejegyzések
        if label not in wanted:
            for num, _ in lst:
                run(["efibootmgr", "-q", "-b", num, "-B"], check=False)
                order = [o for o in order if o.upper() != num.upper()]
                changed.append(f"törölve: {label}")
    for label, path, opts in want:
        cur = have.get(label, [])
        if len(cur) == 1 and path.lower() in cur[0][1] and (not puuid or puuid in cur[0][1]):
            continue
        for num, _ in cur:
            run(["efibootmgr", "-q", "-b", num, "-B"], check=False)
            order = [o for o in order if o.upper() != num.upper()]
        r = run(["efibootmgr", "-q", "-c", "-d", disk, "-p", "1", "-L", label, "-l", path, "-u", opts], check=False)
        if r.returncode != 0:
            say(f"figyelmeztetés: a UEFI-bejegyzés nem hozható létre ({label}): {(r.stderr or r.stdout).strip()[:200]}")
            continue
        changed.append(label)
    if not changed:
        return
    # a boot-sorrend: a korábbi változatlanul elöl, az új bejegyzések a végén (az F9 menüben választhatók)
    v2 = run(["efibootmgr"], check=False).stdout
    nums = [m.group(1) for m in re.finditer(r"^Boot([0-9A-Fa-f]{4})\*?\s+" + re.escape(FW_PREFIX), v2, re.M)]
    new_order = [o for o in order if o.upper() not in {n.upper() for n in nums}] + nums
    run(["efibootmgr", "-q", "-o", ",".join(new_order)], check=False)
    say("UEFI-bejegyzés (F9 menü): " + ", ".join(changed))


def add_missing_entries(src, esp, uki_name):
    """a csomag esp-static.tar-jából a loader/entries/*.conf-ok közül a lemezen még nem létezők"""
    added = []
    try:
        with src.open("esp-static.tar") as f, tarfile.open(fileobj=f, mode="r|") as t:
            for m in t:
                name = m.name[2:] if m.name.startswith("./") else m.name
                mm = re.match(r"^loader/entries/([A-Za-z0-9._-]+\.conf)$", name)
                if not (m.isfile() and mm):
                    continue
                dst = os.path.join(esp, "loader", "entries", mm.group(1))
                if os.path.exists(dst):
                    continue
                txt = t.extractfile(m).read().decode("utf-8", "replace")
                txt = re.sub(r"(?m)^efi\s+/EFI/Linux/fusionos-[^\s]+\.efi$", f"efi /EFI/Linux/{uki_name}", txt)
                os.makedirs(os.path.dirname(dst), exist_ok=True)
                with open(dst + ".tmp", "w", encoding="utf-8") as o:
                    o.write(txt)
                    o.flush()
                    os.fsync(o.fileno())
                os.replace(dst + ".tmp", dst)
                added.append(mm.group(1)[:-5])
        if added:
            fsync_path(os.path.join(esp, "loader", "entries"))
    except (tarfile.TarError, OSError, UpdateError) as e:
        say(f"figyelmeztetés: a boot-bejegyzések bővítése nem sikerült: {e}")
    return added


def fix_entries(esp, blessed, slot):
    """a mérési / tartalék boot-bejegyzések (loader/entries) a véglegesített UKI-ra mutassanak"""
    changed = 0
    for conf in glob.glob(os.path.join(esp, "loader", "entries", "*.conf")):
        try:
            txt = open(conf, encoding="utf-8").read()
        except OSError:
            continue
        new = re.sub(r"(?m)^efi\s+/EFI/Linux/fusionos-[^\s]+\.efi$", f"efi /EFI/Linux/{blessed}", txt)
        new = re.sub(r"fusion\.slot=[AB]", f"fusion.slot={slot}", new)
        if new != txt:
            with open(conf + ".tmp", "w", encoding="utf-8") as f:
                f.write(new)
            os.replace(conf + ".tmp", conf)
            changed += 1
    return changed


def checks():
    """(rendben?, leírás)"""
    r = subprocess.run(["systemctl", "is-system-running", "--wait"], capture_output=True, text=True)
    sysstate = r.stdout.strip()
    if sysstate not in ("running", "degraded"):
        return False, f"a rendszer állapota: {sysstate}"
    try:
        t = "/data/.fusion-boot-check"
        with open(t, "w") as f:
            f.write(str(time.time()))
        os.unlink(t)
    except OSError as e:
        return False, f"a DATA nem írható ({e.strerror})"
    if desktop_expected():
        end = time.time() + DESKTOP_WAIT
        while time.time() < end and not os.path.exists("/run/user/1000/fusion-shell.ready"):
            time.sleep(2)
        if not os.path.exists("/run/user/1000/fusion-shell.ready"):
            return False, f"a Fúzió Desktop {DESKTOP_WAIT} mp alatt nem indult el"
    return True, f"rendben (rendszer: {sysstate}{', felület fut' if desktop_expected() else ''})"


NOTICE = "/run/fusion/boot-notice"
NOTICED = "/var/lib/fusion/boot-notices"


def noticed(name):
    try:
        return name in open(NOTICED).read().split()
    except OSError:
        return False


def notice(title, body, remember=""):
    """üzenet a felhasználónak (a munkamenet indulásakor a fusion-boot-notice értesítésként mutatja)"""
    with open(NOTICE, "w") as f:
        f.write(title + "\n" + body + "\n")
    if remember:
        os.makedirs(os.path.dirname(NOTICED), exist_ok=True)
        with open(NOTICED, "a") as f:
            f.write(remember + "\n")


def set_state(s):
    os.makedirs(os.path.dirname(STATE), exist_ok=True)
    with open(STATE, "w") as f:
        f.write(s + "\n")
    say(s)


def safe_maintain():
    try:
        maintain_entries()
    except (UpdateError, OSError, ValueError) as e:
        say(f"figyelmeztetés: a boot-bejegyzések karbantartása nem sikerült: {e}")


def cmd_boot_check():
    entry = efivar("LoaderEntrySelected")
    te = trial_entry()
    pe = te or parse(entry)
    slot = current_slot()
    if not pe:
        set_state(f"ok: nem Fúzió-bejegyzés ({entry or 'ismeretlen'}), slot {slot}")
        safe_maintain()
        return 0
    if not pe["trial"]:
        # normál indítás: a tartalék bejegyzések javítása, ha egy frissítés után elavultak
        try:
            with Esp() as esp:
                pe = next((e for e in ukis(esp) if e["key"] == pe["key"]), pe)   # a valódi fájlnév
                # visszaállás után: egy újabb, de hibás (el nem indult) bejegyzés — egyszer szólunk róla
                mystamp = pe["base"].rsplit("-", 1)[-1]
                for e in ukis(esp):
                    st = e["base"].rsplit("-", 1)[-1]
                    if e["bad"] and st.isdigit() and (not mystamp.isdigit() or st > mystamp) and not noticed(e["name"]):
                        notice("A frissítés nem indult el",
                               f"A Fúzió {e['base'].split('-')[0]} {TRIES} próbálkozásra sem indult el, ezért a korábbi "
                               f"rendszer ({pe['base'].split('-')[0]}) fut. Részletek: Beállítások → Rendszerfrissítés.",
                               e["name"])
                stale = any(not os.path.exists(os.path.join(esp, l.split()[1].lstrip("/")))
                            for c in glob.glob(os.path.join(esp, "loader", "entries", "*.conf"))
                            for l in open(c, encoding="utf-8") if l.startswith("efi "))
            if stale:
                with Esp(rw=True) as esp:
                    fix_entries(esp, pe["name"], slot)
        except (UpdateError, OSError) as e:
            say(f"figyelmeztetés: a boot-bejegyzések ellenőrzése nem sikerült: {e}")
        set_state(f"ok: véglegesített rendszer ({pe['name']}), slot {slot}")
        safe_maintain()
        return 0
    entry = pe["name"]
    say(f"próba-indítás: {entry} (slot {slot}) — ellenőrzés…")
    ok, why = checks()
    if not ok:
        set_state(f"HIBA: {why} — újraindítás (a próba elhasználva; {TRIES} sikertelen után a korábbi rendszer indul)")
        set_bootnext()
        subprocess.run(["systemctl", "reboot"])
        return 1
    with Esp(rw=True) as esp:
        src = os.path.join(esp, "EFI", "Linux", entry)
        dst = os.path.join(esp, "EFI", "Linux", pe["id"])
        if not os.path.exists(src):
            # a változó a számláló léptetése előtti nevet is tartalmazhatja: a mostani fájl az azonos azonosítójú
            cand = [e for e in ukis(esp) if e["key"] == pe["key"] and e["trial"]]
            if not cand:
                raise UpdateError(f"a bejegyzés nem található az ESP-n: {entry}")
            src = os.path.join(esp, "EFI", "Linux", cand[0]["name"])
        real = parse(os.path.basename(src))
        dst = os.path.join(esp, "EFI", "Linux", real["id"])
        os.rename(src, dst)
        fsync_path(os.path.dirname(dst))
        pe = real
        n = fix_entries(esp, pe["id"], slot)
    set_state(f"VÉGLEGESÍTVE: {pe['id']} (slot {slot}) — {why}" + (f"; {n} tartalék bejegyzés frissítve" if n else ""))
    notice("Rendszerfrissítés kész", f"A Fúzió {pe['base'].split('-')[0]} rendben elindult, és véglegessé vált "
           f"(slot {slot}). A korábbi rendszer tartaléknak megmaradt.")
    safe_maintain()
    # egyirányú DATA-átalakítások csak ezután (a visszaállított régi rendszer is értse a DATA-t)
    for h in sorted(glob.glob(os.path.join(HOOKS, "*"))):
        if os.access(h, os.X_OK):
            r = subprocess.run([h], capture_output=True, text=True)
            say(f"boot-ok.d/{os.path.basename(h)}: {'ok' if r.returncode == 0 else 'HIBA ' + r.stderr.strip()[:200]}")
    return 0


def main(a):
    cmd = a[0] if a else "status"
    if cmd in ("-h", "--help", "help"):
        say(__doc__.strip())
        return 0
    if os.geteuid() != 0 and cmd != "status":
        raise UpdateError("root kell hozzá")
    if cmd == "status":
        return cmd_status("--json" in a)
    if cmd == "apply" and len(a) == 2:
        return cmd_apply(a[1])
    if cmd == "boot-check":
        return cmd_boot_check()
    if cmd == "reboot":
        return cmd_reboot()
    say(__doc__.strip())
    return 2


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except UpdateError as e:
        print("fusion-update: " + str(e), file=sys.stderr, flush=True)
        sys.exit(1)
