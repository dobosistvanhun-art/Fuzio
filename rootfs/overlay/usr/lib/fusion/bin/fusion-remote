#!/usr/bin/python3
"""Fúzió — távoli elérés (root; a fusion-admin `remote` parancsa hívja, csak rendszergazdának)

    fusion-remote status [--json]        a Tailscale, az SSH és az ébren tartás állapota
    fusion-remote tailscale on           a Tailscale indítása; ha még nincs bejelentkezve, a bejelentkező cím
    fusion-remote tailscale off          leállítás (a bejelentkezés megmarad)
    fusion-remote tailscale logout       kijelentkezés (a gép kikerül a Tailscale-hálózatból)
    fusion-remote ssh on|off             SSH-szerver (csak kulccsal, csak a Tailscale-hálózat felől:
                                         /etc/ssh/sshd_config.d/fusion.conf)
    fusion-remote awake on|off           a gép ne aludjon el (fusion-remote-awake.service)

A képernyő megosztása (x11vnc) a felhasználó saját szolgáltatása (systemctl --user fusion-vnc), ahhoz nem
kell root. A Tailscale állapota a /var/lib/tailscale alatt (DATA) marad meg; minden alapból ki van kapcsolva.
"""
import json
import os
import socket
import subprocess
import sys
import time

TS = "/usr/bin/tailscale"
TSD = "/usr/sbin/tailscaled"


def run(cmd, timeout=30):
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout, errors="replace")
        return r.returncode, (r.stdout or "") + (r.stderr or "")
    except (OSError, subprocess.TimeoutExpired) as e:
        return 127, str(e)


def fail(msg):
    print(f"fusion-remote: {msg}", file=sys.stderr)
    sys.exit(1)


def unit_state(unit):
    _, act = run(["systemctl", "is-active", unit], 10)
    _, ena = run(["systemctl", "is-enabled", unit], 10)
    return act.strip().splitlines()[-1:] == ["active"], ena.strip().splitlines()[-1:] == ["enabled"]


def hostname():
    # a Tailscale-hálózatban ezen a néven látszik (kisbetű, betű/szám/kötőjel)
    h = "".join(c if c.isalnum() or c == "-" else "-" for c in socket.gethostname().lower()).strip("-")
    return h or "fuzio"


def ts_status():
    """a Tailscale állapota (tailscale status --json), a felület számára egyszerűsítve"""
    d = {"installed": os.access(TS, os.X_OK) and os.access(TSD, os.X_OK), "active": False, "enabled": False,
         "state": "", "ip": "", "ip6": "", "name": "", "dns": "", "authUrl": "", "peers": [], "error": ""}
    if not d["installed"]:
        d["error"] = "a Tailscale nincs a rendszerképben"
        return d
    d["active"], d["enabled"] = unit_state("tailscaled.service")
    if not d["active"]:
        d["state"] = "Off"
        return d
    rc, out = run([TS, "status", "--json"], 15)
    try:
        s = json.loads(out[out.index("{"):])
    except ValueError:
        d["state"], d["error"] = "Starting", (out.strip().splitlines() or [""])[-1]
        return d
    d["state"] = s.get("BackendState", "")
    d["authUrl"] = s.get("AuthURL", "") or ""
    me = s.get("Self") or {}
    ips = me.get("TailscaleIPs") or []
    d["ip"] = next((i for i in ips if "." in i), "")
    d["ip6"] = next((i for i in ips if ":" in i), "")
    d["name"] = me.get("HostName", "")
    d["dns"] = (me.get("DNSName") or "").rstrip(".")
    for p in (s.get("Peer") or {}).values():
        pips = p.get("TailscaleIPs") or []
        d["peers"].append({"name": p.get("HostName", ""), "dns": (p.get("DNSName") or "").rstrip("."),
                           "os": p.get("OS", ""), "online": bool(p.get("Online")),
                           "ip": next((i for i in pips if "." in i), "")})
    d["peers"].sort(key=lambda p: (not p["online"], p["name"].lower()))
    return d


def ssh_status():
    active, enabled = unit_state("ssh.service")
    keys = all(os.path.exists(f"/etc/ssh/ssh_host_{t}_key") for t in ("ed25519", "rsa"))
    return {"installed": os.access("/usr/sbin/sshd", os.X_OK), "active": active, "enabled": enabled, "hostKeys": keys}


def status():
    active, enabled = unit_state("fusion-remote-awake.service")
    return {"tailscale": ts_status(), "ssh": ssh_status(), "awake": {"active": active, "enabled": enabled},
            "hostname": hostname()}


def tailscale_on():
    rc, out = run(["systemctl", "enable", "--now", "tailscaled.service"], 60)
    if rc != 0:
        fail("a tailscaled nem indult: " + (out.strip().splitlines() or [""])[-1])
    for _ in range(40):                   # a tailscaled feláll (a socket megjelenik)
        if os.path.exists("/run/tailscale/tailscaled.sock"):
            break
        time.sleep(0.25)
    # a „tailscale up” bejelentkezésig vár: a háttérben fut, a bejelentkező cím a status-ban jelenik meg.
    # A tűzfal-szabályokat (iptables/nftables) nem kérjük: a Fúzió csak a saját gépét éri el, útválasztás nincs.
    subprocess.Popen([TS, "up", f"--hostname={hostname()}", "--netfilter-mode=off", "--timeout=600s"],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                     start_new_session=True)
    for _ in range(60):
        d = ts_status()
        if d["state"] == "Running" or d["authUrl"]:
            break
        time.sleep(0.25)
    print(json.dumps(ts_status(), ensure_ascii=False))


def tailscale_off():
    if unit_state("tailscaled.service")[0]:
        run([TS, "down"], 20)
    rc, out = run(["systemctl", "disable", "--now", "tailscaled.service"], 60)
    if rc != 0:
        fail("a tailscaled nem állt le: " + (out.strip().splitlines() or [""])[-1])
    print("kész: a Tailscale kikapcsolva")


def tailscale_logout():
    if not unit_state("tailscaled.service")[0]:
        run(["systemctl", "start", "tailscaled.service"], 60)
        time.sleep(1)
    rc, out = run([TS, "logout"], 30)
    if rc != 0:
        fail("a kijelentkezés nem sikerült: " + (out.strip().splitlines() or [""])[-1])
    print("kész: kijelentkezve a Tailscale-ből")


def ssh(on):
    if on:
        # saját gépkulcsok az első bekapcsoláskor (a rendszerképben nincsenek)
        rc, out = run(["ssh-keygen", "-A"], 60)
        if rc != 0:
            fail("a gépkulcsok nem készültek el: " + out.strip())
        rc, out = run(["/usr/sbin/sshd", "-t"], 20)
        if rc != 0:
            fail("hibás SSH-beállítás: " + out.strip())
        # az Ubuntu socket-aktiválása helyett maga a szolgáltatás (a beállítás így biztosan érvényes)
        run(["systemctl", "disable", "--now", "ssh.socket"], 30)
        rc, out = run(["systemctl", "enable", "--now", "ssh.service"], 60)
        if rc != 0:
            fail("az SSH-szerver nem indult: " + (out.strip().splitlines() or [""])[-1])
        print("kész: az SSH-szerver bekapcsolva (csak kulccsal, csak a Tailscale-hálózat felől)")
    else:
        run(["systemctl", "disable", "--now", "ssh.socket"], 30)
        rc, out = run(["systemctl", "disable", "--now", "ssh.service"], 60)
        if rc != 0:
            fail("az SSH-szerver nem állt le: " + (out.strip().splitlines() or [""])[-1])
        print("kész: az SSH-szerver kikapcsolva")


def awake(on):
    rc, out = run(["systemctl", "enable" if on else "disable", "--now", "fusion-remote-awake.service"], 30)
    if rc != 0:
        fail("nem sikerült: " + (out.strip().splitlines() or [""])[-1])
    print("kész: a gép " + ("ébren marad" if on else "a szokásos módon alszik el"))


def main(a):
    if os.geteuid() != 0:
        fail("rootként kell futnia (sudo -n fusion-admin remote …)")
    if a[:1] == ["status"] and len(a) <= 2:
        s = status()
        if a[1:] == ["--json"]:
            print(json.dumps(s, ensure_ascii=False))
        else:
            t = s["tailscale"]
            print(f"Tailscale: {t['state'] or '-'} {t['ip']} {t['dns']}".rstrip())
            print(f"SSH: {'be' if s['ssh']['active'] else 'ki'}   ébren tartás: {'be' if s['awake']['active'] else 'ki'}")
        return
    if len(a) == 2 and a[0] == "tailscale" and a[1] in ("on", "off", "logout"):
        {"on": tailscale_on, "off": tailscale_off, "logout": tailscale_logout}[a[1]]()
        return
    if len(a) == 2 and a[0] in ("ssh", "awake") and a[1] in ("on", "off"):
        (ssh if a[0] == "ssh" else awake)(a[1] == "on")
        return
    fail("használat: status [--json] | tailscale on|off|logout | ssh on|off | awake on|off")


if __name__ == "__main__":
    main(sys.argv[1:])
