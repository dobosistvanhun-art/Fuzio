#!/bin/sh
# FusionOS — a munkamenet indulásakor: a rendszerfrissítés eredménye értesítésként (egyszer indításonként).
# A fusion-boot-check (root) írja a /run/fusion/boot-notice-ot: véglegesítés vagy visszaállás után.
n=/run/fusion/boot-notice
shown="${XDG_RUNTIME_DIR:-/tmp}/fusion-boot-notice.shown"
[ -e "$shown" ] && exit 0
sleep 6      # a Fusion Shell (az értesítések fogadója) elinduljon
i=0
# a próba-indítás véglegesítése a felület megjelenése után történik — legfeljebb ~6 percig várunk rá
while [ $i -lt 180 ]; do
    if [ -s "$n" ]; then break; fi
    case "$(cat /run/fusion/boot-state 2>/dev/null)" in ok:*|HIBA:*) [ $i -ge 5 ] && exit 0 ;; esac
    sleep 2; i=$((i + 1))
done
[ -s "$n" ] || exit 0
touch "$shown"
fusion-notify -i update -a "Rendszerfrissítés" "$(sed -n 1p "$n")" "$(sed -n 2p "$n")"
