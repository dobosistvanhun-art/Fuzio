    urun fusion-drive logout; sleep 1
    echo "FUSION-DRIVE: LOGOUT mounted=$(grep -c ' /home/fusion/GoogleDrive ' /proc/self/mounts) conf=$([ -e /home/fusion/.config/fusion/rclone.conf ] && echo van || echo nincs) enabled=$(urun systemctl --user is-enabled fusion-drive.service 2>/dev/null)"
    # fejlesztői eszközök: Node.js-telepítés a DATA-ra egy helyi „ál-tükörről” (letöltés, ellenőrzőösszeg,
    # kicsomagolás, PATH a munkamenetben), npm globális csomag a saját mappába, eltávolítás
    m=/tmp/fusion-fakenode; rm -rf "$m"; mkdir -p "$m/v22.99.0" "$m/b/node-v22.99.0-linux-x64/bin"
