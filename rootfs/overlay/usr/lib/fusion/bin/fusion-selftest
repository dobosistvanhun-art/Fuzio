# automatikus csatolás (cserélhető kötetek) — a teszt USB-meghajtója: FUSIONUSB (vfat), FUSIONEXF (exfat), FUSIONNTFS (ntfs)
i=0; while [ $i -lt 20 ] && ! ls /run/media/FUSION* >/dev/null 2>&1 && ls /dev/disk/by-label/FUSIONUSB >/dev/null 2>&1; do sleep 1; i=$((i + 1)); done
for m in $(ls -d /run/media/* 2>/dev/null); do
    echo "FUSION-M6: MEDIA $(basename "$m") fs=$(findmnt -no FSTYPE "$m") uid=$(stat -c %u "$m") file=$(cat "$m/fusion-usb.txt" 2>/dev/null || echo -) write=$(runuser -u fusion -- sh -c "echo ok > '$m/fusion-write.txt' && cat '$m/fusion-write.txt'" 2>/dev/null || echo no)"
done
ls -d /run/media/* >/dev/null 2>&1 || echo "FUSION-M6: MEDIA none"
# a rendszer saját kötetei nem csatolhatók / adhatók ki a segéddel (a sudo szabály a fusion felhasználóé)
dpart=$(blkid -t PARTLABEL=FUSION_DATA -o device 2>/dev/null | head -n 1)
g=$(runuser -u fusion -- sudo -n /usr/lib/fusion/bin/fusion-admin mount "$dpart" 2>&1); grc=$?
echo "FUSION-M6: GUARD rc=$grc $(printf '%s' "$g" | head -n 1)"
usbdev=$(blkid -t LABEL=FUSIONUSB -o device 2>/dev/null | head -n 1)
if [ -n "$usbdev" ]; then
    e=$(runuser -u fusion -- sudo -n /usr/lib/fusion/bin/fusion-admin eject "$usbdev" 2>&1); erc=$?
    echo "FUSION-M6: EJECT rc=$erc left=$(ls /run/media 2>/dev/null | tr '\n' ' ')$(printf '%s' "$e" | tail -n 1)"
    sleep 3
    echo "FUSION-M6: SHELL-MEDIA $(sed -n 's/.*"media": \[\(.*\)\].*/\1/p' /run/user/1000/fusion-shell.state 2>/dev/null | tr -d ' \n')"
fi
echo "FUSION-M1: POWEROFF"
systemctl poweroff --no-block
