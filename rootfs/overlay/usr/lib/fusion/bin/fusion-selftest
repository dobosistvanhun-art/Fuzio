    f=$(urun sudo -n /usr/lib/fusion/bin/fusion-admin boot first "$cur" 2>&1 | tail -n 1)
    d=$(urun sudo -n /usr/lib/fusion/bin/fusion-admin boot delete "$num" "Proba arva" 2>&1 | tail -n 1)
    echo "FUSION-BOOT: WRONG=${w#*: } | CURRENT=${c#*: } | FIRST=$f | DELETE=$d | LEFT=$(efibootmgr | grep -c 'Proba arva') ORDER1=$(efibootmgr | sed -n 's/^BootOrder: *\([0-9A-F]*\).*/\1/p')=$cur"
