apir=$(python3 -c "import fusion.hardware as h; print(h.summary())" 2>&1 | tail -n 1)
echo "FUSION-API: USER $api ROOT $apir"
echo "FUSION-API: NOTIFY $(urun fusion-notify -u low -i settings "Fusion API" "értesítés a fusion.notify-on át" && echo ok || echo HIBA)"
# M8b: a `fusion` parancssor — minden lekérdezés JSON-kimenete a leírás (docs/api/cli.md) szerinti kulcsokkal
urun sh -c 'for c in "api-version" "system" "hardware" "devices" "volumes" "power" "jobs" "schema" "programs list"; do
    printf "%s\t" "$c"; fusion $c --json 2>&1 | tr -d "\n"; echo; done' > /tmp/fusion-cli.txt
python3 - /tmp/fusion-cli.txt <<'PYEOF'
import json, sys
need = {"api-version": {"api"}, "system": {"api", "version", "milestone", "base", "kernel", "slot", "bootState", "display", "render"},
        "hardware": {"profile", "status", "driverState", "adapterCount"}, "devices": {"role", "name", "present", "dev", "key", "programs", "com"},
        "volumes": {"kind", "name", "path", "fstype", "size", "free"}, "power": {"ac", "batteries"}, "jobs": {"name", "title", "running", "rc", "step", "progress", "lines"},
        "schema": {"version", "program", "role"}, "programs list": {"id", "name", "type"}}
res = []
for line in open(sys.argv[1], encoding="utf-8"):
    c, _, out = line.rstrip("\n").partition("\t")
    try:
        j = json.loads(out)
        items = j if isinstance(j, list) else [j]
        bad = [sorted(need[c] - set(x)) for x in items if need[c] - set(x)]
        res.append(f"{c}={'ok' if not bad else 'hiányzik:' + str(bad[0])}")
    except ValueError:
        res.append(f"{c}=nem-JSON:{out[:60]}")
print("FUSION-CLI: JSON " + " ".join(res))
PYEOF
echo "FUSION-CLI: VERSION $(urun fusion system --json | python3 -c 'import json,sys; j=json.load(sys.stdin); print(j["version"], j["api"], j["display"]["profile"])')"
echo "FUSION-CLI: VALIDATE $(urun fusion validate /usr/lib/fusion/fwr/profiles/*.fwr /usr/lib/fusion/devices/roles/*.role >/dev/null 2>&1 && echo ok || echo HIBA) rc-hibas=$(printf 'id = Rossz\n' > /tmp/rossz.fusion; urun fusion validate /tmp/rossz.fusion >/dev/null 2>&1; echo $?)"
# 0.0.38: Lomtár automatikus ürítése (a beállítás szerint) — egy 40 napos és egy friss elem (előtte üres Lomtár)
urun fusion trash empty >/dev/null 2>&1
urun sh -c 'T=$HOME/.local/share/Trash; mkdir -p $T/files $T/info; echo a > $T/files/regi.txt; echo b > $T/files/friss.txt
  printf "[Trash Info]\nPath=/home/fusion/regi.txt\nDeletionDate=%s\n" "$(date -d "-40 days" +%Y-%m-%dT%H:%M:%S)" > $T/info/regi.txt.trashinfo
  printf "[Trash Info]\nPath=/home/fusion/friss.txt\nDeletionDate=%s\n" "$(date +%Y-%m-%dT%H:%M:%S)" > $T/info/friss.txt.trashinfo'
tr0=$(urun fusion trash --json | python3 -c 'import json,sys; j=json.load(sys.stdin); print("count=%d auto=%d" % (j["count"], j["autoDays"]))')
tr1=$(urun fusion trash purge-old --json | python3 -c 'import json,sys; print("removed=%d" % json.load(sys.stdin)["removed"])')
trl=$(urun ls /home/fusion/.local/share/Trash/files | tr '\n' ',')
urun fusion trash auto 0 >/dev/null; tr2=$(urun fusion trash --json | python3 -c 'import json,sys; j=json.load(sys.stdin); print("count=%d auto=%d" % (j["count"], j["autoDays"]))')
urun fusion trash auto 30 >/dev/null; urun fusion trash empty >/dev/null
echo "FUSION-TRASH: $tr0 $tr1 left=$trl $tr2 after=$(urun fusion trash --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["count"])')"
