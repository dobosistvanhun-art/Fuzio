#!/bin/sh
# FusionOS boot-teszt: a QEMU-teszt a soros konzolon keresi a FUSION-M1 / FUSION-M2 sorokat.
# (Type=exec szolgáltatásként fut, így a boot befejeződhet, és itt megvárhatjuk.)
systemctl is-system-running --wait >/dev/null 2>&1
# --- M7: A/B frissítés próbája (a teszt DATA-ján .fusion-test-ab jelölő: lépés = good | bad | final) ---
if [ -e /data/.fusion-test-ab ]; then
    abstep=$(cat /data/.fusion-test-ab)
    i=0; while [ $i -lt 420 ] && [ ! -s /run/fusion/boot-state ]; do sleep 2; i=$((i + 2)); done
    echo "FUSION-AB: BOOT step=$abstep slot=$(cat /run/fusion/slot) entry=$(cat /run/fusion/boot-entry) count=$(cat /run/fusion/boot-countpath 2>/dev/null || echo -)"
    echo "FUSION-AB: STATE $(cat /run/fusion/boot-state 2>/dev/null)"
    fusion-update status 2>&1 | sed 's/^/FUSION-AB:   /'
    upd=$(blkid -t LABEL=FUSIONUPD -o device 2>/dev/null | head -n 1)
    # a frissítőlemez a /data/import alá: onnan a felhasználó is telepíthet (fusion-admin update-apply)
    mkdir -p /data/import/upd; [ -n "$upd" ] && mount -o ro "$upd" /data/import/upd
    case "$abstep" in
        good|bad)
            if [ "$abstep" = good ]; then
                # mint a Beállítások → Rendszerfrissítés: a felhasználó, sudo-val a szűk segéden át, .fupd fájlból
                echo "FUSION-AB: GUARD $(runuser -u fusion -- sudo -n /usr/lib/fusion/bin/fusion-admin update-apply /etc/passwd.fupd 2>&1 | head -n 1)"
                runuser -u fusion -- sudo -n /usr/lib/fusion/bin/fusion-admin update-apply /data/import/upd/good.fupd > /run/fusion-ab.out 2>&1; arc=$?
            else
                fusion-update apply /data/import/upd/bad.fupd > /run/fusion-ab.out 2>&1; arc=$?
            fi
            sed 's/^/FUSION-AB:   /' /run/fusion-ab.out
            echo "FUSION-AB: APPLY $abstep rc=$arc"
            [ "$abstep" = good ] && echo bad > /data/.fusion-test-ab || echo final > /data/.fusion-test-ab
            sync; umount /data/import/upd 2>/dev/null
            echo "FUSION-AB: REBOOT"
            systemctl reboot --no-block ;;
        *)
            echo "FUSION-AB: DONE"
            systemctl poweroff --no-block ;;
    esac
    exit 0
fi
state=$(systemctl is-system-running 2>/dev/null)
root=$(findmnt -no FSTYPE /)
usr="$(findmnt -no FSTYPE /usr) $(findmnt -no OPTIONS /usr | cut -d, -f1)"
data=$(findmnt -no FSTYPE /data)
# shellcheck disable=SC1091
. /run/fusion/hardware/display.env 2>/dev/null
echo "FUSION-M1: SYSTEM UP state=$state"
echo "FUSION-M1: ROOT $root usr=$usr"
echo "FUSION-M1: MOUNTS data=$data"
echo "FUSION-M1: CMDLINE $(cat /proc/cmdline)"
echo "FUSION-M1: SLOT $(cat /run/fusion/slot 2>/dev/null)"
i=0; while [ $i -lt 30 ] && [ ! -s /run/fusion/boot-state ]; do sleep 1; i=$((i + 1)); done
echo "FUSION-M7: BOOTCHECK $(cat /run/fusion/boot-state 2>/dev/null || echo nincs)"
echo "FUSION-M1: WIFI-STORED $(ls /var/lib/iwd 2>/dev/null | tr '\n' ' ')"
echo "FUSION-M1: BOOTDISK $(cat /run/fusion/boot-disk 2>/dev/null) MARKER $(cat /data/.fusion-test-marker 2>/dev/null || echo none) IMAGE-CHANGED $(cat /run/fusion/image-changed 2>/dev/null || echo 0)"
echo "FUSION-M1: DISPLAY_PROFILE=${FUSION_DISPLAY_PROFILE:-none} STATUS=${FUSION_DISPLAY_STATUS:-none} DRIVER=${FUSION_DISPLAY_DRIVER_STATE:-none}"
echo "FUSION-M1: LOCALE $(sed -n 's/^LANG=//p' /etc/default/locale) KEYMAP $(sed -n 's/^XKBLAYOUT=//p' /etc/default/keyboard | tr -d '"')"
echo "FUSION-M1: GETTY $(systemctl is-active getty@tty1.service)"
echo "FUSION-M1: FAILED $(systemctl --failed --no-legend --plain | awk '{print $1}' | tr '\n' ' ')"
echo "FUSION-M1: USER $(getent passwd fusion | cut -d: -f1,6)"
echo "FUSION-M1: FAILEDCOUNT $(systemctl --failed --no-legend --plain | wc -l)"
echo "FUSION-M1: ROOTOWNER $(stat -c %U /) UNSAFE $(journalctl -b --no-pager -o cat 2>/dev/null | grep -c 'unsafe path transition')"
echo "FUSION-M1: MACHINE-ID $( [ -s /etc/machine-id ] && echo ok || echo empty)"
for u in $(systemctl --failed --no-legend --plain | awk '{print $1}'); do
    echo "FUSION-M1: --- napló: $u"
    journalctl -b -u "$u" --no-pager -o cat 2>/dev/null | tail -n 15 | sed 's/^/FUSION-M1:   /'
done
# --- M2: Fusion Desktop (Xorg, GL, Vulkan, ablakkezelő) ---
xrun() { runuser -u fusion -- env DISPLAY=:0 XAUTHORITY=/home/fusion/.Xauthority "$@"; }
i=0
if grep -qw 'fusion.desktop=0' /proc/cmdline; then
    echo "FUSION-M2: XORG disabled (fusion.desktop=0)"
else
while [ $i -lt 120 ] && ! xrun xdpyinfo >/dev/null 2>&1; do sleep 1; i=$((i + 1)); done
if xrun xdpyinfo >/dev/null 2>&1; then
    xlog=/var/log/Xorg.0.log; [ -r "$xlog" ] || xlog=/home/fusion/.local/share/xorg/Xorg.0.log
    ddx=$(grep -o '(II) [A-Za-z]*(0):' "$xlog" 2>/dev/null | head -n 1 | sed 's/(II) //; s/(0)://')
    echo "FUSION-M2: XORG up ddx=${ddx:-?} user=$(ps -o user= -C Xorg 2>/dev/null | head -n 1) wait=${i}s"
    glx=$(xrun glxinfo -B 2>/dev/null)
    echo "FUSION-M2: GL renderer=$(printf '%s\n' "$glx" | sed -n 's/^OpenGL renderer string: //p') version=$(printf '%s\n' "$glx" | sed -n 's/^OpenGL core profile version string: //p' | cut -d' ' -f1)"
    vk=$(xrun vulkaninfo --summary 2>/dev/null)
    vkdev=$(printf '%s\n' "$vk" | sed -n 's/^[[:space:]]*deviceName[[:space:]]*= //p' | head -n 1)
    vkapi=$(printf '%s\n' "$vk" | sed -n 's/^[[:space:]]*apiVersion[[:space:]]*= //p' | head -n 1)
    echo "FUSION-M2: VULKAN ${vkdev:-none} api=${vkapi:-none}"
    wm=$(pgrep -x -u fusion jwm >/dev/null && echo jwm || echo none)
    echo "FUSION-M2: WM $wm"
    echo "FUSION-M2: XKB $(xrun setxkbmap -query 2>/dev/null | sed -n 's/^layout:[[:space:]]*//p')"
else
    echo "FUSION-M2: XORG down"
    tail -n 25 /home/fusion/.local/share/fusion/session.log 2>/dev/null | sed 's/^/FUSION-M2:   /'
    grep -a '(EE)' /var/log/Xorg.0.log /home/fusion/.local/share/xorg/Xorg.0.log 2>/dev/null | tail -n 15 | sed 's/^/FUSION-M2:   /'
fi
fi
# --- M3: eszközréteg (soros eszközök szerephez kötve, /dev/fusion/*) ---
if ls /dev/ttyUSB* /dev/ttyACM* >/dev/null 2>&1 || grep -qw 'fusion.test.serial' /proc/cmdline; then
    i=0; while [ $i -lt 30 ] && [ ! -e /dev/fusion/laser ]; do sleep 1; i=$((i + 1)); done
fi
if [ -e /dev/fusion/laser ]; then
    t=$(readlink -f /dev/fusion/laser)
    echo "FUSION-M3: LASER $(basename "$t") group=$(stat -c %G "$t") mode=$(stat -c %a "$t")"
    # megnyitás a fusion felhasználóval, root nélkül
    if runuser -u fusion -- sh -c 'exec 3<>/dev/fusion/laser' 2>/dev/null; then echo "FUSION-M3: OPEN fusion ok"; else echo "FUSION-M3: OPEN fusion failed"; fi
    echo "FUSION-M3: DB $(grep -v '^#' /etc/fusion/devices.conf 2>/dev/null | tr '\n' ' ')"
    # biztosíték: a szerepet kapott eszköz USB-ja nem altatható, és amíg csatlakozik, a gép nem alszik el
    sleep 2
    ud=$(readlink -f "/sys/class/tty/$(basename "$t")/device"); while [ -n "$ud" ] && [ "$ud" != / ] && [ ! -r "$ud/idVendor" ]; do ud=$(dirname "$ud"); done
    echo "FUSION-M3: KEEPAWAKE inhibit=$(systemd-inhibit --list --no-legend 2>/dev/null | grep -c 'FusionOS') usbpower=$(cat "$ud/power/control" 2>/dev/null) unit=$(systemctl is-active fusion-keepawake@laser.service)"
    # kihúzás és visszadugás (a teszt a QEMU monitorán keresztül húzza ki és dugja vissza)
    echo "FUSION-M3: UNPLUG-NOW"
    i=0; while [ $i -lt 30 ] && [ -e /dev/fusion/laser ]; do sleep 1; i=$((i + 1)); done
    [ -e /dev/fusion/laser ] && echo "FUSION-M3: STILL-THERE" || echo "FUSION-M3: GONE"
    sleep 2; echo "FUSION-M3: KEEPAWAKE-GONE inhibit=$(systemd-inhibit --list --no-legend 2>/dev/null | grep -c 'FusionOS')"
    echo "FUSION-M3: REPLUG-NOW"
    i=0; while [ $i -lt 30 ] && [ ! -e /dev/fusion/laser ]; do sleep 1; i=$((i + 1)); done
    if [ -e /dev/fusion/laser ]; then
        echo "FUSION-M3: BACK $(basename "$(readlink -f /dev/fusion/laser)")"
        runuser -u fusion -- sh -c 'exec 3<>/dev/fusion/laser' 2>/dev/null && echo "FUSION-M3: REOPEN fusion ok"
        sleep 2; echo "FUSION-M3: KEEPAWAKE-BACK inhibit=$(systemd-inhibit --list --no-legend 2>/dev/null | grep -c 'FusionOS')"
    else
        echo "FUSION-M3: NOT-BACK"
    fi
    fusion-devices 2>&1 | sed 's/^/FUSION-M3:   /'
else
    echo "FUSION-M3: LASER none"
fi
# diagnosztika: soros eszközök, USB-eszközök, betöltött soros driverek
# shellcheck disable=SC2012
echo "FUSION-M3: TTY $(ls /dev/ttyUSB* /dev/ttyACM* 2>/dev/null | tr '\n' ' ')"
echo "FUSION-M3: USB $(lsusb 2>/dev/null | grep -v 'root hub' | cut -d' ' -f6- | tr '\n' ';')"
echo "FUSION-M3: MODS $(lsmod | awk '$1 ~ /^(usbserial|ftdi_sio|ch341|cp210x|pl2303|cdc_acm|xhci_pci)$/ {print $1}' | tr '\n' ' ')"
echo "FUSION-M3: NOGRAB $(for c in ModemManager brltty; do command -v $c >/dev/null && printf '%s ' $c; done)ok"
# --- Wi-Fi (iwd + systemd-networkd) — valódi kapcsolódás virtuális rádiókkal (mac80211_hwsim) ---
echo "FUSION-WIFI: IWD $(systemctl is-active iwd)"
# shellcheck disable=SC2012
echo "FUSION-WIFI: FW $(ls /usr/lib/firmware/iwlwifi-7260-17.ucode* 2>/dev/null | head -n 1)"
echo "FUSION-WIFI: MODS $(modinfo -n iwlwifi >/dev/null 2>&1 && echo iwlwifi) $(modinfo -n iwlmvm >/dev/null 2>&1 && echo iwlmvm)"
if modprobe mac80211_hwsim radios=2 2>/dev/null; then
    i=0; while [ $i -lt 60 ] && [ "$(iwctl device list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk 'NR>4 && NF>=5' | wc -l)" -lt 2 ]; do sleep 1; i=$((i + 1)); done
    ap=$(iwctl device list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk 'NR>4 && NF>=5 {print $1}' | tail -n 1)
    # a virtuális hozzáférési pont: indítás, ellenőrzés (Started yes), szükség esetén újra (lassú gépen késhet)
    # 2 sikertelen próba után a másik virtuális rádió lesz a hozzáférési pont
    devs=$(iwctl device list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk 'NR>4 && NF>=5 {print $1}')
    t=0; aperr=""
    while [ $t -lt 6 ]; do
        if [ $t -eq 2 ]; then
            old=$ap; ap=$(printf '%s\n' "$devs" | grep -vx "$old" | head -n 1)
            iwctl device "$old" set-property Mode station >/dev/null 2>&1; sleep 2
        fi
        iwctl device "$ap" set-property Mode ap >/dev/null 2>&1; sleep 2
        iwctl device "$ap" set-property Powered on >/dev/null 2>&1; sleep 1
        aperr=$(iwctl ap "$ap" start FusionTeszt fusion12345 2>&1 | sed 's/\x1b\[[0-9;]*m//g' | tr '\n' ' '); sleep 3
        iwctl ap "$ap" show 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | grep -q 'Started *yes' && break
        t=$((t + 1)); sleep 3
    done
    echo "FUSION-WIFI: AP $ap tries=$t ${aperr:+(utolsó üzenet: $aperr)}"
    # lassú (KVM nélküli) gépen a másik rádió station-módja késhet
    i=0; while [ $i -lt 30 ] && ! iwctl device list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk 'NR>4' | grep -q ' station'; do sleep 1; i=$((i + 1)); done
    out=$(timeout 90 runuser -u fusion -- env FUSION_WIFI_PASSPHRASE=fusion12345 fusion-wifi connect FusionTeszt 2>&1)
    printf '%s\n' "$out" | sed 's/^/FUSION-WIFI:   /'
    echo "FUSION-WIFI: STATE $(runuser -u fusion -- fusion-wifi 2>/dev/null | sed -n 's/^  Állapot: *//p')"
    runuser -u fusion -- fusion-wifi known 2>/dev/null | grep -q FusionTeszt && echo "FUSION-WIFI: KNOWN FusionTeszt"
    # a Beállítások Wi-Fi oldalának háttere (iwd a D-Buson, a fusion felhasználóként)
    runuser -u fusion -- env HOME=/home/fusion fusion-settings --selftest 2>&1 | grep 'WIFI' | sed 's/^/FUSION-WIFI: /'
    iwctl ap "$ap" stop >/dev/null 2>&1; modprobe -r mac80211_hwsim 2>/dev/null
else
    echo "FUSION-WIFI: HWSIM none"
fi

# --- M4 proof-of-concept: LightBurn-futtató (kísérleti: Wine WoW64); COM3 -> /dev/fusion/laser; OpenGL ---
if [ -x /usr/lib/fusion/wine/bin/wine ]; then
    echo "FUSION-M4: WINE $(/usr/lib/fusion/wine/bin/wine --version 2>/dev/null)"
    if [ -e /dev/fusion/laser ]; then
        out=$(timeout 1200 runuser -u fusion -- env HOME=/home/fusion DISPLAY=:0 XAUTHORITY=/home/fusion/.Xauthority \
              /usr/bin/fwr check 2>&1); rc=$?
        printf '%s\n' "$out" | sed 's/^/FUSION-M4:   /'
        echo "FUSION-M4: CHECK rc=$rc"
        echo "FUSION-M4: PREFIX $(ls -d /data/fwr/fwr-check/drive_c 2>/dev/null) owner=$(stat -c %U /data/fwr/fwr-check 2>/dev/null)"
        echo "FUSION-M4: SYSTRAY showsystray=$(grep -c '"ShowSystray"=dword:00000000' /data/fwr/fwr-check/user.reg 2>/dev/null) notray=$(grep -c '"NoTrayItemsDisplay"=dword:00000001' /data/fwr/fwr-check/user.reg 2>/dev/null)"
    fi
fi
# --- Fusion Programkezelő: általános Windows-telepítés (FusionTeszt), indítás fájllal, Linux-archívum,
#     fájltársítás, régi helyű LightBurn átköltöztetése, eltávolítás ---
prun() { runuser -u fusion -- env HOME=/home/fusion USER=fusion DISPLAY=:0 XAUTHORITY=/home/fusion/.Xauthority \
         XDG_RUNTIME_DIR=/run/user/1000 PATH=/usr/local/bin:/usr/bin:/bin "$@"; }
if [ -x /usr/bin/fusion-programs ] && [ -e /dev/fusion/laser ] && [ -x /usr/lib/fusion/wine/bin/wine ]; then
    P=/data/programs
    # 1) régi helyű LightBurn (fwr) → leírás a meglévő környezetre, újratelepítés nélkül (álprogrammal)
    lb="/data/fwr/lightburn/drive_c/Program Files/LightBurn"
    install -d -o fusion -g fusion /data/fwr "/data/fwr/lightburn" "/data/fwr/lightburn/drive_c" "/data/fwr/lightburn/drive_c/Program Files" "$lb"
    install -o fusion -g fusion -m 0644 /usr/lib/fusion/programs/tests/fusionteszt-setup.exe "$lb/LightBurn.exe"
    prun fusion-programs sync -v 2>&1 | sed 's/^/FUSION-PROG:   /'
    echo "FUSION-PROG: SYNC $(sed -n 's/^type = //p' $P/lightburn/program.fusion 2>/dev/null) prefix=$(sed -n 's/^prefix = //p' $P/lightburn/program.fusion 2>/dev/null) port=$(sed -n 's/^port.COM3 = //p' $P/lightburn/program.fusion 2>/dev/null) icon=$(sed -n 's/^icon = //p' $P/lightburn/program.fusion 2>/dev/null)"
    echo "FUSION-PROG: ASSOC-LBRN $(prun fusion-programs assoc /home/fusion/x.lbrn | cut -f1 | tr '\n' ' ')"
    # 2) általános Windows-telepítő: a program a Start menü parancsikonjából ismerhető fel
    out=$(prun timeout 900 fusion-programs install /usr/lib/fusion/programs/tests/fusionteszt-setup.exe 2>&1); rc=$?
    printf '%s\n' "$out" | tail -n 8 | sed 's/^/FUSION-PROG:   /'
    m=$P/fusionteszt/program.fusion
    # printf: a Windows-út visszaperjeleit (\f…) az echo értelmezné
    printf 'FUSION-PROG: WIN rc=%s name=%s exe=%s icon=%s owner=%s\n' "$rc" "$(sed -n 's/^name = //p' $m 2>/dev/null)" \
        "$(sed -n 's/^exe = //p' $m 2>/dev/null)" "$(sed -n 's/^icon = //p' $m 2>/dev/null)" "$(stat -c %U $P/fusionteszt 2>/dev/null)"
    echo "FUSION-PROG: DESKTOP $(grep -h '^Exec=' /home/fusion/.local/share/applications/fusion-fusionteszt.desktop 2>/dev/null)"
    # indítás egy fájllal a megosztott P: (Projektek) mappából — a program a Windows-utat kapja
    prun mkdir -p /home/fusion/Projektek; prun sh -c 'echo teszt > "/home/fusion/Projektek/proba teszt.lbrn"'
    args=$P/fusionteszt/win64/drive_c/users/Public/fusionteszt-args.txt
    rm -f "$args"
    prun fusion-run fusionteszt "/home/fusion/Projektek/proba teszt.lbrn"; rrc=$?
    i=0; while [ $rrc -eq 0 ] && [ $i -lt 120 ] && [ ! -s "$args" ]; do sleep 1; i=$((i + 1)); done
    j=0; while [ $j -lt 15 ] && [ "$(prun xwininfo -root -tree 2>/dev/null | grep -c '"FusionTeszt"')" = 0 ]; do sleep 1; j=$((j + 1)); done
    printf 'FUSION-PROG: RUN rc=%s wait=%ss window=%s args=%s\n' "$rrc" "$i" "$(prun xwininfo -root -tree 2>/dev/null | grep -c '"FusionTeszt"')" "$(tr -d '\r\n' < "$args" 2>/dev/null)"
    # 3) Linux-program archívumban (.desktop + X-Fusion-Open társítás)
    t=$(mktemp -d); mkdir -p "$t/fprobaprog"
    printf '#!/bin/sh\necho "$@" > /tmp/fusion-prog-native.txt\n' > "$t/fprobaprog/fprobaprog"; chmod 755 "$t/fprobaprog/fprobaprog"
    printf '[Desktop Entry]\nType=Application\nName=Fusion Próba\nExec=fprobaprog %%F\nX-Fusion-Open=.fprb\n' > "$t/fprobaprog/fprobaprog.desktop"
    tar czf /tmp/fprobaprog-1.0.tar.gz -C "$t" fprobaprog; chmod 644 /tmp/fprobaprog-1.0.tar.gz; rm -rf "$t"
    echo "FUSION-PROG: DETECT $(prun fusion-programs detect /tmp/fprobaprog-1.0.tar.gz) $(prun fusion-programs detect /usr/lib/fusion/programs/tests/fusionteszt-setup.exe)"
    prun fusion-programs install /tmp/fprobaprog-1.0.tar.gz 2>&1 | tail -n 2 | sed 's/^/FUSION-PROG:   /'
    prun sh -c 'echo 1 > /tmp/x.fprb'; rm -f /tmp/fusion-prog-native.txt
    a=$(prun fusion-programs assoc /tmp/x.fprb | cut -f1)
    [ -n "$a" ] && prun fusion-run "$a" /tmp/x.fprb; sleep 2
    echo "FUSION-PROG: NATIVE assoc=$a out=$(cat /tmp/fusion-prog-native.txt 2>/dev/null)"
    echo "FUSION-PROG: LIST $(prun fusion-programs list --json | python3 -c 'import json,sys; print(" ".join(p["id"] + ":" + p["type"] for p in json.load(sys.stdin)))')"
    # a Start menü programlistája a leírásokból
    echo "FUSION-PROG: APPS $(prun env QT_QPA_PLATFORM=offscreen fusion-settings --selftest 2>/dev/null | sed -n 's/.*FUSION-SETTINGS: APPS //p')"
    # 4) eltávolítás (a program mappája és Windows-környezete, a Start menü bejegyzés)
    for id in fprobaprog fusionteszt lightburn; do prun fusion-programs remove "$id" 2>&1 | tail -n 1 | sed 's/^/FUSION-PROG:   /'; done
    echo "FUSION-PROG: REMOVED left=$(ls $P | tr '\n' ' ')desktop=$(ls /home/fusion/.local/share/applications/ 2>/dev/null | grep -c '^fusion-') fwr-lightburn=$([ -d /data/fwr/lightburn ] && echo van || echo nincs)"
fi
# --- M5: Klipper + Moonraker + webes felület (Fluidd, Mainsail) ---
if [ -x /usr/lib/fusion/printer/klippy-env/bin/python ]; then
    api()  { curl -fsS --max-time 5 "http://127.0.0.1:7125$1" 2>/dev/null; }
    jval() { python3 -c "import sys, json
try:
    d = json.load(sys.stdin)['result']; print($1)
except Exception:
    print('?')"; }
    i=0; while [ $i -lt 60 ] && ! api /server/info >/dev/null; do sleep 2; i=$((i + 1)); done
    echo "FUSION-M5: SERVICES klipper=$(systemctl is-active fusion-klipper) moonraker=$(systemctl is-active fusion-moonraker) nginx=$(systemctl is-active nginx)"
    echo "FUSION-M5: VERSIONS $(cat /usr/lib/fusion/printer/klipper/klippy/.version) moonraker=$(cat /usr/lib/fusion/printer/moonraker/moonraker/.version)"
    echo "FUSION-M5: CONFIG $(grep -m1 '^serial:' /data/printer/config/printer.cfg 2>/dev/null) | $(ls /data/printer/config 2>/dev/null | tr '\n' ' ')"
    echo "FUSION-M5: OWNER $(stat -c '%U:%G %a' /data/printer 2>/dev/null)"
    # a valódi konfiguráció nyomtató nélkül: a Klipper hibát jelez (nincs /dev/fusion/printer), a Moonraker fut
    echo "FUSION-M5: DEFAULT klippy=$(api /server/info | jval "d['klippy_state']")"
    # teljes lánc szoftveres MCU-val (Klipper "Linux MCU"): Klipper ready, G-kód a Moonrakeren át
    T=/run/fusion/printer-test
    install -d -o klipper -g klipper "$T"
    runuser -u klipper -- /usr/lib/fusion/printer/bin/klipper-linux-mcu -I "$T/klipper_host_mcu" >/dev/null 2>&1 &
    mcu=$!
    cat > "$T/printer.cfg" <<'CFG'
[include /data/printer/config/mainsail.cfg]
[mcu]
serial: /run/fusion/printer-test/klipper_host_mcu
[printer]
kinematics: none
max_velocity: 100
max_accel: 100
CFG
    chown klipper:klipper "$T/printer.cfg"
    echo "KLIPPER_CONFIG=$T/printer.cfg" > /run/fusion/printer.env
    systemctl restart fusion-klipper
    st=""; i=0
    while [ $i -lt 45 ]; do st=$(api /printer/info | jval "d['state']"); [ "$st" = ready ] && break; sleep 2; i=$((i + 1)); done
    echo "FUSION-M5: KLIPPY state=$st version=$(api /printer/info | jval "d['software_version']")"
    [ "$st" = ready ] || tail -n 20 /data/printer/logs/klippy.log 2>/dev/null | sed 's/^/FUSION-M5:   klippy.log: /'
    echo "FUSION-M5: GCODE $(curl -fsS --max-time 10 -X POST 'http://127.0.0.1:7125/printer/gcode/script?script=M115' 2>/dev/null | jval "d")"
    echo "FUSION-M5: M115 $(api '/server/gcode_store?count=5' | jval "[w for g in d['gcode_store'] for w in g['message'].split() if w.startswith('FIRMWARE_NAME')][-1]")"
    echo "FUSION-M5: MACRO $(api '/printer/objects/list' | jval "'gcode_macro PAUSE' in d['objects'] and 'gcode_macro CANCEL_PRINT' in d['objects']")"
    echo "FUSION-M5: WEB fluidd=$(curl -fsS --max-time 5 http://127.0.0.1/ 2>/dev/null | grep -o '<title>[^<]*' | sed 's/<title>//') mainsail=$(curl -fsS --max-time 5 http://127.0.0.1:81/ 2>/dev/null | grep -o '<title>[^<]*' | sed 's/<title>//')"
    echo "FUSION-M5: PROXY $(curl -fsS --max-time 5 http://127.0.0.1/server/info 2>/dev/null | jval "d['klippy_state']") $(curl -fsS --max-time 5 http://127.0.0.1:81/printer/info 2>/dev/null | jval "d['state']")"
    runuser -u fusion -- fusion-printer 2>&1 | sed 's/^/FUSION-M5:   /'
    rm -f /run/fusion/printer.env; kill "$mcu" 2>/dev/null
    systemctl restart fusion-klipper
    echo "FUSION-M5: DONE"
fi
# --- M6: Fusion Desktop — Fusion Shell (panel, Start menü, értesítések), Fájlkezelő, Beállítások ---
urun() { runuser -u fusion -- env DISPLAY=:0 XAUTHORITY=/home/fusion/.Xauthority XDG_RUNTIME_DIR=/run/user/1000 HOME=/home/fusion \
         USER=fusion DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus PATH=/usr/local/bin:/usr/bin:/bin "$@"; }
# 1, ha a címet tartalmazó ablakok közül bármelyik látható (a Qt segédablakai is egyezhetnek a címre)
winview() { v=0; for w in $(urun xwininfo -root -tree 2>/dev/null | grep -F -- "$1" | awk '{print $1}'); do
                urun xwininfo -id "$w" 2>/dev/null | grep -q IsViewable && { v=1; break; }; done; echo "$v"; }
if xrun xdpyinfo >/dev/null 2>&1 && [ -x /usr/lib/fusion/desktop/shell/fusion-shell ]; then
    i=0; while [ $i -lt 120 ] && [ ! -e /run/user/1000/fusion-shell.ready ]; do sleep 1; i=$((i + 1)); done
    sleep 2
    pw=$(urun xwininfo -name "Fusion Panel" 2>/dev/null)
    strut=$(urun sh -c 'xprop -id $(xwininfo -name "Fusion Panel" | sed -n "s/.*Window id: \(0x[0-9a-f]*\).*/\1/p") _NET_WM_STRUT_PARTIAL _NET_WM_WINDOW_TYPE' 2>/dev/null | tr '\n' ' ')
    urun fusion-shell menu; sleep 3
    mv=$(urun xwininfo -name "Fusion Start" 2>/dev/null | grep -c IsViewable)
    urun fusion-shell menu; sleep 1
    echo "FUSION-M6: SHELL ready=$([ -e /run/user/1000/fusion-shell.ready ] && echo yes || echo no) wait=${i}s panel=$(printf '%s' "$pw" | grep -c IsViewable) width=$(printf '%s' "$pw" | sed -n 's/.*Width: //p') menu=$mv"
    echo "FUSION-M6: X11 $(printf '%s' "$strut" | grep -o '_NET_WM_WINDOW_TYPE_DOCK') strut=$(printf '%s' "$strut" | grep -o 'STRUT_PARTIAL(CARDINAL) = [0-9, ]*' | cut -d= -f2 | cut -d, -f4 | tr -d ' ')"
    # Letöltések mappa: a munkamenet beállítja (XDG), és egy Flatpak-program (homokozó, xdg-download) ide ment
    echo "FUSION-M6: USERDIRS $(grep '^XDG_DOWNLOAD_DIR=' /home/fusion/.config/user-dirs.dirs 2>/dev/null) dir=$([ -d /home/fusion/Letöltések ] && echo van || echo nincs)"
    urun timeout 120 sh /usr/lib/fusion/programs/tests/flatpak-download-test.sh /tmp/fusion-fpdl 2>&1 | grep '^DL ' | sed 's/^/FUSION-M6: FLATPAK-/'
    # értesítés a szabványos D-Bus-szolgáltatáson át → buborék + a Shell állapotában
    urun fusion-notify -i settings "FusionOS önteszt" "értesítés a D-Buson át"; nrc=$?
    sleep 2
    last=$(sed -n 's/.*"summary": "\([^"]*\)".*/\1/p' /run/user/1000/fusion-shell.state 2>/dev/null | head -n 1)
    echo "FUSION-M6: NOTIFY rc=$nrc last=$last toasts=$(sed -n 's/.*"toasts": \([0-9]*\).*/\1/p' /run/user/1000/fusion-shell.state)"
    # Fájlkezelő: a műveletek (felület nélkül), majd az ablak
    rm -rf /tmp/fusion-files-test; mkdir -p /tmp/fusion-files-test; chown fusion: /tmp/fusion-files-test
    urun fusion-files --selftest /tmp/fusion-files-test 2>&1 | sed 's/^/FUSION-M6:   /'
    # Feladatkezelő: egy válaszoló és egy „lefagyott” próbaablak; a lefagyott felismerése és leállítása
    urun timeout -k 5 100 fusion-tasks --selftest 2>&1 | sed 's/^/FUSION-M6:   /'
    echo "FUSION-M6: CTRLALTDEL $(grep -c 'key="Delete">exec:fusion-tasks' /etc/jwm/system.jwmrc) target=$(systemctl is-enabled ctrl-alt-del.target 2>/dev/null)"
    urun sh -c 'fusion-files /home/fusion /data >/tmp/fusion-files.log 2>&1 &'
    i=0; fw=0; while [ $i -lt 30 ]; do fw=$(winview '/home/fusion'); [ "$fw" = 1 ] && break; sleep 1; i=$((i + 1)); done
    echo "FUSION-M6: FILES window=$fw wait=${i}s"
    # Beállítások: minden oldal adatai, majd az ablak (egy példány: a második hívás oldalt vált)
    urun fusion-settings --selftest 2>&1 | sed 's/^/FUSION-M6:   /'
    urun sh -c 'fusion-settings system >/tmp/fusion-settings.log 2>&1 &'
    i=0; while [ $i -lt 30 ] && [ "$(winview 'Rendszer')" != 1 ]; do sleep 1; i=$((i + 1)); done
    sw=$(winview 'Rendszer')
    urun fusion-settings wifi; sleep 3
    echo "FUSION-M6: SETTINGS window=$sw wait=${i}s switched=$(winview 'Wi-Fi és hálózat')"
    echo "FUSION-M6: WINDOWS $(sed -n 's/.*"windows": \([0-9]*\).*/\1/p' /run/user/1000/fusion-shell.state)"
    # irányítópult: asztal típusú ablak a többi alatt
    dw=$(urun xwininfo -root -tree 2>/dev/null | grep -F 'Fusion Irányítópult' | head -n 1 | awk '{print $1}')
    echo "FUSION-M6: DASHBOARD viewable=$([ -n "$dw" ] && urun xwininfo -id "$dw" | grep -c IsViewable) type=$([ -n "$dw" ] && urun xprop -id "$dw" _NET_WM_WINDOW_TYPE | grep -o '_NET_WM_WINDOW_TYPE_DESKTOP')"
    # Fusion Programkezelő, mérési szakasz: Flatpak, homokozó, portál (internet nélkül ellenőrizhető rész)
    echo "FUSION-M6: USERNS restrict=$(cat /proc/sys/kernel/apparmor_restrict_unprivileged_userns 2>/dev/null)"
    echo "FUSION-M6: SESSION-ENV $(runuser -u fusion -- env XDG_RUNTIME_DIR=/run/user/1000 systemctl --user show-environment 2>/dev/null | grep -c '^XDG_CURRENT_DESKTOP=FusionOS\|^DISPLAY=:0')"
    urun fusion-appmeasure --check 2>&1 | sed 's/^/FUSION-M6:   /'
    # hang: kernel (HDA), PipeWire a fusion felhasználó munkamenetében, hangerő (a panel is látja), próbahang,
    # a Flatpak-programok PulseAudio-foglalata
    echo "FUSION-SOUND: KERNEL cards=$(grep -c '^ *[0-9]' /proc/asound/cards 2>/dev/null) hda=$(lsmod | grep -c '^snd_hda_intel ')"
    i=0; while [ $i -lt 30 ] && ! urun pactl info >/dev/null 2>&1; do sleep 1; i=$((i + 1)); done
    urun fusion-sound --json 2>/dev/null | python3 -c 'import json,sys; d=json.load(sys.stdin); print("FUSION-SOUND: SERVER ok=%s %s sinks=%d sources=%d default=%s" % (d["ok"], (d.get("server") or "-").replace(" ", "_"), len(d["sinks"]), len(d["sources"]), d["sink"] or "-"))' 2>&1
    urun fusion-sound set 40; sleep 2
    echo "FUSION-SOUND: SET volume=$(urun fusion-sound --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["volume"])') shell=$(python3 -c 'import json; print(json.load(open("/run/user/1000/fusion-shell.state")).get("sound", {}).get("volume"))' 2>/dev/null)"
    urun fusion-sound mute; sleep 1; m1=$(urun fusion-sound --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["mute"])')
    urun fusion-sound mute; sleep 1
    echo "FUSION-SOUND: MUTE $m1 $(urun fusion-sound --json | python3 -c 'import json,sys; print(json.load(sys.stdin)["mute"])')"
    urun fusion-sound test >/dev/null 2>&1; echo "FUSION-SOUND: TEST rc=$?"
    echo "FUSION-SOUND: FLATPAK-SOCKET $([ -S /run/user/1000/pulse/native ] && echo yes || echo no)"
    echo "FUSION-SOUND: KEYS $(grep -c 'XF86Audio' /etc/jwm/system.jwmrc)"
    # Google Drive: rclone a képben; a bejelentkezés helyi kiszolgálója a Google-ra irányít (internet nélkül is
    # ellenőrizhető); a csatolás-szolgáltatás egy helyi „ál-Drive”-val (rclone alias) végig, a Fájlkezelő kötetével
    echo "FUSION-DRIVE: RCLONE $(rclone version 2>/dev/null | head -n 1 | awk '{print $2}') status=$(urun fusion-drive >/dev/null 2>&1; echo $?)"
    urun python3 - <<'PY' 2>&1 | sed 's/^/FUSION-DRIVE: /'
import sys, time, subprocess
sys.path.insert(0, "/usr/lib/fusion/desktop/lib")
import fusion_drive as d
ev = []
L = d.Login(lambda k, t: ev.append((k, t)))
L.start()
for _ in range(40):
    if any(k == "url" for k, _t in ev):
        break
    time.sleep(0.25)
url = next((t for k, t in ev if k == "url"), "")
r = subprocess.run(["curl", "-s", "-o", "/dev/null", "-w", "%{http_code} %{redirect_url}", "--noproxy", "*", url], capture_output=True, text=True) if url else None
L.cancel()
print("LOGIN url=%s redirect=%s" % ("ok" if url else "none", (r.stdout.split()[0] + ":" + r.stdout.split("//")[1].split("/")[0]) if r and "//" in r.stdout else "-"))
PY
    rm -rf /tmp/fusion-fakedrive; mkdir -p /tmp/fusion-fakedrive; echo felho > /tmp/fusion-fakedrive/a-felhobol.txt; chown -R fusion: /tmp/fusion-fakedrive
