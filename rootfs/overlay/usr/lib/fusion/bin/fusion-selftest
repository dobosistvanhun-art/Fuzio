#!/bin/sh
# FusionOS boot-teszt: a QEMU-teszt a soros konzolon keresi a FUSION-M1 / FUSION-M2 sorokat.
# (Type=exec szolgáltatásként fut, így a boot befejeződhet, és itt megvárhatjuk.)
systemctl is-system-running --wait >/dev/null 2>&1
state=$(systemctl is-system-running 2>/dev/null)
root=$(findmnt -no FSTYPE /)
usr="$(findmnt -no FSTYPE /usr) $(findmnt -no OPTIONS /usr | cut -d, -f1)"
data=$(findmnt -no FSTYPE /data)
# shellcheck disable=SC1091
. /run/fusion/hardware/display.env 2>/dev/null
echo "FUSION-M1: SYSTEM UP state=$state"
echo "FUSION-M1: ROOT $root usr=$usr"
echo "FUSION-M1: MOUNTS data=$data"
echo "FUSION-M1: CMDLINE $(cat /proc/cmdline)"
echo "FUSION-M1: SLOT $(cat /run/fusion/slot 2>/dev/null)"
echo "FUSION-M1: DISPLAY_PROFILE=${FUSION_DISPLAY_PROFILE:-none} STATUS=${FUSION_DISPLAY_STATUS:-none} DRIVER=${FUSION_DISPLAY_DRIVER_STATE:-none}"
echo "FUSION-M1: LOCALE $(sed -n 's/^LANG=//p' /etc/default/locale) KEYMAP $(sed -n 's/^XKBLAYOUT=//p' /etc/default/keyboard | tr -d '"')"
echo "FUSION-M1: GETTY $(systemctl is-active getty@tty1.service)"
echo "FUSION-M1: FAILED $(systemctl --failed --no-legend --plain | awk '{print $1}' | tr '\n' ' ')"
echo "FUSION-M1: USER $(getent passwd fusion | cut -d: -f1,6)"
echo "FUSION-M1: FAILEDCOUNT $(systemctl --failed --no-legend --plain | wc -l)"
echo "FUSION-M1: ROOTOWNER $(stat -c %U /) UNSAFE $(journalctl -b --no-pager -o cat 2>/dev/null | grep -c 'unsafe path transition')"
echo "FUSION-M1: MACHINE-ID $( [ -s /etc/machine-id ] && echo ok || echo empty)"
for u in $(systemctl --failed --no-legend --plain | awk '{print $1}'); do
    echo "FUSION-M1: --- napló: $u"
    journalctl -b -u "$u" --no-pager -o cat 2>/dev/null | tail -n 15 | sed 's/^/FUSION-M1:   /'
done
# --- M2: Fusion Desktop (Xorg, GL, Vulkan, ablakkezelő) ---
xrun() { runuser -u fusion -- env DISPLAY=:0 XAUTHORITY=/home/fusion/.Xauthority "$@"; }
i=0
if grep -qw 'fusion.desktop=0' /proc/cmdline; then
    echo "FUSION-M2: XORG disabled (fusion.desktop=0)"
else
while [ $i -lt 120 ] && ! xrun xdpyinfo >/dev/null 2>&1; do sleep 1; i=$((i + 1)); done
if xrun xdpyinfo >/dev/null 2>&1; then
    xlog=/var/log/Xorg.0.log; [ -r "$xlog" ] || xlog=/home/fusion/.local/share/xorg/Xorg.0.log
    ddx=$(grep -o '(II) [A-Za-z]*(0):' "$xlog" 2>/dev/null | head -n 1 | sed 's/(II) //; s/(0)://')
    echo "FUSION-M2: XORG up ddx=${ddx:-?} user=$(ps -o user= -C Xorg 2>/dev/null | head -n 1) wait=${i}s"
    glx=$(xrun glxinfo -B 2>/dev/null)
    echo "FUSION-M2: GL renderer=$(printf '%s\n' "$glx" | sed -n 's/^OpenGL renderer string: //p') version=$(printf '%s\n' "$glx" | sed -n 's/^OpenGL core profile version string: //p' | cut -d' ' -f1)"
    vk=$(xrun vulkaninfo --summary 2>/dev/null)
    vkdev=$(printf '%s\n' "$vk" | sed -n 's/^[[:space:]]*deviceName[[:space:]]*= //p' | head -n 1)
    vkapi=$(printf '%s\n' "$vk" | sed -n 's/^[[:space:]]*apiVersion[[:space:]]*= //p' | head -n 1)
    echo "FUSION-M2: VULKAN ${vkdev:-none} api=${vkapi:-none}"
    wm=$(pgrep -x -u fusion jwm >/dev/null && echo jwm || echo none)
    echo "FUSION-M2: WM $wm"
    echo "FUSION-M2: XKB $(xrun setxkbmap -query 2>/dev/null | sed -n 's/^layout:[[:space:]]*//p')"
else
    echo "FUSION-M2: XORG down"
    tail -n 25 /home/fusion/.local/share/fusion/session.log 2>/dev/null | sed 's/^/FUSION-M2:   /'
    grep -a '(EE)' /var/log/Xorg.0.log /home/fusion/.local/share/xorg/Xorg.0.log 2>/dev/null | tail -n 15 | sed 's/^/FUSION-M2:   /'
fi
fi
# --- M3: eszközréteg (soros eszközök szerephez kötve, /dev/fusion/*) ---
if ls /dev/ttyUSB* /dev/ttyACM* >/dev/null 2>&1 || grep -qw 'fusion.test.serial' /proc/cmdline; then
    i=0; while [ $i -lt 30 ] && [ ! -e /dev/fusion/laser ]; do sleep 1; i=$((i + 1)); done
fi
if [ -e /dev/fusion/laser ]; then
    t=$(readlink -f /dev/fusion/laser)
    echo "FUSION-M3: LASER $(basename "$t") group=$(stat -c %G "$t") mode=$(stat -c %a "$t")"
    # megnyitás a fusion felhasználóval, root nélkül
    if runuser -u fusion -- sh -c 'exec 3<>/dev/fusion/laser' 2>/dev/null; then echo "FUSION-M3: OPEN fusion ok"; else echo "FUSION-M3: OPEN fusion failed"; fi
    echo "FUSION-M3: DB $(grep -v '^#' /etc/fusion/devices.conf 2>/dev/null | tr '\n' ' ')"
    # kihúzás és visszadugás (a teszt a QEMU monitorán keresztül húzza ki és dugja vissza)
    echo "FUSION-M3: UNPLUG-NOW"
    i=0; while [ $i -lt 30 ] && [ -e /dev/fusion/laser ]; do sleep 1; i=$((i + 1)); done
    [ -e /dev/fusion/laser ] && echo "FUSION-M3: STILL-THERE" || echo "FUSION-M3: GONE"
    echo "FUSION-M3: REPLUG-NOW"
    i=0; while [ $i -lt 30 ] && [ ! -e /dev/fusion/laser ]; do sleep 1; i=$((i + 1)); done
    if [ -e /dev/fusion/laser ]; then
        echo "FUSION-M3: BACK $(basename "$(readlink -f /dev/fusion/laser)")"
        runuser -u fusion -- sh -c 'exec 3<>/dev/fusion/laser' 2>/dev/null && echo "FUSION-M3: REOPEN fusion ok"
    else
        echo "FUSION-M3: NOT-BACK"
    fi
    fusion-devices 2>&1 | sed 's/^/FUSION-M3:   /'
else
    echo "FUSION-M3: LASER none"
fi
# diagnosztika: soros eszközök, USB-eszközök, betöltött soros driverek
# shellcheck disable=SC2012
echo "FUSION-M3: TTY $(ls /dev/ttyUSB* /dev/ttyACM* 2>/dev/null | tr '\n' ' ')"
echo "FUSION-M3: USB $(lsusb 2>/dev/null | grep -v 'root hub' | cut -d' ' -f6- | tr '\n' ';')"
echo "FUSION-M3: MODS $(lsmod | awk '$1 ~ /^(usbserial|ftdi_sio|ch341|cp210x|pl2303|cdc_acm|xhci_pci)$/ {print $1}' | tr '\n' ' ')"
echo "FUSION-M3: NOGRAB $(for c in ModemManager brltty; do command -v $c >/dev/null && printf '%s ' $c; done)ok"
# --- Wi-Fi (iwd + systemd-networkd) — valódi kapcsolódás virtuális rádiókkal (mac80211_hwsim) ---
echo "FUSION-WIFI: IWD $(systemctl is-active iwd)"
# shellcheck disable=SC2012
echo "FUSION-WIFI: FW $(ls /usr/lib/firmware/iwlwifi-7260-17.ucode* 2>/dev/null | head -n 1)"
echo "FUSION-WIFI: MODS $(modinfo -n iwlwifi >/dev/null 2>&1 && echo iwlwifi) $(modinfo -n iwlmvm >/dev/null 2>&1 && echo iwlmvm)"
if modprobe mac80211_hwsim radios=2 2>/dev/null; then
    i=0; while [ $i -lt 20 ] && [ "$(iwctl device list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk 'NR>4 && NF>=5' | wc -l)" -lt 2 ]; do sleep 1; i=$((i + 1)); done
    ap=$(iwctl device list 2>/dev/null | sed 's/\x1b\[[0-9;]*m//g' | awk 'NR>4 && NF>=5 {print $1}' | tail -n 1)
    iwctl device "$ap" set-property Mode ap >/dev/null 2>&1; sleep 2
    iwctl ap "$ap" start FusionTeszt fusion12345 >/dev/null 2>&1; sleep 3
    out=$(timeout 90 runuser -u fusion -- env FUSION_WIFI_PASSPHRASE=fusion12345 fusion-wifi connect FusionTeszt 2>&1)
    printf '%s\n' "$out" | sed 's/^/FUSION-WIFI:   /'
    echo "FUSION-WIFI: STATE $(runuser -u fusion -- fusion-wifi 2>/dev/null | sed -n 's/^  Állapot: *//p')"
    runuser -u fusion -- fusion-wifi known 2>/dev/null | grep -q FusionTeszt && echo "FUSION-WIFI: KNOWN FusionTeszt"
    iwctl ap "$ap" stop >/dev/null 2>&1; modprobe -r mac80211_hwsim 2>/dev/null
else
    echo "FUSION-WIFI: HWSIM none"
fi

# --- M4 proof-of-concept: LightBurn-futtató (kísérleti: Wine WoW64); COM3 -> /dev/fusion/laser; OpenGL ---
if [ -x /usr/lib/fusion/wine/bin/wine ]; then
    echo "FUSION-M4: WINE $(/usr/lib/fusion/wine/bin/wine --version 2>/dev/null)"
    if [ -e /dev/fusion/laser ]; then
        out=$(timeout 1200 runuser -u fusion -- env HOME=/home/fusion DISPLAY=:0 XAUTHORITY=/home/fusion/.Xauthority \
              /usr/bin/fwr check 2>&1); rc=$?
        printf '%s\n' "$out" | sed 's/^/FUSION-M4:   /'
        echo "FUSION-M4: CHECK rc=$rc"
        echo "FUSION-M4: PREFIX $(ls -d /data/fwr/fwr-check/drive_c 2>/dev/null) owner=$(stat -c %U /data/fwr/fwr-check 2>/dev/null)"
    fi
fi
echo "FUSION-M1: POWEROFF"
systemctl poweroff --no-block
