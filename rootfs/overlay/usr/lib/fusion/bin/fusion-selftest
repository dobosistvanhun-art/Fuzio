# --- M6: Fusion Desktop — Fusion Shell (panel, Start menü, értesítések), Fájlkezelő, Beállítások ---
urun() { runuser -u fusion -- env DISPLAY=:0 XAUTHORITY=/home/fusion/.Xauthority XDG_RUNTIME_DIR=/run/user/1000 HOME=/home/fusion \
         USER=fusion DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus PATH=/usr/local/bin:/usr/bin:/bin "$@"; }
# 1, ha a címet tartalmazó ablakok közül bármelyik látható (a Qt segédablakai is egyezhetnek a címre)
winview() { v=0; for w in $(urun xwininfo -root -tree 2>/dev/null | grep -F -- "$1" | awk '{print $1}'); do
                urun xwininfo -id "$w" 2>/dev/null | grep -q IsViewable && { v=1; break; }; done; echo "$v"; }
if xrun xdpyinfo >/dev/null 2>&1 && [ -x /usr/lib/fusion/desktop/shell/fusion-shell ]; then
    i=0; while [ $i -lt 120 ] && [ ! -e /run/user/1000/fusion-shell.ready ]; do sleep 1; i=$((i + 1)); done
    sleep 2
    pw=$(urun xwininfo -name "Fusion Panel" 2>/dev/null)
    strut=$(urun sh -c 'xprop -id $(xwininfo -name "Fusion Panel" | sed -n "s/.*Window id: \(0x[0-9a-f]*\).*/\1/p") _NET_WM_STRUT_PARTIAL _NET_WM_WINDOW_TYPE' 2>/dev/null | tr '\n' ' ')
    urun fusion-shell menu; sleep 3
    mv=$(urun xwininfo -name "Fusion Start" 2>/dev/null | grep -c IsViewable)
    urun fusion-shell menu; sleep 1
    echo "FUSION-M6: SHELL ready=$([ -e /run/user/1000/fusion-shell.ready ] && echo yes || echo no) wait=${i}s panel=$(printf '%s' "$pw" | grep -c IsViewable) width=$(printf '%s' "$pw" | sed -n 's/.*Width: //p') menu=$mv"
    echo "FUSION-M6: X11 $(printf '%s' "$strut" | grep -o '_NET_WM_WINDOW_TYPE_DOCK') strut=$(printf '%s' "$strut" | grep -o 'STRUT_PARTIAL(CARDINAL) = [0-9, ]*' | cut -d= -f2 | cut -d, -f4 | tr -d ' ')"
    # Letöltések mappa: a munkamenet beállítja (XDG), és egy Flatpak-program (homokozó, xdg-download) ide ment
    echo "FUSION-M6: USERDIRS $(grep '^XDG_DOWNLOAD_DIR=' /home/fusion/.config/user-dirs.dirs 2>/dev/null) dir=$([ -d /home/fusion/Letöltések ] && echo van || echo nincs)"
    urun timeout 120 sh /usr/lib/fusion/programs/tests/flatpak-download-test.sh /tmp/fusion-fpdl 2>&1 | grep '^DL ' | sed 's/^/FUSION-M6: FLATPAK-/'
    # értesítés a szabványos D-Bus-szolgáltatáson át → buborék + a Shell állapotában
    urun fusion-notify -i settings "FusionOS önteszt" "értesítés a D-Buson át"; nrc=$?
    sleep 2
    last=$(sed -n 's/.*"summary": "\([^"]*\)".*/\1/p' /run/user/1000/fusion-shell.state 2>/dev/null | head -n 1)
    echo "FUSION-M6: NOTIFY rc=$nrc last=$last toasts=$(sed -n 's/.*"toasts": \([0-9]*\).*/\1/p' /run/user/1000/fusion-shell.state)"
    # Fájlkezelő: a műveletek (felület nélkül), majd az ablak
    rm -rf /tmp/fusion-files-test; mkdir -p /tmp/fusion-files-test; chown fusion: /tmp/fusion-files-test
    urun fusion-files --selftest /tmp/fusion-files-test 2>&1 | sed 's/^/FUSION-M6:   /'
    # Feladatkezelő: egy válaszoló és egy „lefagyott” próbaablak; a lefagyott felismerése és leállítása
    urun timeout -k 5 100 fusion-tasks --selftest 2>&1 | sed 's/^/FUSION-M6:   /'
    # Lemezkezelő: a lemezlista (sudo fusion-admin disk list), a rendszerlemez védelme, a felület betöltése
    urun timeout -k 5 120 fusion-disks --selftest 2>&1 | sed 's/^/FUSION-M6:   /'
    echo "FUSION-M6: CTRLALTDEL $(grep -c 'key="Delete">exec:fusion-tasks' /etc/jwm/system.jwmrc) target=$(systemctl is-enabled ctrl-alt-del.target 2>/dev/null)"
    urun sh -c 'fusion-files /home/fusion /data >/tmp/fusion-files.log 2>&1 &'
    i=0; fw=0; while [ $i -lt 30 ]; do fw=$(winview '/home/fusion'); [ "$fw" = 1 ] && break; sleep 1; i=$((i + 1)); done
    echo "FUSION-M6: FILES window=$fw wait=${i}s"
    # Beállítások: minden oldal adatai, majd az ablak (egy példány: a második hívás oldalt vált)
    urun fusion-settings --selftest 2>&1 | sed 's/^/FUSION-M6:   /'
    urun sh -c 'fusion-settings system >/tmp/fusion-settings.log 2>&1 &'
    i=0; while [ $i -lt 30 ] && [ "$(winview 'Rendszer')" != 1 ]; do sleep 1; i=$((i + 1)); done
    sw=$(winview 'Rendszer')
    urun fusion-settings wifi; sleep 3
    echo "FUSION-M6: SETTINGS window=$sw wait=${i}s switched=$(winview 'Wi-Fi és hálózat')"
    echo "FUSION-M6: WINDOWS $(sed -n 's/.*"windows": \([0-9]*\).*/\1/p' /run/user/1000/fusion-shell.state)"
    # 0.0.47: Terminál (LXTerminal a fusion-terminal-on át: jobb gombos menü, Fusion-színek), tálca-ikonok
    rm -f /tmp/fusion-term.out
    urun sh -c 'fusion-terminal -t FusionTermTeszt -e sh -c "echo \"TERM-OK \$PWD\" > /tmp/fusion-term.out; sleep 30" >/tmp/fusion-term.log 2>&1 &'
    i=0; tw=0; while [ $i -lt 30 ]; do tw=$(winview 'FusionTermTeszt'); [ "$tw" = 1 ] && break; sleep 1; i=$((i + 1)); done
    sleep 2
    twid=$(urun xwininfo -root -tree 2>/dev/null | grep -F 'FusionTermTeszt' | head -n 1 | awk '{print $1}')
    echo "FUSION-T1: TERMINAL window=$tw wait=${i}s cmd=$(cut -d' ' -f1 /tmp/fusion-term.out 2>/dev/null) class=$([ -n "$twid" ] && urun xprop -id "$twid" WM_CLASS | grep -o '"lxterminal"' | tr -d '"') conf=$(grep -c '^bgcolor=rgb(13,17,23)' /usr/share/lxterminal/lxterminal.conf) hu=$([ -e /usr/share/locale/hu/LC_MESSAGES/lxterminal.mo ] && echo van || echo nincs)"
    [ "$tw" = 1 ] || sed 's/^/FUSION-T1:   terminal: /' /tmp/fusion-term.log | tail -n 10
    echo "FUSION-T1: TASKICONS $(python3 -c 'import json; s = set(json.load(open("/run/user/1000/fusion-shell.state")).get("taskicons", [])); print(" ".join(k + "=" + str(k in s) for k in ("files", "settings", "terminal")))')"
    # 0.0.48: Fejlesztő terminál (Start → Rendszer): a Terminál-ablak a Fejlesztődoboz parancssorával
    urun sh -c 'fusion-devterm >/tmp/fusion-devterm.log 2>&1 &'
