# --- Lemezkezelő: valódi műveletek a teszt üres USB-lemezén (FUSIONSCRATCH), a felhasználóként, a segéden át ---
adm() { runuser -u fusion -- sudo -n /usr/lib/fusion/bin/fusion-admin "$@"; }
mp_of() { awk -v d="$1" '$1 == d {print $2; exit}' /proc/self/mounts | sed 's/\\040/ /g'; }
scr=$(for f in /dev/disk/by-id/usb-*FUSIONSCRATCH*; do case "$f" in *-part*) ;; *) [ -e "$f" ] && readlink -f "$f";; esac; done | head -n 1)
# tartalék: a 96 MiB-os USB-lemez (ha a sorozatszám nem jelenne meg az udev-ben)
[ -n "$scr" ] || scr=$(lsblk -dnbo NAME,SIZE,TRAN | awk '$2 == 100663296 && $3 == "usb" {print "/dev/" $1; exit}')
if [ -n "$scr" ]; then
    k=$(basename "$scr")
    dj() { adm disk list | python3 -c "import json,sys; d=[x for x in json.load(sys.stdin)['disks'] if x['name']=='$k'][0]; $1"; }
    echo "FUSION-DISK: LIST $(dj 'print("found removable=%s system=%s table=%s parts=%d" % (d["removable"], d["system"], d["table"] or "-", len(d["partitions"])))')"
    e=$(adm disk format-disk "$k" dos vfat "Próba" "${k}x" 2>&1); echo "FUSION-DISK: CONFIRM rc=$? $(printf '%s' "$e" | tail -n 1)"
    adm disk format-disk "$k" dos vfat "Próba" "$k" > /tmp/fd.out 2>&1; rc=$?
    sleep 2; mp=$(mp_of "/dev/${k}1")
    echo "FUSION-DISK: FORMAT rc=$rc table=$(dj 'print(d["table"])') fs=$(blkid -p -o value -s TYPE "/dev/${k}1") label=$(blkid -p -o value -s LABEL "/dev/${k}1") mounted=${mp:-nincs} write=$(runuser -u fusion -- sh -c "echo ok > '$mp/proba.txt' && cat '$mp/proba.txt'" 2>/dev/null || echo no)"
    sed 's/^/FUSION-DISK:   /' /tmp/fd.out
    adm disk label "${k}1" "Új név" >/dev/null 2>&1; rc=$?
    sleep 1; echo "FUSION-DISK: LABEL rc=$rc label=$(blkid -p -o value -s LABEL "/dev/${k}1") mounted=$(mp_of "/dev/${k}1") file=$(cat "$(mp_of "/dev/${k}1")/proba.txt" 2>/dev/null)"
    adm disk delete "${k}1" "$k" >/dev/null 2>&1; rc=$?
    echo "FUSION-DISK: DELETE rc=$rc parts=$(dj 'print(len(d["partitions"]))') free=$(dj 'print(len(d["free"]))') media=$(ls /run/media/fusion 2>/dev/null | tr '\n' ' ')"
    adm disk create "$k" 1 32 ext4 "linux" "$k" >/dev/null 2>&1; r1=$?
    adm disk create "$k" 40 40 exfat "Közös" "$k" >/dev/null 2>&1; r2=$?
    sleep 2
    l1=$(mp_of "/dev/${k}1"); l2=$(mp_of "/dev/${k}2")
    echo "FUSION-DISK: CREATE rc=$r1,$r2 parts=$(dj 'print(",".join("%s:%s:%s" % (p["number"], p["fstype"], p["label"]) for p in d["partitions"]))') write=$(runuser -u fusion -- sh -c "echo a > '$l1/a' && echo b > '$l2/b' && cat '$l1/a' '$l2/b' | tr -d '\n'" 2>/dev/null || echo no) at=${l1:-?},${l2:-?}"
    adm disk format "${k}2" ntfs "Windows" "$k" >/dev/null 2>&1; rc=$?
    echo "FUSION-DISK: REFORMAT rc=$rc fs=$(blkid -p -o value -s TYPE "/dev/${k}2") type=$(dj 'print([p["parttype"] for p in d["partitions"] if p["number"]==2][0])')"
    adm disk format-disk "$k" gpt none "" "$k" >/dev/null 2>&1; rc=$?
    echo "FUSION-DISK: WIPE rc=$rc table=$(dj 'print(d["table"])') parts=$(dj 'print(len(d["partitions"]))') media=$(ls /run/media/fusion 2>/dev/null | tr '\n' ' ')"
    bd=$(cat /run/fusion/boot-disk)
    g1=$(adm disk format-disk "$bd" gpt vfat x "$bd" 2>&1 | tail -n 1); g2=$(adm disk delete "${bd}4" "$bd" 2>&1 | tail -n 1)
    echo "FUSION-DISK: GUARD $g1 | $g2"
else
    echo "FUSION-DISK: nincs teszt-lemez"
fi
