# --- memória (0.0.30): a Fusion-folyamatok PSS-e (arányos memória) és a megosztott (tmpfs) rész — tájékoztató ---
memline=""
for pid in $(pgrep -u fusion -f 'fusion_(shell|tasks_app|settings_app)\.py|fusion-(tasks|shell)' 2>/dev/null); do
    n=$(tr '\0' ' ' < /proc/$pid/cmdline 2>/dev/null | grep -o 'fusion[_-][a-z_]*' | head -n 1)
    k=$(awk '/^Pss:/ {print $2}' /proc/$pid/smaps_rollup 2>/dev/null)
    [ -n "$k" ] && memline="$memline $n=$((k / 1024))MB"
done
echo "FUSION-MEM: PSS${memline:- nincs} SHMEM $(awk '/^Shmem:/ {print int($2/1024) "MB"}' /proc/meminfo) USED $(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} END {print int((t-a)/1024) "MB"}' /proc/meminfo)"
