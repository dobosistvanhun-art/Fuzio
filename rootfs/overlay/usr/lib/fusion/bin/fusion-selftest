    echo "FUSION-M6: EJECT rc=$erc left=$(ls /run/media 2>/dev/null | tr '\n' ' ')$(printf '%s' "$e" | tail -n 1)"
    sleep 3
    echo "FUSION-M6: SHELL-MEDIA $(sed -n 's/.*"media": \[\(.*\)\].*/\1/p' /run/user/1000/fusion-shell.state 2>/dev/null | tr -d ' \n')"
fi
# --- Lemezkezelő: valódi műveletek a teszt üres USB-lemezén (FUSIONSCRATCH), a felhasználóként, a segéden át ---
adm() { runuser -u fusion -- sudo -n /usr/lib/fusion/bin/fusion-admin "$@"; }
mp_of() { awk -v d="$1" '$1 == d {print $2; exit}' /proc/self/mounts | sed 's/\\040/ /g'; }
scr=$(for f in /dev/disk/by-id/usb-*FUSIONSCRATCH*; do case "$f" in *-part*) ;; *) [ -e "$f" ] && readlink -f "$f";; esac; done | head -n 1)
# tartalék: a 96 MiB-os USB-lemez (ha a sorozatszám nem jelenne meg az udev-ben)
[ -n "$scr" ] || scr=$(lsblk -dnbo NAME,SIZE,TRAN | awk '$2 == 100663296 && $3 == "usb" {print "/dev/" $1; exit}')
if [ -n "$scr" ]; then
    k=$(basename "$scr")
    dj() { adm disk list | python3 -c "import json,sys; d=[x for x in json.load(sys.stdin)['disks'] if x['name']=='$k'][0]; $1"; }
    echo "FUSION-DISK: LIST $(dj 'print("found removable=%s system=%s table=%s parts=%d" % (d["removable"], d["system"], d["table"] or "-", len(d["partitions"])))')"
    e=$(adm disk format-disk "$k" dos vfat "Próba" "${k}x" 2>&1); echo "FUSION-DISK: CONFIRM rc=$? $(printf '%s' "$e" | tail -n 1)"
    adm disk format-disk "$k" dos vfat "Próba" "$k" > /tmp/fd.out 2>&1; rc=$?
    sleep 2; mp=$(mp_of "/dev/${k}1")
    echo "FUSION-DISK: FORMAT rc=$rc table=$(dj 'print(d["table"])') fs=$(blkid -p -o value -s TYPE "/dev/${k}1") label=$(blkid -p -o value -s LABEL "/dev/${k}1") mounted=${mp:-nincs} write=$(runuser -u fusion -- sh -c "echo ok > '$mp/proba.txt' && cat '$mp/proba.txt'" 2>/dev/null || echo no)"
    sed 's/^/FUSION-DISK:   /' /tmp/fd.out
    adm disk label "${k}1" "Új név" >/dev/null 2>&1; rc=$?
    sleep 1; echo "FUSION-DISK: LABEL rc=$rc label=$(blkid -p -o value -s LABEL "/dev/${k}1") mounted=$(mp_of "/dev/${k}1") file=$(cat "$(mp_of "/dev/${k}1")/proba.txt" 2>/dev/null)"
    adm disk delete "${k}1" "$k" >/dev/null 2>&1; rc=$?
    echo "FUSION-DISK: DELETE rc=$rc parts=$(dj 'print(len(d["partitions"]))') free=$(dj 'print(len(d["free"]))') media=$(ls /run/media | tr '\n' ' ')"
    adm disk create "$k" 1 32 ext4 "linux" "$k" >/dev/null 2>&1; r1=$?
    adm disk create "$k" 40 40 exfat "Közös" "$k" >/dev/null 2>&1; r2=$?
    sleep 2
    l1=$(mp_of "/dev/${k}1"); l2=$(mp_of "/dev/${k}2")
    echo "FUSION-DISK: CREATE rc=$r1,$r2 parts=$(dj 'print(",".join("%s:%s:%s" % (p["number"], p["fstype"], p["label"]) for p in d["partitions"]))') write=$(runuser -u fusion -- sh -c "echo a > '$l1/a' && echo b > '$l2/b' && cat '$l1/a' '$l2/b' | tr -d '\n'" 2>/dev/null || echo no) at=${l1:-?},${l2:-?}"
    adm disk format "${k}2" ntfs "Windows" "$k" >/dev/null 2>&1; rc=$?
    echo "FUSION-DISK: REFORMAT rc=$rc fs=$(blkid -p -o value -s TYPE "/dev/${k}2") type=$(dj 'print([p["parttype"] for p in d["partitions"] if p["number"]==2][0])')"
    adm disk format-disk "$k" gpt none "" "$k" >/dev/null 2>&1; rc=$?
    echo "FUSION-DISK: WIPE rc=$rc table=$(dj 'print(d["table"])') parts=$(dj 'print(len(d["partitions"]))') media=$(ls /run/media | tr '\n' ' ')"
    bd=$(cat /run/fusion/boot-disk)
    g1=$(adm disk format-disk "$bd" gpt vfat x "$bd" 2>&1 | tail -n 1); g2=$(adm disk delete "${bd}4" "$bd" 2>&1 | tail -n 1)
    echo "FUSION-DISK: GUARD $g1 | $g2"
else
    echo "FUSION-DISK: nincs teszt-lemez"
fi
# --- Hibajelentés: a felhasználóként (a rendszeroldali rész sudo-val), maszkolás ---
t0=$(date +%s)
rout=$(urun fusion-report -d "Teszt: a lézer nem látszik. jelszó=Titok123 kapcsolat: teszt.elek@pelda.hu" -o /tmp/fusion-report 2>&1); rrc=$?
rf=$(ls /tmp/fusion-report/fusion-hibajelentes-*.txt 2>/dev/null | head -n 1)
echo "FUSION-REPORT: RUN rc=$rrc secs=$(( $(date +%s) - t0 )) size=$(stat -c %s "$rf" 2>/dev/null || echo 0) $(printf '%s' "$rout" | tail -n 1)"
if [ -n "$rf" ]; then
    echo "FUSION-REPORT: SECTIONS $(for h in 'GYORS ELLENŐRZÉS' 'SZOLGÁLTATÁSOK' 'ESZKÖZÖK' 'LEMEZEK' 'HÁLÓZAT' 'RENDSZERFRISSÍTÉS' 'PROGRAMOK' 'MEMÓRIA' 'NAPLÓK' 'ADATVÉDELEM'; do grep -q "^$h" "$rf" && printf 'ok,' || printf '%s:hiányzik,' "$h"; done)"
    echo "FUSION-REPORT: MASK secret=$(grep -c 'Titok123' "$rf") email=$(grep -c 'teszt.elek@pelda.hu' "$rf") ssid=$(grep -c 'FusionTeszt' "$rf") alias=$(grep -c 'EMAIL-1' "$rf")"
    echo "FUSION-REPORT: SYSTEM update=$(grep -c 'fusionos-.*\.efi' "$rf") pss=$(grep -c 'összesen (minden folyamat)' "$rf") state=$(grep -o 'rendszerállapot: [a-z]*' "$rf")"
    grep -E '^\s+\[' "$rf" | head -n 14 | sed 's/^/FUSION-REPORT:   /'
fi
# --- T3: DATA mentése és telepítő pendrive készítése a futó FusionOS-ből (a telepítő-teszt 2. indítása) ---
t3b=$(lsblk -dno NAME,SERIAL | awk '$2 == "FUSIONBACKUP" {print $1; exit}')
t3m=$(lsblk -dno NAME,SERIAL | awk '$2 == "FUSIONMEDIA" {print $1; exit}')
if [ -n "$t3b" ] && [ -n "$t3m" ] && [ ! -e /data/.fusion-test-restored ]; then
    adm() { runuser -u fusion -- sudo -n /usr/lib/fusion/bin/fusion-admin "$@"; }
    adm disk format-disk "$t3b" gpt exfat MENTES "$t3b" > /tmp/t3fd.out 2>&1; echo "FUSION-T3: FORMAT rc=$? $(tail -n 1 /tmp/t3fd.out)"
    i=0; while [ $i -lt 20 ] && [ ! -d /run/media/MENTES ]; do sleep 1; i=$((i + 1)); done
    echo mentett > /data/.fusion-test-marker; sync
    t0=$(date +%s); adm backup create /run/media/MENTES > /tmp/t3b.out 2>&1; rc=$?
    grep -v '^PROGRESS' /tmp/t3b.out | sed 's/^/FUSION-T3:   /'
    echo "FUSION-T3: BACKUP rc=$rc secs=$(( $(date +%s) - t0 )) complete=$(python3 -c 'import json,glob; print(json.load(open(sorted(glob.glob("/run/media/MENTES/FusionOS-mentes/*.info.json"))[-1]))["complete"])' 2>/dev/null)"
    adm backup list | python3 -c 'import json,sys; d=json.load(sys.stdin); print("FUSION-T3: LIST targets=%d backups=%d" % (len(d["targets"]), len(d["backups"])))'
    # a .fupd a telepítő pendrive-ról (FUSION_IPAY) — mintha a felhasználó a Letöltésekbe másolta volna
    ip=$(blkid -t PARTLABEL=FUSION_IPAY -o device | head -n 1); mkdir -p /data/import/inst; mount -o ro "$ip" /data/import/inst
    fu=$(ls /data/import/inst/*.fupd | head -n 1)
    g=$(adm installer-media "$fu" "$t3m" "${t3m}x" 2>&1 | tail -n 1)
    t0=$(date +%s); adm installer-media "$fu" "$t3m" "$t3m" > /tmp/t3m.out 2>&1; rc=$?
    grep -v '^PROGRESS' /tmp/t3m.out | sed 's/^/FUSION-T3:   /'
    sleep 2
    echo "FUSION-T3: MEDIA rc=$rc secs=$(( $(date +%s) - t0 )) parts=$(lsblk -lno PARTLABEL "/dev/$t3m" | sed '/^$/d' | paste -sd, -) guard=$(printf '%s' "$g" | grep -c 'nem egyezik')"
    umount /data/import/inst
    # az OVMF csak az induláskor bootolható lemezeknek ad bejegyzést: a most készült pendrive-hoz mi hozunk létre egyet
    bo=$(efibootmgr | sed -n 's/^BootOrder: //p')
    efibootmgr -q -c -d "/dev/$t3m" -p 1 -L "FusionOS-T3-teszt" -l '\EFI\BOOT\BOOTX64.EFI' 2>/dev/null
    [ -n "$bo" ] && efibootmgr -q -o "$bo"     # csak egyszer (BootNext), az indítási sorrend marad
    bn=$(efibootmgr | sed -n 's/^Boot\([0-9A-Fa-f]\{4\}\)\*\{0,1\} FusionOS-T3-teszt.*/\1/p' | head -n 1)
    [ -n "$bn" ] && efibootmgr -q -n "$bn" && echo "FUSION-T3: BOOTNEXT ok ($bn)" || { echo "FUSION-T3: BOOTNEXT nincs"; efibootmgr | sed 's/^/FUSION-T3:   /'; }
    if [ "$rc" = 0 ] && [ -n "$bn" ]; then sync; systemctl reboot --no-block; exit 0; fi
fi
echo "FUSION-M1: POWEROFF"
systemctl poweroff --no-block
