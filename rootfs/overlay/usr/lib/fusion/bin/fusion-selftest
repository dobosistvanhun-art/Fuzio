# a GTK / GIO fájlválasztói (a Flatpak-programokban is, pl. PrusaSlicer) a felhasználó nevében eszközként mutatják-e
# (a GLib csak a /media és a /run/media/<felhasználó> alatti köteteket mutatja — ZBook, 0.0.34: a PrusaSlicer nem látta)
cat > /tmp/fusion-gioshow.py <<'PY'
import ctypes
gio = ctypes.CDLL("libgio-2.0.so.0")
gio.g_unix_mounts_get.restype = ctypes.c_void_p; gio.g_unix_mounts_get.argtypes = [ctypes.c_void_p]
gio.g_unix_mount_get_mount_path.restype = ctypes.c_char_p; gio.g_unix_mount_get_mount_path.argtypes = [ctypes.c_void_p]
gio.g_unix_mount_guess_should_display.argtypes = [ctypes.c_void_p]
class L(ctypes.Structure):
    pass
L._fields_ = [("data", ctypes.c_void_p), ("next", ctypes.POINTER(L)), ("prev", ctypes.POINTER(L))]
p = ctypes.cast(gio.g_unix_mounts_get(None), ctypes.POINTER(L)); out = []
while p:
    mp = gio.g_unix_mount_get_mount_path(p.contents.data).decode()
    if gio.g_unix_mount_guess_should_display(p.contents.data) and "/media/" in mp:
        out.append(mp.rsplit("/", 1)[-1])
    p = p.contents.next
print(",".join(sorted(out)) or "-")
PY
