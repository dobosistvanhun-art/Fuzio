try:
    d = json.load(sys.stdin)['result']; print($1)
except Exception:
    print('?')"; }
    i=0; while [ $i -lt 60 ] && ! api /server/info >/dev/null; do sleep 2; i=$((i + 1)); done
    echo "FUSION-M5: SERVICES klipper=$(systemctl is-active fusion-klipper) moonraker=$(systemctl is-active fusion-moonraker) nginx=$(systemctl is-active nginx)"
