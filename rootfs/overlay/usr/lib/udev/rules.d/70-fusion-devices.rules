# Fusion eszközréteg — soros eszközök szerephez kötése (fusion-devd)
# A 60-serial.rules után fut (ID_VENDOR_ID, ID_MODEL_ID, ID_SERIAL_SHORT, ID_PATH),
# és a 73-seat-late.rules előtt, így a uaccess címke még érvényesül: a bejelentkezett
# felhasználó root és kézi csoportbeállítás nélkül megnyithatja az eszközt.
ACTION=="remove", GOTO="fusion_devices_end"
SUBSYSTEM!="tty", GOTO="fusion_devices_end"
ENV{ID_BUS}!="usb", GOTO="fusion_devices_end"

IMPORT{program}="/usr/lib/fusion/devices/fusion-devd udev"
ENV{FUSION_ROLE}=="?*", SYMLINK+="fusion/$env{FUSION_ROLE}", TAG+="uaccess"
# biztosíték: a szerepet kapott eszköz USB-ja nem altatható (a LightBurn / Klipper munka közben nem szakadhat meg)
ENV{FUSION_ROLE}=="?*", RUN+="/usr/lib/fusion/devices/fusion-devd keepawake $env{DEVPATH}"
# amíg szerepet kapott eszköz (lézer, nyomtató) csatlakozik, a gép nem alszik el — a fedél lecsukására sem
ENV{FUSION_ROLE}=="?*", TAG+="systemd", ENV{SYSTEMD_WANTS}+="fusion-keepawake@$env{FUSION_ROLE}.service"
ENV{FUSION_ROLE_NEW}=="1", RUN+="/usr/lib/fusion/devices/fusion-devd record $env{FUSION_ROLE} $env{FUSION_DEVICE_KEY} $env{DEVPATH}"

LABEL="fusion_devices_end"
