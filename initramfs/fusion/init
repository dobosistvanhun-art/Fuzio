#!/bin/sh
# =============================================================================
#  Fúzió — fusion-init (initramfs, busybox)
#
#  1. a lemez- és USB-modulok betöltése
#  2. a slot kiválasztása (kernel parancssor: fusion.slot=A|B)
#  3. a slot rendszerképének (EROFS) csatolása csak olvashatóan
#  4. a FUSION_DATA partíció csatolása (írható állapot)
#  5. gyökér = overlay: alul a rendszerkép, felül a DATA (/etc, /var, /home ...
#     írható, és megmarad); a /usr közvetlenül a rendszerkép, csak olvasható
#  6. átadás a rendszernek (switch_root -> systemd)
#
#  Miért egyetlen gyökér-overlay? A gyökeret és a /usr-t a systemd soha nem
#  próbálja leválasztani, így leállításkor nincs "Failed unmounting" hiba, és a
#  DATA partíciót a legvégén, tisztán zárja le (data.mount: DefaultDependencies=no).
#
#  A partíciókat GPT-név szerint keresi (FUSION_A, FUSION_B, FUSION_DATA),
#  nem eszköznév szerint. Hiba esetén mentőhéjat ad, érthető üzenettel.
# =============================================================================
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH

mount -t devtmpfs devtmpfs /dev 2>/dev/null
exec </dev/console >/dev/console 2>&1
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t tmpfs -o mode=0755,nosuid,nodev tmpfs /run
echo 3 > /proc/sys/kernel/printk

CMDLINE=$(cat /proc/cmdline)
arg_val() { for a in $CMDLINE; do case "$a" in "$1="*) echo "${a#*=}"; return ;; esac; done; }
has_arg() { case " $CMDLINE " in *" $1 "*|*" $1="*) return 0 ;; esac; return 1; }

msg() { printf 'fusion-init: %s\n' "$*"; }

# az elindított boot-bejegyzés (systemd-boot): „…+2-1.efi” = próba-indítás egy frissítés után (M7)
mount -t efivarfs efivarfs /sys/firmware/efi/efivars 2>/dev/null
efivar_str() {  # az EFI-változó szövege (UTF-16); az efivarfs nem léptethető, ezért csővel
    f=/sys/firmware/efi/efivars/$1-4a67b082-0a4c-41cf-b6c7-440b29bb8c4f
    [ -r "$f" ] && cat "$f" | tail -c +5 | tr -d '\000'
}
ENTRY=$(efivar_str LoaderEntrySelected)
COUNTPATH=$(efivar_str LoaderBootCountPath)     # csak számlálós (próba) bejegyzésnél van
TRIAL=""; [ -n "$COUNTPATH" ] && TRIAL=1
case "$ENTRY" in *+[0-9]*.efi) TRIAL=1 ;; esac

# a következő indítás is a mostani UEFI-bejegyzésről (pl. a ZBookon a Mint az első a sorban):
# BootNext = BootCurrent. Az efivarfs egyetlen írást fogad el, ezért előbb fájlba rakjuk össze.
set_bootnext() {
    d=/sys/firmware/efi/efivars; g=8be4df61-93ca-11d2-aa0d-00e098032b8c
    [ -r "$d/BootCurrent-$g" ] || return 1
    { printf '\007\000\000\000'; cat "$d/BootCurrent-$g" | tail -c 2; } > /run/bootnext.bin
    [ -e "$d/BootNext-$g" ] && chattr -i "$d/BootNext-$g" 2>/dev/null
    cat /run/bootnext.bin > "$d/BootNext-$g" 2>/dev/null
}

rescue() {
    printf '\n\033[1;31mFúzió: a rendszer nem indítható.\033[0m\n%s\n\n' "$*"
    if [ -n "$TRIAL" ]; then
        # próba-indítás: újraindítás — a systemd-boot számlálója fogy, a 3. sikertelen próba után
        # magától a korábbi (véglegesített) rendszer indul
        w=15; has_arg fusion.test && w=3
        printf 'Ez egy frissítés utáni próba-indítás (%s).\nÚjraindítás %s mp múlva — ha többször sem sikerül, a korábbi rendszer indul.\n' "${COUNTPATH:-$ENTRY}" "$w"
        set_bootnext && printf 'A következő indítás is innen (UEFI BootNext).\n'
        sleep "$w"; reboot -f
    fi
    printf 'Mentőhéj — "reboot -f" újraindít, "poweroff -f" kikapcsol.\n'
    printf 'A Fúzió diagnosztika a boot menüből is elérhető.\n\n'
    setsid cttyhack sh
    reboot -f
}

# betűkészlet (magyar ékezetek) — fbcon=nodefer mellett azonnal betölthető
[ -r /usr/share/fusion/console.psf ] && loadfont < /usr/share/fusion/console.psf 2>/dev/null

# 1. modulok
if [ -r /lib/modules/fusion/modules.order ]; then
    while read -r m; do
        [ -n "$m" ] && insmod "/lib/modules/fusion/$m" 2>/dev/null
    done < /lib/modules/fusion/modules.order
fi

# 2. slot — telepítő módban (fusion.installer, a telepítő pendrive): a rendszerkép a FUSION_ISYS
#    partícióról, az írható réteg RAM-ban (a pendrive-ra nem ír, többször használható)
INSTALLER=""; has_arg fusion.installer && INSTALLER=1
if [ -n "$INSTALLER" ]; then
    SLOT=I
else
    SLOT=$(arg_val fusion.slot)
    case "$SLOT" in A|B) ;; *) rescue "Érvénytelen vagy hiányzó slot a kernel parancssorában (fusion.slot=$SLOT)." ;; esac
fi

# A boot-lemez: ahonnan az UEFI a Fúziót indította. A systemd-boot a
# LoaderDevicePartUUID EFI-változóban megadja az ESP partíció-azonosítóját; a lemezek
# GPT-jéből megkeressük, melyik lemezen van. Így ha több Fúzió-lemez is csatlakozik
# (pl. SSD + pendrive), a slot és a DATA mindig arról a lemezről jön, amelyikről indult.
guid_of() {  # 32 hexa karakter (GPT, vegyes bájtsorrend) -> xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
    printf '%s-%s-%s-%s-%s' \
        "$(printf '%s' "$1" | cut -c1-8 | sed 's/\(..\)\(..\)\(..\)\(..\)/\4\3\2\1/')" \
        "$(printf '%s' "$1" | cut -c9-12 | sed 's/\(..\)\(..\)/\2\1/')" \
        "$(printf '%s' "$1" | cut -c13-16 | sed 's/\(..\)\(..\)/\2\1/')" \
        "$(printf '%s' "$1" | cut -c17-20)" "$(printf '%s' "$1" | cut -c21-32)"
}
boot_disk() {
    want=$(efivar_str LoaderDevicePartUUID | tr -d '\n' | tr 'A-F' 'a-f')
    [ -n "$want" ] || return 1
    for b in /sys/block/*; do
        n=${b##*/}
        case "$n" in loop*|ram*|zram*|sr*|dm-*|md*|nbd*) continue ;; esac
        # a GPT partíciós bejegyzései (LBA 2-től, 128 bájtonként; az egyedi azonosító a 16. bájttól)
        hex=$(dd if="/dev/$n" bs=512 skip=2 count=8 2>/dev/null | od -An -v -tx1 | tr -d ' \n')
        k=0
        while [ $k -lt 32 ]; do
            s=$((k * 256 + 33))
            g=$(printf '%s' "$hex" | cut -c"$s"-"$((s + 31))")
            [ ${#g} -eq 32 ] || break
            [ "$(guid_of "$g")" = "$want" ] && { echo "$n"; return 0; }
            k=$((k + 1))
        done
    done
    return 1
}

# GPT-név szerinti keresés (a boot-lemezen, ha ismert); várunk az USB/SATA eszközökre (~15 mp)
find_part() {
    for u in /sys/class/block/*/uevent; do
        if grep -qs "^PARTNAME=$1\$" "$u"; then
            d=${u%/uevent}; p=${d##*/}
            [ -n "$BOOTDISK" ] && [ ! -e "/sys/block/$BOOTDISK/$p" ] && continue
            echo "/dev/$p"; return 0
        fi
    done
    return 1
}
BOOTDISK=""
i=0
while :; do
    [ -n "$BOOTDISK" ] || BOOTDISK=$(boot_disk)
    if [ -n "$INSTALLER" ]; then
        ROOTDEV=$(find_part FUSION_ISYS); DATADEV=tmpfs
    else
        ROOTDEV=$(find_part "FUSION_$SLOT"); DATADEV=$(find_part FUSION_DATA)
    fi
    [ -n "$ROOTDEV" ] && [ -n "$DATADEV" ] && break
    i=$((i + 1)); [ $i -ge 30 ] && break
    sleep 0.5
done
# a boot-lemez felismerése a ciklus után is (a telepítő módban a ciklus azonnal kiléphet, ha az USB-lemez épp
# a boot_disk és a find_part között jelent meg); végső tartalék telepítő módban: a FUSION_ISYS lemeze
[ -n "$BOOTDISK" ] || BOOTDISK=$(boot_disk)
if [ -z "$BOOTDISK" ] && [ -n "$INSTALLER" ] && [ -n "$ROOTDEV" ]; then
    BOOTDISK=$(basename "$(readlink -f "/sys/class/block/${ROOTDEV#/dev/}/..")")
fi
[ -n "$ROOTDEV" ] || rescue "A rendszerkép partíciója nem található ($([ -n "$INSTALLER" ] && echo FUSION_ISYS || echo "FUSION_$SLOT"))."
[ -n "$DATADEV" ] || rescue "A FUSION_DATA partíció nem található."

# 3. rendszerkép (EROFS, csak olvasható)
mkdir -p /lower /data /newroot
mount -t erofs -o ro "$ROOTDEV" /lower 2>/dev/null \
    || rescue "A(z) $SLOT slot rendszerképe ($ROOTDEV) nem csatolható. Üres vagy sérült a slot?"
[ -x /lower/sbin/init ] || rescue "A(z) $SLOT slot rendszerképében nincs /sbin/init."

# 4. adatpartíció (telepítő módban: RAM)
if [ -n "$INSTALLER" ]; then
    mount -t tmpfs -o mode=0755,size=60% tmpfs /data || rescue "A telepítő írható rétege (RAM) nem hozható létre."
else
    mount -t ext4 -o rw,noatime "$DATADEV" /data 2>/dev/null \
        || rescue "A FUSION_DATA partíció ($DATADEV) nem csatolható."
fi

# 4b. rendszerfrissítés után (új rendszerkép, megtartott DATA): a korábbi rendszerből a DATA-n
# maradt felhasználó-adatbázis és könyvtár-gyorsítótár ne takarja el az új rendszerképét
# (pl. egy új szolgáltatás-felhasználó). Nem törlés: a régi fájlok a stale/ alá kerülnek.
mkdir -p /data/overlay/root/upper /data/overlay/root/work
if ! cmp -s /lower/usr/lib/fusion/fusion-release /data/overlay/image-release; then
    stale="/data/overlay/stale/$(date +%Y%m%d-%H%M%S)"
    for f in etc/passwd etc/group etc/shadow etc/gshadow etc/subuid etc/subgid etc/ld.so.cache; do
        if [ -e "/data/overlay/root/upper/$f" ] || [ -L "/data/overlay/root/upper/$f" ]; then
            mkdir -p "$stale/${f%/*}" && mv "/data/overlay/root/upper/$f" "$stale/$f" && msg "frissítés: $f (régi) -> $stale"
        fi
    done
    cp /lower/usr/lib/fusion/fusion-release /data/overlay/image-release
    IMAGE_CHANGED=1
fi

# 5. gyökér-overlay + csak olvasható /usr
mount -t overlay overlay \
    -o "lowerdir=/lower,upperdir=/data/overlay/root/upper,workdir=/data/overlay/root/work" /newroot \
    || rescue "A gyökér-réteg (overlay) nem hozható létre."
if ! mount -o bind /lower/usr /newroot/usr || ! mount -o remount,bind,ro /newroot/usr; then
    rescue "A /usr nem csatolható a rendszerképből."
fi
mount -o move /data /newroot/data || rescue "A /data nem helyezhető át."
# az overlay és a /usr saját hivatkozást tart a rendszerképre; a segédcsatolás mehet
umount -l /lower

# állapot a rendszernek
mkdir -p /run/fusion
echo "$SLOT" > /run/fusion/slot
echo "${ENTRY:-ismeretlen}" > /run/fusion/boot-entry
[ -n "$COUNTPATH" ] && printf '%s\n' "$COUNTPATH" > /run/fusion/boot-countpath   # printf: a \f ne legyen vezérlőkarakter
echo "${BOOTDISK:-ismeretlen}" > /run/fusion/boot-disk
[ -n "${IMAGE_CHANGED:-}" ] && echo 1 > /run/fusion/image-changed
echo "$ROOTDEV" > /run/fusion/root-device
echo "$DATADEV" > /run/fusion/data-device
[ -n "$INSTALLER" ] && echo 1 > /run/fusion/installer

# 6. átadás
for m in /dev /proc /sys /run; do
    mount -o move "$m" "/newroot$m" 2>/dev/null || mount -o bind "$m" "/newroot$m"
done
command -v switch_root >/dev/null || rescue "A switch_root nem érhető el az initramfs-ben."
exec switch_root /newroot /sbin/init
