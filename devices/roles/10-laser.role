# Lézer (GRBL vezérlő, USB-soros)
# A ZBookon mérve (Phase 0b): CH340 1a86:7523, sorozatszám nélkül, USB-port 2.
# Sorozatszám hiányában a fizikai USB-port azonosítja: a lézert mindig ugyanabba
# a portba kell dugni (más porthoz: sudo fusion-devices assign laser ttyUSBx).
role = laser
name = Lézer (GRBL)
match.usb = 1a86:7523 1a86:5523 0403:6001 0403:6015
identify = path
# a Fusion Windows Runtime (M4) ezen a néven adja a LightBurnnek
windows.com = COM3
