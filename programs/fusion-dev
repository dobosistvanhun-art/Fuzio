#!/usr/bin/python3
"""Fúzió — fejlesztői eszközök (Node.js LTS, Wrangler, Claude Code)

    fusion-dev                    állapot
    fusion-dev install node       Node.js LTS (nodejs.org, ellenőrzőösszeggel) → /data/dev/node
    fusion-dev update node        a legújabb LTS (a régi változat törlődik)
    fusion-dev remove node
    fusion-dev install wrangler   Cloudflare Wrangler (npm, a felhasználó mappájába: ~/.local)
    fusion-dev update wrangler
    fusion-dev remove wrangler
    fusion-dev install claude     Claude Code (az Anthropic hivatalos telepítője, ~/.local/bin/claude) és a
                                  Claude Agent SDK a FusionAI-hoz (PyPI, ~/.local/share/fusion-ai/python)
    fusion-dev update claude
    fusion-dev remove claude      a Claude Code és az SDK törlése (a bejelentkezés és a munkamenetek: ~/.claude marad)
    fusion-dev rebuild [--check [--json]]
                                  új Fúzió-változat a forrásból (~/Projektek/fusionos): ellenőrzés (nem commitolt
                                  munka, eltérő ág, hely, töltő) → git pull → fetch → rendszerkép → build → .fupd
                                  (a Fejlesztődobozban); --check: csak az ellenőrzés. Telepítés: Beállítások →
                                  Rendszerfrissítés (a gomb is ezt futtatja, a végén rákérdez)
    fusion-dev box                Fejlesztődoboz: bejelentkezés (Ubuntu 24.04 a DATA-n, apt-tal; a saját mappa közös)
    fusion-dev box status|create|remove
    fusion-dev box run <parancs…> egy parancs a dobozban (az aktuális mappában, ha a saját mappán belül van)

A rendszerkép nem változik (csak olvasható): minden a DATA-n van, root nélkül. Ami apt-tal települ (pl. a Fúzió
buildjének eszközei), az a Fejlesztődobozba kerül (rendszergazdai fiók kell). A parancsok a munkamenetben
(Terminál) a PATH-on vannak: /data/dev/node/bin és ~/.local/bin. Bejelentkezés a Cloudflare-be:
`wrangler login` (a böngészőben). Bejelentkezés a Claude-ba (Pro/Max előfizetés): `claude auth login`.
"""
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request

DEV = os.environ.get("FUSION_DEV_DIR", "/data/dev")
NODE_LINK = os.path.join(DEV, "node")
MIRROR = os.environ.get("FUSION_DEV_MIRROR", "https://nodejs.org/dist")
HOME = os.path.expanduser("~")
NPM_PREFIX = os.path.join(HOME, ".local")
UA = "FusionOS-dev/1.0"


class DevError(Exception):
    pass


def say(msg):
    print(msg, flush=True)


def fetch(url, timeout=60):
    req = urllib.request.Request(url, headers={"User-Agent": UA})
    try:
        return urllib.request.urlopen(req, timeout=timeout)
    except Exception as e:
        raise DevError(f"nem érhető el: {url} ({getattr(e, 'reason', e)}) — van internet?")


def node_version():
    exe = os.path.join(NODE_LINK, "bin", "node")
    if not os.path.isfile(exe):
        return ""
    try:
        return subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def env():
    e = dict(os.environ)
    e["PATH"] = os.path.join(NODE_LINK, "bin") + os.pathsep + os.path.join(NPM_PREFIX, "bin") + os.pathsep + e.get("PATH", "")
    e["NPM_CONFIG_PREFIX"] = NPM_PREFIX
    return e


def wrangler_version():
    exe = os.path.join(NPM_PREFIX, "bin", "wrangler")
    if not os.path.exists(exe) or not node_version():
        return ""
    try:
        out = subprocess.run([exe, "--version"], capture_output=True, text=True, timeout=60, env=env()).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""
    m = re.search(r"(\d+\.\d+\.\d+)", out)
    return m.group(1) if m else out.strip()[:40]


def latest_lts():
    with fetch(MIRROR + "/index.json") as r:
        idx = json.load(r)
    for rel in idx:
        if rel.get("lts") and "linux-x64" in rel.get("files", []):
            return rel["version"], rel["lts"]
    raise DevError("nem található Node.js LTS-változat")


def install_node(update=False):
    cur = node_version()
    ver, name = latest_lts()
    if cur == ver and not update:
        say(f"Node.js {cur} már telepítve")
        return
    if cur == ver:
        say(f"Node.js {cur} a legfrissebb LTS ({name})")
        return
    fn = f"node-{ver}-linux-x64.tar.xz"
    say(f"Node.js {ver} ({name}) letöltése…")
    with fetch(f"{MIRROR}/{ver}/SHASUMS256.txt") as r:
        sums = r.read().decode()
    want = next((ln.split()[0] for ln in sums.splitlines() if ln.strip().endswith(" " + fn)), "")
    if not want:
        raise DevError("hiányzik az ellenőrzőösszeg: " + fn)
    os.makedirs(DEV, exist_ok=True)
    tmp = tempfile.NamedTemporaryFile(dir=DEV, suffix=".tar.xz", delete=False)
    h = hashlib.sha256()
    try:
        with fetch(f"{MIRROR}/{ver}/{fn}", timeout=120) as r, tmp:
            total = int(r.headers.get("Content-Length") or 0)
            done, last = 0, -10
            while True:
                b = r.read(1 << 16)
                if not b:
                    break
                tmp.write(b)
                h.update(b)
                done += len(b)
                if total and done * 100 // total >= last + 10:
                    last = done * 100 // total
                    say(f"  {last}%  ({done // 1048576} / {total // 1048576} MiB)")
        if h.hexdigest() != want:
            raise DevError("az ellenőrzőösszeg nem egyezik — a letöltés sérült, próbálja újra")
        say("ellenőrzőösszeg rendben; kicsomagolás…")
        dest = os.path.join(DEV, f"node-{ver}")
        shutil.rmtree(dest, ignore_errors=True)
        with tarfile.open(tmp.name) as t:
            t.extractall(DEV, filter="tar")
        os.rename(os.path.join(DEV, f"node-{ver}-linux-x64"), dest)
    finally:
        try:
            os.unlink(tmp.name)
        except OSError:
            pass
    old = os.path.realpath(NODE_LINK) if os.path.islink(NODE_LINK) else ""
    tmpl = NODE_LINK + ".new"
    if os.path.lexists(tmpl):
        os.unlink(tmpl)
    os.symlink(os.path.basename(dest), tmpl)
    os.replace(tmpl, NODE_LINK)
    if old and old != os.path.realpath(dest):
        shutil.rmtree(old, ignore_errors=True)
    say(f"Telepítve: Node.js {node_version()} (npm: {npm_version()}) → {NODE_LINK}")


def box_status():
    """a Fejlesztődoboz állapota (rendszergazda nélkül: csak a jelölőfájlból)"""
    try:
        r = subprocess.run(ADMIN + ["status", "--json"], capture_output=True, text=True, timeout=150)
        return json.loads(r.stdout.strip().splitlines()[-1])
    except (OSError, ValueError, IndexError, subprocess.TimeoutExpired):
        return {"exists": os.path.exists(os.path.join(DEV, "box", ".fusion-box.json")), "admin": False}


def npm_version():
    try:
        return subprocess.run(["npm", "--version"], capture_output=True, text=True, timeout=30, env=env()).stdout.strip()
    except (OSError, subprocess.TimeoutExpired):
        return ""


def remove_node():
    if os.path.islink(NODE_LINK):
        target = os.path.realpath(NODE_LINK)
        os.unlink(NODE_LINK)
        shutil.rmtree(target, ignore_errors=True)
    say("Node.js eltávolítva")


def npm(*args):
    if not node_version():
        raise DevError("előbb: fusion-dev install node")
    os.makedirs(NPM_PREFIX, exist_ok=True)
    say("$ npm " + " ".join(args))
    rc = subprocess.run(["npm", *args], env=env()).returncode
    if rc != 0:
        raise DevError(f"az npm hibával állt le ({rc})")


CLAUDE = os.path.join(HOME, ".local", "bin", "claude")
CLAUDE_DATA = os.path.join(HOME, ".local", "share", "claude")
CLAUDE_INSTALLER = os.environ.get("FUSION_DEV_CLAUDE_INSTALLER", "https://claude.ai/install.sh")
AI_SDK = os.path.join(HOME, ".local", "share", "fusion-ai", "python")
PYPI = os.environ.get("FUSION_DEV_PYPI", "https://pypi.org")


def claude_version():
    if not os.access(CLAUDE, os.X_OK):
        return ""
    try:
        out = subprocess.run([CLAUDE, "--version"], capture_output=True, text=True, timeout=60).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""
    m = re.search(r"(\d+\.\d+\.\d+)", out)
    return m.group(1) if m else out.strip()[:40]


def sdk_version():
    try:
        for n in os.listdir(AI_SDK):
            m = re.match(r"claude_agent_sdk-(.+)\.dist-info$", n)
            if m:
                return m.group(1)
    except OSError:
        pass
    return ""


def pip_wheel():
    """a pip a PyPI-ról, ellenőrzőösszeggel (a rendszerképben nincs pip; a kerékből közvetlenül fut)"""
    with fetch(PYPI + "/pypi/pip/json") as r:
        d = json.load(r)
    f = next((u for u in d.get("urls", []) if u.get("packagetype") == "bdist_wheel"), None)
    if not f:
        raise DevError("a pip kereke nem található a PyPI-n")
    cache = os.path.join(HOME, ".cache", "fusion-dev")
    os.makedirs(cache, exist_ok=True)
    dest = os.path.join(cache, f["filename"])
    if not os.path.isfile(dest):
        say(f"{f['filename']} letöltése…")
        h = hashlib.sha256()
        tmp = dest + ".part"
        with fetch(f["url"], timeout=120) as r, open(tmp, "wb") as o:
            while True:
                b = r.read(1 << 16)
                if not b:
                    break
                o.write(b)
                h.update(b)
        if h.hexdigest() != f.get("digests", {}).get("sha256"):
            os.unlink(tmp)
            raise DevError("a pip ellenőrzőösszege nem egyezik — a letöltés sérült, próbálja újra")
        os.replace(tmp, dest)
    return dest


def install_claude(update=False):
    # 1) a Claude Code: az Anthropic hivatalos, natív telepítője (root nélkül: ~/.local/bin, ~/.local/share/claude)
    if claude_version() and update:
        say("$ claude update")
        subprocess.run([CLAUDE, "update"])
    elif not claude_version():
        say(f"A Claude Code telepítése ({CLAUDE_INSTALLER})…")
        with fetch(CLAUDE_INSTALLER, timeout=120) as r:
            script = r.read()
        rc = subprocess.run(["bash", "-s"], input=script).returncode
        if rc != 0 or not claude_version():
            raise DevError(f"a Claude Code telepítője hibával állt le ({rc})")
    say(f"Claude Code {claude_version()} → {CLAUDE}")
    # 2) a Claude Agent SDK (Python) a FusionAI-nak: a forráscsomagból, így a Claude Code nem kerül bele még egyszer
    if sdk_version() and not update:
        say(f"Claude Agent SDK {sdk_version()} már telepítve")
    else:
        whl = pip_wheel()
        new = AI_SDK + ".new"
        shutil.rmtree(new, ignore_errors=True)
        cmd = [sys.executable, os.path.join(whl, "pip"), "install", "--disable-pip-version-check", "--no-input",
               "--isolated", "--target", new, "--no-binary", "claude-agent-sdk", "claude-agent-sdk"]
        say("$ pip install --target ~/.local/share/fusion-ai/python claude-agent-sdk")
        rc = subprocess.run(cmd).returncode
        if rc != 0:
            shutil.rmtree(new, ignore_errors=True)
            raise DevError(f"a pip hibával állt le ({rc}) — a régi SDK (ha volt) megmaradt")
        old = AI_SDK + ".old"
        shutil.rmtree(old, ignore_errors=True)
        if os.path.isdir(AI_SDK):
            os.rename(AI_SDK, old)
        os.rename(new, AI_SDK)
        shutil.rmtree(old, ignore_errors=True)
        say(f"Claude Agent SDK {sdk_version()} → {AI_SDK}")
    say("Bejelentkezés (egyszer): claude auth login — a Claude Pro/Max fiókoddal, az Anthropic oldalán")


def remove_claude():
    shutil.rmtree(AI_SDK, ignore_errors=True)
    if os.path.lexists(CLAUDE):
        os.unlink(CLAUDE)
    shutil.rmtree(CLAUDE_DATA, ignore_errors=True)
    try:
        os.rmdir(os.path.dirname(AI_SDK))
    except OSError:
        pass
    say("Claude Code és SDK eltávolítva. A bejelentkezés és a munkamenetek (~/.claude, ~/.claude.json) megmaradtak;"
        " kijelentkezés előtte: claude auth logout")


# ---------------------------------------------------------------- új változat a forrásból (rebuild)

REBUILD_STATE = os.path.join(HOME, ".cache", "fusion-dev", "rebuild.json")
MIN_FREE = int(os.environ.get("FUSION_DEV_MIN_FREE_GB", "10")) << 30     # legalább ennyi szabad hely a build előtt


def fusion_src():
    """a Fúzió forrásfája: FUSION_SRC, különben ~/Projektek/fusionos (vagy ~/Projektek/fuzio)"""
    cands = [os.environ.get("FUSION_SRC", "")] + [os.path.join(HOME, "Projektek", n) for n in ("fusionos", "fuzio", "Fuzio")]
    for c in cands:
        if c and os.path.isfile(os.path.join(c, "build", "fusion-build")) and os.path.isdir(os.path.join(c, ".git")):
            return os.path.realpath(c)
    return ""


def _git(src, *a, timeout=120):
    try:
        r = subprocess.run(["git", "-C", src, *a], capture_output=True, text=True, timeout=timeout,
                           env=dict(os.environ, GIT_TERMINAL_PROMPT="0", LC_ALL="C"))
        return r.returncode, (r.stdout or "").rstrip(), (r.stderr or "").strip()
    except (OSError, subprocess.TimeoutExpired) as e:
        return 1, "", str(e)


def _on_ac():
    """töltőn van-e (None: nem megállapítható, pl. asztali gép)"""
    base = "/sys/class/power_supply"
    try:
        found = None
        for n in os.listdir(base):
            try:
                with open(os.path.join(base, n, "type")) as f:
                    t = f.read().strip()
                if t == "Mains":
                    with open(os.path.join(base, n, "online")) as f:
                        if f.read().strip() == "1":
                            return True
                    found = False
            except OSError:
                continue
        return found
    except OSError:
        return None


def rebuild_check(fetch=True):
    """mit találna a rebuild — semmit nem módosít (a git fetch csak a távoli ág állapotát frissíti)"""
    st = {"src": fusion_src(), "ok": False, "problems": [], "warnings": [], "head": "", "behind": 0, "ahead": 0,
          "dirty": [], "free": 0, "ac": None, "box": False, "last": {}}
    try:
        with open(REBUILD_STATE, encoding="utf-8") as f:
            st["last"] = json.load(f)
    except (OSError, ValueError):
        pass
    src = st["src"]
    if not src:
        st["problems"].append("nem találom a Fúzió forrását (~/Projektek/fusionos)")
        return st
    rc, out, _ = _git(src, "status", "--porcelain", "--untracked-files=no")
    st["dirty"] = [ln[3:] for ln in out.splitlines() if ln.strip()]
    if st["dirty"]:
        st["problems"].append("nem commitolt módosítás: " + ", ".join(st["dirty"][:6]) + (" …" if len(st["dirty"]) > 6 else "")
                              + " — előbb commit (FusionAI: Commit gomb) vagy git stash")
    _, st["head"], _ = _git(src, "log", "-1", "--format=%h %s")
    if fetch:
        rc, _, err = _git(src, "fetch", "-q", "origin", timeout=180)
        if rc != 0:
            st["warnings"].append("a GitHub nem érhető el (git fetch): " + err[-160:] + " — a helyi állapotból épít")
    rc, out, _ = _git(src, "rev-list", "--left-right", "--count", "HEAD...@{u}")
    if rc == 0 and len(out.split()) == 2:
        st["ahead"], st["behind"] = (int(x) for x in out.split())
    if st["ahead"]:
        st["problems"].append(f"a helyi ágon {st['ahead']} commit van, ami nincs fent a GitHubon — előbb push "
                              "(FusionAI: Push gomb), vagy ha a GitHubon is van új, kézzel kell rendezni")
    try:
        st["free"] = shutil.disk_usage(src).free
    except OSError:
        pass
    if st["free"] and st["free"] < MIN_FREE:
        st["problems"].append(f"kevés a szabad hely: {st['free'] >> 30} GB (legalább {MIN_FREE >> 30} GB kell)")
    st["ac"] = _on_ac()
    if st["ac"] is False:
        st["warnings"].append("a gép akkumulátorról megy — a build hosszú, érdemes töltőre tenni")
    bs = box_status()
    st["box"] = bool(bs.get("exists"))
    if not st["box"]:
        st["problems"].append("nincs Fejlesztődoboz (Beállítások → Programkezelő → Fejlesztődoboz → Létrehozás)")
    elif bs.get("running"):
        # a doboz egyszerre csak egy ablakban futhat — a build nem tudna belépni
        st["problems"].append("a Fejlesztődoboz nyitva van egy másik ablakban (Fejlesztő terminál) — ott lépj ki "
                              "(exit vagy az ablak bezárása), aztán indítsd újra")
    st["ok"] = not st["problems"]
    return st


def _fupds(src):
    out = []
    for d, _, files in os.walk(os.path.join(src, "build", "out")):
        out += [os.path.join(d, f) for f in files if f.endswith(".fupd")]
    return sorted(out, key=lambda p: os.path.getmtime(p), reverse=True)


def rebuild(a):
    if "--check" in a:
        st = rebuild_check()
        if "--json" in a:
            print(json.dumps(st, ensure_ascii=False))
        else:
            say(f"forrás:  {st['src'] or '—'}\nHEAD:    {st['head']}\nGitHubon újabb: {st['behind']} commit, csak helyben: {st['ahead']}")
            for w in st["warnings"]:
                say("figyelem: " + w)
            for p in st["problems"]:
                say("AKADÁLY: " + p)
            say("rendben, indítható" if st["ok"] else "nem indítható")
        return 0 if st["ok"] else 1
    t_start = time.time()
    n = 6
    say(f"LÉPÉS 1/{n}: ellenőrzés")
    say("PROGRESS 1")
    st = rebuild_check()
    for w in st["warnings"]:
        say("figyelem: " + w)
    if not st["ok"]:
        raise DevError("; ".join(st["problems"]))
    src = st["src"]
    say(f"forrás: {src} — {st['head']}")
    say(f"LÉPÉS 2/{n}: git pull")
    say("PROGRESS 3")
    if st["behind"]:
        rc, out, err = _git(src, "pull", "--ff-only", "-q", timeout=300)
        if rc != 0:
            raise DevError("git pull: " + (err or out)[-300:])
        _, head, _ = _git(src, "log", "-1", "--format=%h %s")
        say(f"frissítve ({st['behind']} új commit): {head}")
    else:
        say("nincs új commit a GitHubon — a mostani állapotból épül")
    os.chdir(src)
    runner = os.environ.get("FUSION_DEV_BUILD_RUNNER")      # próbához: a doboz helyett közvetlenül
    steps = [(3, "letöltések (fetch)", ["build/fusion-build", "fetch"], 10),
             (4, "rendszerkép (ha a forrás változott)", ["build/fusion-build", "rootfs"], 30),
             (5, "build: UKI-k, ESP, .fupd", ["build/fusion-build", "build"], 85)]
    before = set(_fupds(src))
    for i, title, cmd, prog in steps:
        say(f"LÉPÉS {i}/{n}: {title}")
        rc = subprocess.call(cmd) if runner else box(["run"] + cmd)
        if rc != 0:
            raise DevError(f"a(z) „{title}” lépés hibával állt le ({rc}) — a részletek fent")
        say(f"PROGRESS {prog}")
    say(f"LÉPÉS 6/{n}: takarítás")
    removed = 0
    for d, _, files in os.walk(os.path.join(src, "build", "out")):
        for f in files:
            if f.endswith(".vdi"):                     # a VirtualBox-os fejlesztői lemezkép (megszűnt, 0.0.69)
                try:
                    removed += os.path.getsize(os.path.join(d, f))
                    os.unlink(os.path.join(d, f))
                    say(f"törölve: {f} (VirtualBox-lemezkép, már nem kell)")
                except OSError:
                    pass
    fupds = _fupds(src)
    for old in fupds[3:]:                              # a három legújabb .fupd marad
        try:
            removed += os.path.getsize(old)
            os.unlink(old)
            say(f"törölve: {os.path.basename(old)} (régi frissítőfájl)")
        except OSError:
            pass
    if removed:
        say(f"felszabadult: {removed >> 20} MB")
    new = [p for p in fupds[:3] if p not in before] or fupds[:1]
    if not new:
        raise DevError("nem készült .fupd — a részletek fent")
    secs = int(time.time() - t_start)
    try:
        os.makedirs(os.path.dirname(REBUILD_STATE), exist_ok=True)
        with open(REBUILD_STATE, "w", encoding="utf-8") as f:
            json.dump({"finished": time.time(), "secs": secs, "fupd": new[0]}, f)
    except OSError:
        pass
    say("PROGRESS 100")
    say("FUPD: " + new[0])
    say(f"KÉSZ: {os.path.basename(new[0])} elkészült ({secs // 60} perc {secs % 60} mp)")
    return 0


ADMIN = ["sudo", "-n", os.environ.get("FUSION_ADMIN", "/usr/lib/fusion/bin/fusion-admin"), "devbox"]


def box(a):
    sub = a[0] if a else "shell"
    if sub in ("status", "create"):
        return subprocess.call(ADMIN + [sub] + a[1:])
    if sub == "remove":
        ok = a[1:] == ["doboz"] or input("A Fejlesztődoboz törlése (a saját mappája megmarad). Írja be: doboz > ").strip() == "doboz"
        if not ok:
            say("megszakítva")
            return 1
        return subprocess.call(ADMIN + ["remove", "doboz"])
    cwd = os.getcwd()
    if sub == "shell":
        return subprocess.call(ADMIN + ["run", "--cwd", cwd])
    if sub == "run" and len(a) > 1:
        return subprocess.call(ADMIN + ["run", "--cwd", cwd, "--"] + a[1:])
    say(__doc__.strip())
    return 2


def main(a):
    cmd = a[0] if a else "status"
    what = a[1] if len(a) > 1 else ""
    if cmd == "box":
        return box(a[1:])
    if cmd == "rebuild":
        return rebuild(a[1:])
    if cmd in ("-h", "--help", "help"):
        say(__doc__.strip())
        return 0
    if cmd == "status":
        n, w = node_version(), wrangler_version()
        say(f"Node.js:  {n or 'nincs telepítve (fusion-dev install node)'}" + (f"  (npm {npm_version()})" if n else ""))
        say(f"Wrangler: {w or 'nincs telepítve (fusion-dev install wrangler)'}")
        c, sv = claude_version(), sdk_version()
        say(f"Claude:   {c or 'nincs telepítve (fusion-dev install claude)'}" + (f"  (SDK {sv or 'hiányzik'})" if c else ""))
        box_st = box_status()
        say("Doboz:    " + ("kész (fusion-dev box)" if box_st.get("exists") else "nincs (fusion-dev box create)"))
        return 0
    if cmd == "--json":
        print(json.dumps({"node": node_version(), "npm": npm_version() if node_version() else "", "wrangler": wrangler_version(),
                          "claude": claude_version(), "claude_sdk": sdk_version(), "box": box_status()}))
        return 0
    if (cmd, what) in (("install", "node"), ("update", "node")):
        install_node(update=cmd == "update")
    elif (cmd, what) == ("remove", "node"):
        remove_node()
    elif (cmd, what) in (("install", "wrangler"), ("update", "wrangler")):
        npm("install", "-g", "wrangler@latest")
        say(f"Wrangler {wrangler_version()} — bejelentkezés: wrangler login")
    elif (cmd, what) == ("remove", "wrangler"):
        npm("uninstall", "-g", "wrangler")
    elif (cmd, what) in (("install", "claude"), ("update", "claude")):
        install_claude(update=cmd == "update")
    elif (cmd, what) == ("remove", "claude"):
        remove_claude()
    else:
        say(__doc__.strip())
        return 2
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main(sys.argv[1:]))
    except DevError as e:
        print("fusion-dev: " + str(e), file=sys.stderr)
        sys.exit(1)
    except KeyboardInterrupt:
        sys.exit(130)
