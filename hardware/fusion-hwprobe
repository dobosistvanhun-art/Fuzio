#!/bin/sh
# =============================================================================
#  Fusion Hardware Layer — fusion-hwprobe (grafikus hardver azonosítása)
#
#  Általános, adatvezérelt azonosítás: a PCI-eszközök osztálya, gyártó- és
#  eszközazonosítója alapján a hardverprofilok (profiles/*.profile) közül
#  választja ki a legjobban illőt. A kódban nincs gép- vagy hipervizor-
#  specifikus ág: új hardver támogatása = új profilfájl.
#
#  Ebből nő ki később a Fusion Hardware API.
#
#  POSIX sh — busybox ash és bash alatt is fut.
#
#  Környezeti változók (teszteléshez / átirányításhoz):
#    FUSION_SYSFS         sysfs gyökér            (alapértelmezés: /sys)
#    FUSION_HW_PROFILES   profilok könyvtára      (alapértelmezés: a script melletti
#                                                  profiles/, különben
#                                                  /usr/lib/fusion/hardware/profiles)
#    FUSION_RUN           futásidejű állapot gyökere (alapértelmezés: /run/fusion)
#    FUSION_CMDLINE       kernel parancssor fájlja (alapértelmezés: /proc/cmdline)
#    FUSION_MODPROBE_D    modulparaméterek helye  (alapértelmezés: /run/modprobe.d)
#
#  Kimenet:
#    $FUSION_RUN/hardware/display.env   — gépi olvasásra (KEY='érték' sorok)
#    stdout                             — emberi összefoglaló (-q: nincs)
#    --env                              — a display.env tartalmát írja stdoutra
#    --apply                            — a profil display.kernel_modules moduljait
#                                         be is tölti (modprobe); az állapot a
#                                         FUSION_DISPLAY_DRIVER_STATE kulcsban
#    --status                           — a legutóbbi eredmény kiírása (nem keres újra)
#
#  --apply esetén a grafikus szerver beállítása is a profilból jön:
#    $FUSION_RUN/hardware/xorg-display.conf  (display.xorg_driver, display.xorg_module_path)
#    $FUSION_RUN/hardware/Xwrapper.config    (display.xorg_root_rights: yes|no|auto)
#
#  Profilkulcsok a driverhez:
#    display.kernel_modules   betöltendő modulok, sorrendben
#    display.module_options   modul:param=érték ...  (pl. nvidia-drm:modeset=1)
#
#  Kernel parancssori felülírások (teszteléshez, a boot menü szerkesztőjéből):
#    <modul>.<param>=<érték>   a profil azonos modulparaméterét felülírja
#                              (pl. nvidia-drm.modeset=0)
#    fusion.xorg.root=yes|no|auto   az Xorg root-jogának felülírása
# =============================================================================

set -u

SYSFS="${FUSION_SYSFS:-/sys}"
RUN_DIR="${FUSION_RUN:-/run/fusion}"
HW_DIR="$RUN_DIR/hardware"

SELF_DIR=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
if [ -n "${FUSION_HW_PROFILES:-}" ]; then
    PROFILES="$FUSION_HW_PROFILES"
elif [ -d "$SELF_DIR/profiles" ]; then
    PROFILES="$SELF_DIR/profiles"
else
    PROFILES="/usr/lib/fusion/hardware/profiles"
fi

# a modulkezelő parancsok felülírhatók (tesztekhez)
MODINFO="${FUSION_MODINFO:-modinfo}"
MODPROBE="${FUSION_MODPROBE:-modprobe}"
CMDLINE=$(cat "${FUSION_CMDLINE:-/proc/cmdline}" 2>/dev/null || true)

QUIET=0
PRINT_ENV=0
APPLY=0
for a in "$@"; do
    case "$a" in
        -q|--quiet) QUIET=1 ;;
        --env) PRINT_ENV=1; QUIET=1 ;;
        --apply) APPLY=1 ;;
        --status)
            if [ -r "$HW_DIR/display.summary" ]; then cat "$HW_DIR/display.summary"; exit 0; fi ;;
        -h|--help)
            echo "Használat: fusion-hwprobe [-q] [--env] [--apply] [--status]"
            exit 0 ;;
    esac
done

SUMMARY=""
say() {
    SUMMARY="$SUMMARY$*
"
    [ "$QUIET" -eq 1 ] || printf '%s\n' "$*"
}

lower() { printf '%s' "$1" | tr 'ABCDEF' 'abcdef'; }

# in_list <érték> <lista>  — a lista szóközzel elválasztott, "*" mindenre illik
in_list() {
    [ -z "$2" ] && return 1
    # a "*" joker szó szerint értendő, nem fájlnév-minta
    case " $2 " in *" * "*) return 0 ;; esac
    set -f
    for _i in $2; do
        if [ "$(lower "$_i")" = "$1" ]; then set +f; return 0; fi
    done
    set +f
    return 1
}

# shell-biztos idézés egy értékhez: 'abc'\''def'
shq() { printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"; }

# -----------------------------------------------------------------------------
# 1) Grafikus adapterek összegyűjtése (PCI osztály 0x03xx)
# -----------------------------------------------------------------------------
ADAPTERS=""        # soronként: slot|class|vendor|device|boot_vga|driver
ADAPTER_COUNT=0
NL='
'
if [ -d "$SYSFS/bus/pci/devices" ]; then
    for d in "$SYSFS"/bus/pci/devices/*; do
        [ -r "$d/class" ] || continue
        cls=$(lower "$(cat "$d/class")")
        cls=${cls%??}                      # 0x030000 -> 0x0300
        case "$cls" in 0x03*) ;; *) continue ;; esac
        ven=$(lower "$(cat "$d/vendor" 2>/dev/null)")
        dev=$(lower "$(cat "$d/device" 2>/dev/null)")
        bvga=$(cat "$d/boot_vga" 2>/dev/null || echo 0)
        drv=""
        [ -e "$d/driver" ] && drv=$(basename "$(readlink "$d/driver")")
        ADAPTERS="$ADAPTERS$(basename "$d")|$cls|$ven|$dev|$bvga|$drv$NL"
        ADAPTER_COUNT=$((ADAPTER_COUNT + 1))
    done
fi

# -----------------------------------------------------------------------------
# 2) Profilok értékelése
# -----------------------------------------------------------------------------
BEST_PRIO=100000; BEST_FILE=""; BEST_SLOT=""; BEST_ID=""; BEST_BVGA=0
FW_PRIO=100000;   FW_FILE=""

# profile_get <fájl> <kulcs>
profile_get() {
    sed -n "s/^[[:space:]]*$2[[:space:]]*=[[:space:]]*//p" "$1" | head -n 1 | sed 's/[[:space:]]*$//'
}

for pf in "$PROFILES"/*.profile; do
    [ -r "$pf" ] || continue
    prio=$(profile_get "$pf" priority); prio=${prio:-500}
    kind=$(profile_get "$pf" match.kind); kind=${kind:-pci}
    if [ "$kind" = "firmware" ]; then
        if [ "$prio" -lt "$FW_PRIO" ]; then FW_PRIO=$prio; FW_FILE=$pf; fi
        continue
    fi
    m_cls=$(profile_get "$pf" match.class)
    m_ven=$(profile_get "$pf" match.vendor)
    m_dev=$(profile_get "$pf" match.device)
    oldifs=$IFS; IFS="$NL"
    for line in $ADAPTERS; do
        IFS=$oldifs
        slot=${line%%|*};  r=${line#*|}
        cls=${r%%|*};      r=${r#*|}
        ven=${r%%|*};      r=${r#*|}
        dev=${r%%|*};      r=${r#*|}
        bvga=${r%%|*}
        in_list "$cls" "$m_cls" || continue
        in_list "$ven" "$m_ven" || continue
        in_list "$dev" "$m_dev" || continue
        # jobb: kisebb prioritásszám; egyenlőnél a boot_vga=1 adapter
        if [ "$prio" -lt "$BEST_PRIO" ] || { [ "$prio" -eq "$BEST_PRIO" ] && [ "$bvga" = 1 ] && [ "$BEST_BVGA" != 1 ]; }; then
            BEST_PRIO=$prio; BEST_FILE=$pf; BEST_SLOT=$slot
            BEST_ID="${ven#0x}:${dev#0x}"; BEST_BVGA=$bvga
        fi
    done
    IFS=$oldifs
done

# -----------------------------------------------------------------------------
# 3) Döntés és állapot
# -----------------------------------------------------------------------------
STATUS="none"; MESSAGE=""; CHOSEN=""
if [ -n "$BEST_FILE" ]; then
    CHOSEN=$BEST_FILE; STATUS="ok"
    sole=$(profile_get "$CHOSEN" requires_sole_adapter)
    if [ "$sole" = "yes" ] && [ "$ADAPTER_COUNT" -gt 1 ]; then
        STATUS="warning"
        MESSAGE=$(profile_get "$CHOSEN" hint.multi_adapter)
        [ -n "$MESSAGE" ] || MESSAGE="Ez a profil egyetlen grafikus adaptert feltételez, de $ADAPTER_COUNT látható."
    fi
elif [ -n "$FW_FILE" ]; then
    CHOSEN=$FW_FILE; STATUS="fallback"
    MESSAGE="Nincs illeszkedő PCI grafikus profil; a firmware framebuffer marad használatban."
fi

# -----------------------------------------------------------------------------
# 3b) Driver betöltése (--apply): a profil display.kernel_modules listája
#     none    — a profil nem kér modult (pl. firmware framebuffer)
#     loaded  — minden modul betöltve
#     missing — a modul nincs a rendszerben (pl. az NVIDIA driver még nincs telepítve)
#     failed  — a modul megvan, de nem tölthető be, vagy nem vette át az eszközt
#     skipped — nem kértek betöltést (--apply nélkül)
# -----------------------------------------------------------------------------
# modnorm: a modulnevekben a - és _ egyenértékű
modnorm() { printf '%s' "$1" | tr '-' '_'; }

# cmdline_has <modul> <param>: a kernel parancssorában van-e <modul>.<param>=
cmdline_has() {
    _want="$(modnorm "$1").$(modnorm "$2")"
    for _w in $CMDLINE; do
        case "$_w" in *=*) ;; *) continue ;; esac
        _k=${_w%%=*}
        [ "$(modnorm "${_k%%.*}").$(modnorm "${_k#*.}")" = "$_want" ] && return 0
    done
    return 1
}

# module_opts <modul> <display.module_options>: a modul paraméterei a profilból,
# a kernel parancssorában felülírtak nélkül (azokat a modprobe maga adja hozzá)
module_opts() {
    _out=""
    for _o in $2; do
        case "$_o" in *:*=*) ;; *) continue ;; esac
        [ "$(modnorm "${_o%%:*}")" = "$(modnorm "$1")" ] || continue
        _p=${_o#*:}
        cmdline_has "$1" "${_p%%=*}" && continue
        _out="$_out $_p"
    done
    printf '%s' "${_out# }"
}

# cmdline_val <kulcs>: fusion.* kulcs értéke a kernel parancssorából
cmdline_val() {
    for _w in $CMDLINE; do
        case "$_w" in "$1="*) printf '%s' "${_w#*=}"; return 0 ;; esac
    done
    return 1
}

# pci_busid 0000:01:00.0 -> PCI:1@0:0:0 (Xorg BusID, decimális)
pci_busid() {
    _d=${1%%:*}; _r=${1#*:}; _b=${_r%%:*}; _r=${_r#*:}; _s=${_r%%.*}; _f=${_r#*.}
    printf 'PCI:%d@%d:%d:%d' "0x$_b" "0x$_d" "0x$_s" "0x$_f"
}

DRIVER_STATE="skipped"; DRIVER_DETAIL=""
if [ -n "$CHOSEN" ]; then
    MODS=$(profile_get "$CHOSEN" display.kernel_modules)
    if [ "$APPLY" -eq 1 ]; then
        if [ -z "$MODS" ]; then
            DRIVER_STATE="none"
        else
            DRIVER_STATE="loaded"
            MODOPTS=$(profile_get "$CHOSEN" display.module_options)
            # a paraméterek előbb a modprobe.d-be kerülnek: így az udev-szabályok által
            # név szerint betöltött modulok (pl. nvidia-drm) is ezekkel indulnak
            MPD="${FUSION_MODPROBE_D:-/run/modprobe.d}"
            if mkdir -p "$MPD" 2>/dev/null; then
                {
                    echo "# Fusion Hardware Layer — generált fájl (profil: $(profile_get "$CHOSEN" id))"
                    for m in $MODS; do
                        o=$(module_opts "$m" "$MODOPTS")
                        [ -n "$o" ] && echo "options $(modnorm "$m") $o"
                    done
                } > "$MPD/fusion-display.conf"
            fi
            for m in $MODS; do
                # shellcheck disable=SC2046
                if ! $MODINFO -n "$m" >/dev/null 2>&1; then
                    DRIVER_STATE="missing"; DRIVER_DETAIL="$DRIVER_DETAIL $m"
                elif ! $MODPROBE "$m" $(module_opts "$m" "$MODOPTS") 2>/dev/null; then
                    [ "$DRIVER_STATE" = "missing" ] || DRIVER_STATE="failed"
                    DRIVER_DETAIL="$DRIVER_DETAIL $m"
                fi
            done
        fi
    fi
fi

# a modul betöltődhet úgy is, hogy az eszközt mégsem veszi át (pl. nem támogatott
# környezet) — ezért ellenőrizzük, hogy az adapterhez kapcsolódott-e driver
if [ "$DRIVER_STATE" = "loaded" ] && [ -n "$BEST_SLOT" ]; then
    _w=0; _max=${FUSION_BIND_WAIT:-10}
    while [ ! -L "$SYSFS/bus/pci/devices/$BEST_SLOT/driver" ] && [ "$_w" -lt "$_max" ]; do
        sleep 1; _w=$((_w + 1))
    done
    if [ ! -L "$SYSFS/bus/pci/devices/$BEST_SLOT/driver" ]; then
        DRIVER_STATE="failed"; DRIVER_DETAIL=" (betöltve, de az eszközt nem vette át: $BEST_SLOT)"
    fi
fi

# -----------------------------------------------------------------------------
# 3c) Grafikus szerver beállítása (--apply): Xorg eszköz és jogosultság
# -----------------------------------------------------------------------------
XORG_DRIVER=""; XORG_ROOT="auto"
if [ -n "$CHOSEN" ]; then
    XORG_DRIVER=$(profile_get "$CHOSEN" display.xorg_driver)
    r=$(profile_get "$CHOSEN" display.xorg_root_rights); [ -n "$r" ] && XORG_ROOT=$r
fi
if r=$(cmdline_val fusion.xorg.root); then XORG_ROOT=$r; fi
case "$XORG_ROOT" in yes|no|auto) ;; *) XORG_ROOT=auto ;; esac
# a profil Xorg-drivere csak akkor érvényes, ha a kerneldrivere betöltődött
# (különben az Xorg az általános felismerésre marad: modesetting / fbdev)
case "$DRIVER_STATE" in loaded|none) ;; *) XORG_DRIVER="" ;; esac

if [ "$APPLY" -eq 1 ] && mkdir -p "$HW_DIR" 2>/dev/null; then
    {
        echo "# Fusion Hardware Layer — generált fájl, ne szerkeszd"
        echo "# profil: $(profile_get "${CHOSEN:-/dev/null}" id)  adapter: ${BEST_SLOT:--}"
        if [ -n "$XORG_DRIVER" ]; then
            mp=$(profile_get "$CHOSEN" display.xorg_module_path)
            if [ -n "$mp" ]; then
                echo 'Section "Files"'
                for p in $mp; do echo "    ModulePath \"$p\""; done
                echo '    ModulePath "/usr/lib/xorg/modules"'
                echo 'EndSection'
            fi
            echo 'Section "Device"'
            echo '    Identifier "fusion-display"'
            echo "    Driver \"$XORG_DRIVER\""
            [ -n "$BEST_SLOT" ] && echo "    BusID \"$(pci_busid "$BEST_SLOT")\""
            echo 'EndSection'
        fi
    } > "$HW_DIR/xorg-display.conf.tmp" && mv "$HW_DIR/xorg-display.conf.tmp" "$HW_DIR/xorg-display.conf"
    printf 'allowed_users=console\nneeds_root_rights=%s\n' "$XORG_ROOT" > "$HW_DIR/Xwrapper.config"
fi

# -----------------------------------------------------------------------------
# 4) Kimenet
# -----------------------------------------------------------------------------
ENV_OUT=""
add_env() { ENV_OUT="$ENV_OUT$1=$(shq "$2")$NL"; }

add_env FUSION_DISPLAY_STATUS "$STATUS"
add_env FUSION_DISPLAY_ADAPTER_COUNT "$ADAPTER_COUNT"
if [ -n "$CHOSEN" ]; then
    add_env FUSION_DISPLAY_PROFILE "$(profile_get "$CHOSEN" id)"
    add_env FUSION_DISPLAY_PROFILE_NAME "$(profile_get "$CHOSEN" name)"
    add_env FUSION_DISPLAY_ADAPTER "$BEST_SLOT"
    add_env FUSION_DISPLAY_ADAPTER_ID "$BEST_ID"
    # a profil minden nem-illesztő kulcsa átmegy FUSION_PROFILE_* néven
    while IFS= read -r pl || [ -n "$pl" ]; do
        case "$pl" in ''|'#'*) continue ;; esac
        k=$(printf '%s' "${pl%%=*}" | sed 's/[[:space:]]*$//')
        v=$(printf '%s' "${pl#*=}" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
        case "$k" in match.*|id|name|priority) continue ;; esac
        kk=$(printf '%s' "$k" | tr 'a-z.-' 'A-Z__')
        add_env "FUSION_PROFILE_$kk" "$v"
    done < "$CHOSEN"
fi
[ -n "$MESSAGE" ] && add_env FUSION_DISPLAY_MESSAGE "$MESSAGE"
add_env FUSION_DISPLAY_DRIVER_STATE "$DRIVER_STATE"
add_env FUSION_DISPLAY_XORG_DRIVER "${XORG_DRIVER:-auto}"
add_env FUSION_DISPLAY_XORG_ROOT "$XORG_ROOT"
[ -n "$DRIVER_DETAIL" ] && add_env FUSION_DISPLAY_DRIVER_DETAIL "${DRIVER_DETAIL# }"

if mkdir -p "$HW_DIR" 2>/dev/null; then
    printf '%s' "$ENV_OUT" > "$HW_DIR/display.env.tmp" && mv "$HW_DIR/display.env.tmp" "$HW_DIR/display.env"
fi

if [ "$PRINT_ENV" -eq 1 ]; then
    printf '%s' "$ENV_OUT"
fi

say "Fusion Hardware Layer — grafika"
if [ "$ADAPTER_COUNT" -eq 0 ]; then
    say "  Grafikus PCI-adapter: nincs"
else
    oldifs=$IFS; IFS="$NL"
    for line in $ADAPTERS; do
        IFS=$oldifs
        slot=${line%%|*}; r=${line#*|}; r=${r#*|}
        ven=${r%%|*}; r=${r#*|}; dev=${r%%|*}; r=${r#*|}; bvga=${r%%|*}; drv=${r#*|}
        mark=""; [ "$slot" = "$BEST_SLOT" ] && mark="  <- kiválasztva"
        say "  Adapter: $slot  ${ven#0x}:${dev#0x}  boot_vga=$bvga  driver=${drv:--}$mark"
    done
    IFS=$oldifs
fi
if [ -n "$CHOSEN" ]; then
    say "  Profil:  $(profile_get "$CHOSEN" id) — $(profile_get "$CHOSEN" name)"
else
    say "  Profil:  nincs"
fi
say "  Állapot: $STATUS"
[ -n "$MESSAGE" ] && say "  Megjegyzés: $MESSAGE"
case "$DRIVER_STATE" in
    loaded)  say "  Driver:  betöltve ($MODS)" ;;
    none)    say "  Driver:  nincs külön driver (firmware framebuffer)" ;;
    missing) say "  Driver:  NINCS TELEPÍTVE:${DRIVER_DETAIL} — a firmware framebuffer marad" ;;
    failed)  say "  Driver:  NEM TÖLTHETŐ BE:${DRIVER_DETAIL}" ;;
esac
say "  Xorg:    driver=${XORG_DRIVER:-auto}  root=$XORG_ROOT"
[ -d "$HW_DIR" ] && printf '%s' "$SUMMARY" > "$HW_DIR/display.summary" 2>/dev/null
exit 0
