#!/bin/sh
# =============================================================================
#  FusionOS — fusion-shell: a Fusion Desktop panelje és Start menüje (M6 mérőprototípus)
#
#    fusion-shell                 állapot: melyik változat fut
#    fusion-shell use qml|web     változat választása (azonnal átvált, és megmarad)
#    fusion-shell menu            Start menü nyitása/zárása
#    fusion-shell run             (a munkamenet indítja) a választott változat, újraindítással
#    fusion-shell stop            leállítás (a run-ciklus is kilép)
#
#  Változatok (a mérés után marad az egyik):
#    qml  Qt 6 / Qt Quick (natív, GPU-val rajzol)
#    web  HTML/CSS a WebKitGTK-ban
# =============================================================================
set -u
CONF="${XDG_CONFIG_HOME:-$HOME/.config}/fusion/shell"
RT="${XDG_RUNTIME_DIR:-/tmp}"
PIDF="$RT/fusion-shell.pid"
STOPF="$RT/fusion-shell.stop"
BIN=/usr/lib/fusion/shell

say()  { printf '%s\n' "$*"; }
fail() { printf 'fusion-shell: %s\n' "$*" >&2; exit 1; }

variant() { v=$(cat "$CONF" 2>/dev/null); case "$v" in qml|web) echo "$v" ;; *) echo qml ;; esac; }
pid() { p=$(cat "$PIDF" 2>/dev/null); [ -n "$p" ] && kill -0 "$p" 2>/dev/null && echo "$p"; }

case "${1:-status}" in
    status)
        p=$(pid)
        say "Fusion Shell: $(variant) ${p:+(fut, pid $p)}${p:-(nem fut)}"
        say "  váltás: fusion-shell use qml | fusion-shell use web   —   mérés: fusion-uimeasure"
        ;;
    use)
        case "${2:-}" in qml|web) ;; *) fail "használat: fusion-shell use qml|web" ;; esac
        mkdir -p "$(dirname "$CONF")"; echo "$2" > "$CONF"
        p=$(pid); [ -n "$p" ] && kill "$p"     # a run-ciklus a választottat indítja újra
        say "Fusion Shell: $2"
        ;;
    menu)
        p=$(pid) || true; [ -n "${p:-}" ] || fail "a Fusion Shell nem fut"
        kill -USR1 "$p"
        ;;
    stop)
        : > "$STOPF"; p=$(pid); [ -n "$p" ] && kill "$p"; true
        ;;
    run)
        rm -f "$STOPF"
        while [ ! -e "$STOPF" ]; do
            v=$(variant)
            "$BIN/fusion-shell-$v" &
            echo $! > "$PIDF"
            wait $!
            [ -e "$STOPF" ] && break
            sleep 1
        done
        rm -f "$PIDF" "$STOPF"
        ;;
    *) fail "ismeretlen parancs: $1 (status, use, menu, run, stop)" ;;
esac
