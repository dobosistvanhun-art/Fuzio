#!/usr/bin/python3
"""FusionOS — fusion-uimeasure: a Fusion Shell két változatának mérése (M6 döntés előtt)

    fusion-uimeasure [--runs N] [--idle SEC]

Mindkét változatot (qml, web) N-szer elindítja, és méri:
  - indulás:    a folyamat indításától az első kirajzolt panelig (ms)
  - memória:    a változat összes folyamatának PSS-e (MiB) — a WebKit külön folyamatai is
  - CPU üresen: átlagos CPU-használat IDLE mp alatt, érintés nélkül (%)
  - Start menü: a nyitási kéréstől a menüablak megjelenéséig (ms), 5 mérés mediánja
Az eredmény a képernyőre és a /data/fusion/uimeasure-<idő>.txt fájlba kerül.
A mérés alatt a futó Fusion Shell áll, a végén a korábbi változat indul újra.
"""
import argparse
import os
import signal
import statistics
import subprocess
import sys
import time

BIN = "/usr/lib/fusion/shell"
RT = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
TCK = os.sysconf("SC_CLK_TCK")


def children(pid):
    out, todo = [], [pid]
    while todo:
        p = todo.pop()
        out.append(p)
        try:
            with open(f"/proc/{p}/task/{p}/children") as f:
                todo += [int(x) for x in f.read().split()]
        except OSError:
            pass
    return out


def pss_mib(pids):
    tot = 0
    for p in pids:
        try:
            with open(f"/proc/{p}/smaps_rollup") as f:
                for line in f:
                    if line.startswith("Pss:"):
                        tot += int(line.split()[1])
        except OSError:
            pass
    return tot / 1024.0


def cpu_ticks(pids):
    tot = 0
    for p in pids:
        try:
            with open(f"/proc/{p}/stat") as f:
                fields = f.read().rsplit(")", 1)[1].split()
            tot += int(fields[11]) + int(fields[12])      # utime + stime
        except (OSError, IndexError, ValueError):
            pass
    return tot


def window_viewable(name):
    r = subprocess.run(["xwininfo", "-name", name], capture_output=True, text=True)
    return "IsViewable" in r.stdout


def measure(variant, idle):
    ready = os.path.join(RT, f"fusion-shell-{variant}.ready")
    try:
        os.unlink(ready)
    except OSError:
        pass
    logf = open(os.path.join(RT, f"fusion-uimeasure-{variant}.log"), "ab")
    t0 = time.time()
    proc = subprocess.Popen([f"{BIN}/fusion-shell-{variant}"], stdout=logf, stderr=logf)
    start_ms = None
    while time.time() - t0 < 60:
        if os.path.exists(ready):
            try:
                start_ms = (float(open(ready).read().strip()) - t0) * 1000
            except ValueError:
                start_ms = (time.time() - t0) * 1000
            break
        if proc.poll() is not None:
            break
        time.sleep(0.01)
    res = {"start_ms": start_ms}
    if start_ms is None:
        # hiba oka a jegyzőkönyvbe: kilépett (kód) vagy 60 mp alatt sem rajzolt
        rc = proc.poll()
        res["hiba"] = f"kilépett ({rc})" if rc is not None else "60 mp alatt sem rajzolt"
        print(f"    {variant}: nem indult — {res['hiba']}; napló: {logf.name}", flush=True)
        proc.kill()
        return res
    time.sleep(10)                                  # beállás
    pids = children(proc.pid)
    res["pss_mib"] = pss_mib(pids)
    res["procs"] = len(pids)
    c0 = cpu_ticks(pids); time.sleep(idle); c1 = cpu_ticks(children(proc.pid))
    res["cpu_pct"] = (c1 - c0) / TCK / idle * 100
    lat = []
    for _ in range(5):
        t = time.time()
        proc.send_signal(signal.SIGUSR1)
        while time.time() - t < 15 and not window_viewable("Fusion Start"):
            time.sleep(0.005)
        lat.append((time.time() - t) * 1000)
        time.sleep(0.5)
        proc.send_signal(signal.SIGUSR1)            # zárás
        time.sleep(0.8)
    res["menu_ms"] = statistics.median(lat)
    res["pss_menu_mib"] = pss_mib(children(proc.pid))
    proc.terminate()
    try:
        proc.wait(5)
    except subprocess.TimeoutExpired:
        proc.kill()
    time.sleep(1)
    return res


def main():
    ap = argparse.ArgumentParser(prog="fusion-uimeasure")
    ap.add_argument("--runs", type=int, default=3)
    ap.add_argument("--idle", type=int, default=30)
    a = ap.parse_args()
    if not os.environ.get("DISPLAY"):
        sys.exit("fusion-uimeasure: a Fusion Desktopban (grafikus munkamenetben) kell futtatni")

    prev = subprocess.run(["fusion-shell"], capture_output=True, text=True).stdout
    print("A Fusion Shell a mérés idejére leáll (a panel eltűnik), a végén visszaáll.")
    subprocess.run(["fusion-shell", "stop"])
    time.sleep(2)

    results = {}
    for v in ("qml", "web"):
        results[v] = []
        for i in range(a.runs):
            print(f"  {v}: {i + 1}. mérés…", flush=True)
            results[v].append(measure(v, a.idle))

    def med(v, k):
        xs = [r[k] for r in results[v] if r.get(k) is not None]
        return statistics.median(xs) if xs else float("nan")

    lines = ["Fusion Shell — mérés (%s, %s)" % (time.strftime("%Y-%m-%d %H:%M"), os.uname().nodename),
             "", f"{'':24}{'QML (Qt Quick)':>18}{'Web (WebKitGTK)':>18}"]
    rows = [("indulás, első (ms)", lambda v: results[v][0].get("start_ms") or float("nan")),
            ("indulás, medián (ms)", lambda v: med(v, "start_ms")),
            ("memória PSS (MiB)", lambda v: med(v, "pss_mib")),
            ("memória, menü után", lambda v: med(v, "pss_menu_mib")),
            ("folyamatok", lambda v: med(v, "procs")),
            ("CPU üresjáratban (%)", lambda v: med(v, "cpu_pct")),
            ("Start menü nyitás (ms)", lambda v: med(v, "menu_ms"))]
    for name, f in rows:
        lines.append(f"{name:24}{f('qml'):>18.1f}{f('web'):>18.1f}")
    lines += ["", f"futások: {a.runs} / változat, üresjárat: {a.idle} mp", ""]
    for v in ("qml", "web"):
        for i, r in enumerate(results[v]):
            lines.append(f"  {v} #{i + 1}: " + ", ".join(f"{k}={val:.1f}" if isinstance(val, float) else f"{k}={val}"
                                                          for k, val in r.items()))
    text = "\n".join(lines)
    print("\n" + text)
    try:
        os.makedirs("/data/fusion", exist_ok=True)
    except OSError:
        pass
    for d in ("/data/fusion", os.path.expanduser("~")):
        try:
            fn = os.path.join(d, time.strftime("uimeasure-%Y%m%d-%H%M.txt"))
            with open(fn, "w") as f:
                f.write(text + "\n")
            print(f"\nmentve: {fn}")
            break
        except OSError:
            continue

    # a korábbi változat vissza (a munkamenet run-ciklusa leállt: új ciklus a háttérben)
    subprocess.Popen(["setsid", "fusion-shell", "run"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(prev.splitlines()[0] if prev else "")


if __name__ == "__main__":
    main()
